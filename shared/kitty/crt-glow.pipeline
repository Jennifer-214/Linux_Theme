# An amber monochrome monitor: every colour mapped to amber (phosphor.slang, its own group so the glow sees the
# result), then a faint phosphor glow, soft scanlines and a slight screen curve (kitty's own bloom and crt shaders).
# A theme turns it on with KITTY_SHADER_LINE='custom_shaders crt-glow' (retro-amber does). crt needs
# background_opacity 1. The crt tint stays off: phosphor already did the colour.
startgroup
    animation_step 0
    shaders phosphor
endgroup

startgroup
    animation_step 0
    var float BLOOM_STRENGTH = 0.08
    var float BLOOM_THRESHOLD = 0.2
    var float WARP = 0.08
    var float SCAN = 0.2
    var float4 TINT = float4(1, 1, 1, 0)
    shaders bloom crt
endgroup
