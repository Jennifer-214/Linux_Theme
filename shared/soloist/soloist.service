[Unit]
Description=Soloist (Spotify Connect player)
# Soloist is a download, not a package: on a machine without it this unit does nothing.
ConditionPathExists=/usr/local/bin/soloist
Wants=pipewire.service
After=pipewire.service wireplumber.service

[Service]
Type=simple
# The API key comes from `soloist setup-api-key` (saved under ~/.local/share/soloist), never this line.
# %H is the computer's hostname: the name Spotify shows for this device.
ExecStart=/usr/local/bin/soloist --device-name %H --ws 127.0.0.1:8765
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
