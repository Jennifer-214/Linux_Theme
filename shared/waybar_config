{
  "layer": "top",
  "position": "top",
  "height": __HEIGHT__,
  "margin": "__MARGIN_BAR__",

  "modules-left": [
    "group/launcher",
    "custom/ai_status"
  ],

  "modules-center": [],

  "modules-right": [
    "group/system",
    "group/hardware",
    "custom/updates",
    "custom/clock",
    "tray"
  ],

  "group/system": {
    "orientation": "horizontal",
    "modules": [
        "custom/foxml_sentry",
        "custom/system_health",
        "power-profiles-daemon",
        "custom/battery",
        "idle_inhibitor"
    ]
  },

  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
        "custom/net_speed",
        "custom/cpu",
        "custom/gpu",
        "memory",
        "custom/disk"
    ]
  },

  "group/launcher": {
    "orientation": "horizontal",
    "modules": [
        "custom/logo",
        "hyprland/workspaces"
    ]
  },

  "custom/system_health": {
    "exec": "~/.config/waybar/scripts/system_health.sh",
    "return-type": "json",
    "interval": 10,
    "tooltip": true
  },

  "custom/foxml_sentry": {
    "exec": "~/.config/waybar/scripts/foxml_sentry.sh",
    "return-type": "json",
    "interval": 15,
    "tooltip": true,
    "on-click": "kitty -e fox sec --live"
  },
  "custom/overwatch": {
    "exec": "~/.config/waybar/scripts/hw_overwatch.sh",
    "return-type": "json",
    "interval": 15,
    "tooltip": true
  },

  "hyprland/workspaces": {
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "󰘔",
    "window-rewrite": {
        "class<firefox>": "󰈹",
        "class<kitty>": "󰄛",
        "class<discord>": "󰙯",
        "class<steam>": "󰓓",
        "class<yazi>": "󰇥",
        "class<thunar>": "󰝰",
        "class<rofi>": "󰀻",
        "class<cursor>": "󰨞",
        "class<btopterm>": "󰑮"
    },
    "disable-scroll": false,
    "all-outputs": true,
    "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    }
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu-stats.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },

  "memory": {
    "format": "󰍛 {used:0.1f}/{total:0.0f}g",
    "interval": 5,
    "states": {
      "warning": 75,
      "critical": 90
    },
    "tooltip-format": "RAM: {used:0.1f}g / {total:0.1f}g ({percentage}%)\nSwap: {swapUsed:0.1f}g / {total:0.1f}g"
  },

  "custom/disk": {
    "exec": "~/.config/waybar/scripts/disk.sh",
    "return-type": "json",
    "interval": 60
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "default": "󰾅",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰌪"
    },
    "tooltip-format": "Power profile: {profile}\nClick to cycle: balanced → performance → power-saver",
    "on-click": "~/.config/waybar/scripts/ppd_cycle.sh"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "○"
    },
    "tooltip-format-activated": "Idle inhibited — click to release",
    "tooltip-format-deactivated": "Click to keep screen awake"
  },

  "tray": {
    "icon-size": __TRAY_ICON__,
    "spacing": 8
  },

  "custom/logo": {
    "format": "🦊",
    "tooltip": "SysHub",
    "on-click": "~/.config/hypr/scripts/toggle_rofi.sh ~/.config/hypr/scripts/hub.sh"
  },

  "custom/ai_status": {
    "exec": "~/.local/bin/fox-ai-status",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "~/.local/bin/fox-ai-swap"
  },

  "custom/security": {
    "exec": "~/.config/waybar/scripts/security_overwatch.sh",
    "return-type": "json",
    "interval": 30,
    "tooltip": true
  },

  "custom/net_speed": {
    "exec": "~/.config/waybar/scripts/net_speed.sh",
    "return-type": "json",
    "interval": 2,
    "tooltip": true
  },

  "custom/media": {
    "exec": "~/.config/waybar/scripts/media.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true
  },

  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "pavucontrol"
  },

  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "kitty -e bash -lc 'f=\"${XDG_RUNTIME_DIR:-/tmp}/foxml-waybar/updates.list\"; { [ -s \"$f\" ] && cat \"$f\" || checkupdates; } | less; exec zsh' &"
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 300,
    "signal": 1,
    "tooltip": true,
    "on-click": "~/.config/hypr/scripts/updates_menu.sh"
  }
}
