#!/bin/bash
# fox-ai-quick — Rofi-based quick AI chat

# Launcher-style prompt — anchors top-left.
ROFI_ZONE="${ROFI_ZONE:-nw}"
source ~/.config/hypr/scripts/_rofi_zone.sh

# The model fox-llm-run answers with (FOXAI_MODEL, fox-ai-default's, opencode's local default, the quick
# role); its tag ("4b") labels the prompt.
MODEL=$(fox-llm-run --model) || { notify-send "  AI" "no local model — fox-install --only llama_server"; exit 1; }
MODEL_TAG="${MODEL##*:}"

# Get question from Rofi
QUESTION=$(rofi -dmenu -p "  Ask AI ($MODEL_TAG)" -theme-str "$ROFI_POS_THEME window {width: 40%;} listview {enabled: false;}")

if [[ -z "$QUESTION" ]]; then
    exit 0
fi

# Show thinking notification
notify-send "  AI Thinking..." "$QUESTION" -t 3000

# Run AI and show result in a small Kitty window
# We use a temp file to store the response
TMP_FILE=$(mktemp)
echo "  AI Response ($MODEL_TAG):" > "$TMP_FILE"
echo "-----------------------------------" >> "$TMP_FILE"
echo "Question: $QUESTION" >> "$TMP_FILE"
echo "" >> "$TMP_FILE"

fox-llm-run "$QUESTION" >> "$TMP_FILE" 2>&1

# Display in a floating terminal
kitty --class="ai_quick" --title="AI Quick Response" \
    -o "initial_window_width=800" -o "initial_window_height=500" \
    -o "remember_window_size=no" \
    sh -c "cat '$TMP_FILE' | bat --language markdown --style plain; echo -e '\n[Press Enter to close]'; read"

rm -f "$TMP_FILE"
