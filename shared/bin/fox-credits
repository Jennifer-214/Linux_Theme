#!/usr/bin/env python3
# fox-credits — the monthly API credit budget shared by the notebook and desktop.
"""Tracks the API runs these tools make (fox-claude-api tasks, pi with API credits). Never contacts the network.

Spending across the whole account needs an Admin key, which individual accounts cannot create, so the meter is
the budget minus the runs recorded here: other uses of the same key are not counted.
"""
import argparse
import calendar
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from decimal import Decimal, InvalidOperation
import fcntl
import json
import os
from pathlib import Path
import re
import sys
import tempfile
from zoneinfo import ZoneInfo

UTC = timezone.utc
PROJECTS = {'trader': 'Trader', 'plugins': 'Claude mods', 'theme': 'Linux_Theme', 'other': 'Other folders'}
COUNTS = ('input_tokens', 'output_tokens', 'cache_read_tokens', 'cache_write_tokens', 'turns', 'duration_ms')


def locations():
    home = Path.home()
    return (Path(os.environ.get('XDG_CONFIG_HOME', home / '.config')) / 'foxml/api-credits.json',
            Path(os.environ.get('XDG_STATE_HOME', home / '.local/state')) / 'foxml/api-credits')


def defaults():
    return {'budget_usd': '200.00', 'renewal_day': None, 'timezone': 'UTC',
            'projects': {key: {'label': label} for key, label in PROJECTS.items()}}


def amount(value):
    try:
        result = Decimal(str(value))
    except InvalidOperation:
        raise ValueError('Invalid cost amount') from None
    if not result.is_finite() or result < 0 or result > Decimal('1000000000'):
        raise ValueError('Cost amounts must be finite and nonnegative')
    return result


def money(value):
    return f'${value:,.2f}'


def timestamp(value):
    result = datetime.fromisoformat(value.replace('Z', '+00:00'))
    if result.tzinfo is None:
        raise ValueError('Timestamps need a timezone')
    return result.astimezone(UTC)


def iso(value):
    return value.astimezone(UTC).isoformat().replace('+00:00', 'Z')


def load(path, fallback=None):
    if not path.exists():
        return fallback
    return json.loads(path.read_text())


def validate(config):
    if not isinstance(config, dict):
        raise ValueError('Credit configuration must be an object')
    budget = amount(config['budget_usd'])
    if budget <= 0:
        raise ValueError('Budget must be greater than zero')
    day = config.get('renewal_day')
    if day is not None and (type(day) is not int or not 1 <= day <= 31):
        raise ValueError('Renewal day must be 1 through 31')
    ZoneInfo(config.get('timezone', 'UTC'))
    projects = config.get('projects', {})
    if not isinstance(projects, dict):
        raise ValueError('Projects must be an object')
    for entry in projects.values():
        if not isinstance(entry, dict) or not isinstance(entry.get('label', ''), str):
            raise ValueError('Invalid project label')
    return config


def read_config():
    config = load(locations()[0], defaults())
    if isinstance(config, dict):
        # Settings from the retired billing-report mode are ignored.
        for key in ('key_file',):
            config.pop(key, None)
        if isinstance(config.get('projects'), dict):
            for key, entry in defaults()['projects'].items():
                config['projects'].setdefault(key, entry)
    return validate(config)


def cycle(config, now):
    if config.get('renewal_day') is None:
        return None
    local = now.astimezone(ZoneInfo(config['timezone']))
    day = config['renewal_day']

    def boundary(year, month):
        return datetime(year, month, min(day, calendar.monthrange(year, month)[1]), tzinfo=local.tzinfo)

    start = boundary(local.year, local.month)
    if local < start:
        previous = start.replace(day=1) - timedelta(days=1)
        start = boundary(previous.year, previous.month)
    following = (start.replace(day=1) + timedelta(days=32)).replace(day=1)
    end = boundary(following.year, following.month)
    return start.astimezone(UTC), end.astimezone(UTC)


def atomic(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, name = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream, ensure_ascii=False)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


@contextmanager
def locked():
    state = locations()[1]
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(state / 'lock', os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(fd, 'w') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield state


def details(text):
    """The optional per-run details: model, label, source and whole-number counts."""
    if not text:
        return {}
    value = json.loads(text)
    if not isinstance(value, dict):
        raise ValueError('Run details must be a JSON object')
    out = {}
    for key, item in value.items():
        if key == 'model' and isinstance(item, str) and re.fullmatch(r'[A-Za-z0-9._:/\[\]-]{1,100}', item):
            out[key] = item
        elif key == 'label' and isinstance(item, str) and 0 < len(item) <= 80 and item.isprintable():
            out[key] = item
        elif key == 'source' and item in ('task', 'pi'):
            out[key] = item
        elif key in COUNTS and type(item) is int and 0 <= item <= 10**10:
            out[key] = item
        elif item is not None:
            raise ValueError('Invalid run detail: ' + str(key)[:40])
    return out


def record(config, project, cost, event_id, at, estimate=False, extra=None):
    if project not in config.get('projects', {}):
        raise ValueError('Unknown credit project')
    if not event_id or len(event_id) > 200 or any(ord(c) < 32 for c in event_id):
        raise ValueError('A stable request or run ID is required')
    event = {'id': event_id, 'project': project, 'cost_usd': str(amount(cost)), 'at': iso(timestamp(at))}
    if estimate:
        event['estimated'] = True
    event.update(extra or {})
    with locked() as state:
        ledger = load(state / 'tracked.json', {'events': []})
        previous = next((old for old in ledger['events'] if old['id'] == event_id), None)
        if previous is not None and previous != event:
            raise ValueError('That run ID already has a different cost record')
        if previous is None:
            ledger['events'].append(event)
            atomic(state / 'tracked.json', ledger)


def cycle_events(config, now):
    bounds = cycle(config, now)
    if bounds is None:
        return None, []
    start, end = bounds
    ledger = load(locations()[1] / 'tracked.json', {'events': []})
    return bounds, [e for e in ledger['events'] if start <= timestamp(e['at']) < end and timestamp(e['at']) <= now]


def snapshot(config, now):
    budget = amount(config['budget_usd'])
    result = {'version': 2, 'budget_usd': str(budget), 'spent_usd': None, 'remaining_usd': None,
              'remaining_percent': None, 'source': 'local', 'status': 'setup',
              'short': 'API · setup', 'headline': money(budget) + ' monthly API credits',
              'detail': 'Set the renewal day: fox-credits setup', 'meter': '',
              'projects': [{'id': key, 'label': entry.get('label', key), 'spent_usd': None, 'detail': 'Renewal day not set'}
                           for key, entry in config.get('projects', {}).items() if key != 'other'],
              'runs': 0, 'cycle_start': None, 'cycle_end': None, 'as_of': None}
    bounds, events = cycle_events(config, now)
    if bounds is None:
        return result
    start, end = bounds
    totals = {key: Decimal(0) for key in config.get('projects', {})}
    for event in events:
        key = event['project'] if event['project'] in totals else 'other'
        totals[key] = totals.get(key, Decimal(0)) + amount(event['cost_usd'])
    spent = sum(totals.values(), Decimal(0))
    remaining = max(Decimal(0), budget - spent)
    percent = min(100, max(0, float(remaining / budget * 100)))
    renews = end.astimezone(ZoneInfo(config['timezone'])).strftime('%b %-d')
    result.update(status='tracked', spent_usd=str(spent), remaining_usd=str(remaining), remaining_percent=percent,
                  short='API ~' + money(remaining) + ' left', headline=money(spent) + ' tracked of ' + money(budget),
                  detail='Tracked runs only · renews ' + renews, runs=len(events),
                  meter='▰' * round(percent / 10) + '▱' * (10 - round(percent / 10)),
                  cycle_start=iso(start), cycle_end=iso(end),
                  as_of=max((e['at'] for e in events), default=None))
    result['projects'] = [{'id': key, 'label': entry.get('label', key), 'spent_usd': str(totals.get(key, Decimal(0))),
                           'detail': money(totals.get(key, Decimal(0)))}
                          for key, entry in config.get('projects', {}).items()
                          if key != 'other' or totals.get('other')]
    return result


def usage(config, now):
    """This cycle's tracked runs by project, by model and by day, plus the most expensive ones."""
    value = snapshot(config, now)
    bounds, events = cycle_events(config, now)
    out = {'snapshot': value, 'projects': [], 'models': [], 'days': [], 'top': []}
    if bounds is None:
        return out
    zone = ZoneInfo(config['timezone'])
    labels = {key: entry.get('label', key) for key, entry in config.get('projects', {}).items()}
    groups = {'projects': {}, 'models': {}, 'days': {}}
    for event in events:
        cost = amount(event['cost_usd'])
        keys = {'projects': event['project'] if event['project'] in labels else 'other',
                'models': event.get('model', 'unknown'),
                'days': timestamp(event['at']).astimezone(zone).strftime('%Y-%m-%d')}
        for group, key in keys.items():
            row = groups[group].setdefault(key, {'spent': Decimal(0), 'runs': 0, 'input_tokens': 0, 'output_tokens': 0})
            row['spent'] += cost
            row['runs'] += 1
            row['input_tokens'] += event.get('input_tokens', 0) + event.get('cache_read_tokens', 0) + event.get('cache_write_tokens', 0)
            row['output_tokens'] += event.get('output_tokens', 0)

    def rows(group, name):
        return [{name: key, 'label': labels.get(key, key) if group == 'projects' else key,
                 'spent_usd': str(row['spent']), 'runs': row['runs'],
                 'average_usd': str((row['spent'] / row['runs']).quantize(Decimal('0.0001'))),
                 'input_tokens': row['input_tokens'], 'output_tokens': row['output_tokens']}
                for key, row in groups[group].items()]

    out['projects'] = sorted(rows('projects', 'id'), key=lambda r: -Decimal(r['spent_usd']))
    out['models'] = sorted(rows('models', 'model'), key=lambda r: -Decimal(r['spent_usd']))
    out['days'] = sorted(rows('days', 'day'), key=lambda r: r['day'])
    top = sorted(events, key=lambda e: -amount(e['cost_usd']))[:10]
    out['top'] = [{k: e[k] for k in ('id', 'project', 'cost_usd', 'at', 'model', 'label', 'source') if k in e} for e in top]
    return out


def bar(value):
    lines = [value['headline'], value['detail']]
    lines.extend(project['label'] + ': ' + project['detail'] for project in value['projects'])
    lines.append('Counts runs made through fox-claude-api and pi with API credits.')
    percent = value['remaining_percent']
    css = 'critical' if percent is not None and percent <= 0 else 'warning' if value['status'] == 'error' or (percent is not None and percent <= 20) else 'muted' if percent is None else 'normal'
    result = {'text': value['short'], 'tooltip': '\n'.join(lines), 'class': [css]}
    if percent is not None:
        result['percentage'] = percent
    return result


def configure(args):
    config = read_config()
    if args.renewal_day is not None:
        config['renewal_day'] = args.renewal_day
    if args.budget is not None:
        config['budget_usd'] = str(amount(args.budget))
    if args.timezone is not None:
        config['timezone'] = args.timezone
    validate(config)
    atomic(locations()[0], config)
    print('Saved credit settings to', locations()[0])


def setup():
    config = read_config()
    print('Monthly plan API credits. Interactive subscription limits are separate.')
    print('The credit renewal date is in Claude Console: https://platform.claude.com/settings/billing')
    value = input('Renewal day (1–31) [' + str(config.get('renewal_day') or 'not set') + ']: ').strip()
    if value:
        config['renewal_day'] = int(value)
    zone = input('Timezone [' + config['timezone'] + ']: ').strip()
    if zone:
        config['timezone'] = zone
    budget = input('Monthly credit in USD [' + str(config['budget_usd']) + ']: ').strip()
    if budget:
        config['budget_usd'] = str(amount(budget))
    validate(config)
    atomic(locations()[0], config)
    print('Saved. Runs made through fox-claude-api and pi with API credits are counted from now on.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command')
    commands.add_parser('status')
    commands.add_parser('bar')
    commands.add_parser('usage')
    commands.add_parser('setup')
    conf = commands.add_parser('configure')
    conf.add_argument('--renewal-day', type=int)
    conf.add_argument('--budget')
    conf.add_argument('--timezone')
    entry = commands.add_parser('record')
    entry.add_argument('--project', required=True)
    entry.add_argument('--cost-usd', required=True)
    entry.add_argument('--id', required=True)
    entry.add_argument('--at', required=True)
    entry.add_argument('--estimate', action='store_true', help='mark a client-side cost estimate')
    entry.add_argument('--details', help='JSON: model, label, source, token counts, turns, duration_ms')
    args = parser.parse_args()
    command = args.command or 'status'
    now = datetime.now(UTC)
    try:
        config = read_config()
        if command == 'configure':
            configure(args)
        elif command == 'setup':
            setup()
        elif command == 'record':
            record(config, args.project, args.cost_usd, args.id, args.at, args.estimate, details(args.details))
        elif command == 'usage':
            print(json.dumps(usage(config, now), ensure_ascii=False))
        else:
            value = snapshot(config, now)
            print(json.dumps(bar(value) if command == 'bar' else value, ensure_ascii=False))
        return 0
    except (ValueError, KeyError, TypeError, OSError, EOFError) as error:
        message = str(error) if isinstance(error, ValueError) else 'Credit settings or the run ledger are unavailable.'
        if command in ('status', 'bar'):
            value = snapshot(defaults(), now)
            value.update(status='error', short='API · unavailable', detail=message)
            print(json.dumps(bar(value) if command == 'bar' else value, ensure_ascii=False))
            return 0
        print('fox-credits:', message, file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
