#!/bin/bash
# fox-desktop-menu — one named Quickshell instance serves the desktop menus.

# Compositor keybinds do not inherit the interactive shell's ~/.local/bin PATH.
launcher_dir="${BASH_SOURCE[0]%/*}"
[[ "$launcher_dir" == "${BASH_SOURCE[0]}" ]] && launcher_dir="$HOME/.local/bin"
launcher_dir="$(cd -- "$launcher_dir" && pwd -P)" || exit 1
case ":${PATH:-}:" in
    *":$launcher_dir:"*) ;;
    *) export PATH="$launcher_dir:${PATH:-/usr/local/bin:/usr/bin:/bin}" ;;
esac

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
config_dir="$config_home/quickshell/foxml"

available() {
    command -v quickshell >/dev/null 2>&1 &&
        command -v fox-drawer >/dev/null 2>&1 &&
        [[ -r "$config_dir/shell.qml" && -r "$config_dir/Theme.qml" && -r "$config_dir/menus.json" ]]
}

ipc() { quickshell -c foxml ipc call drawer "$@"; }

case "${1:-root}" in
    --available) available; exit $? ;;
    --help|-h)
        printf '%s\n' 'Usage: fox-desktop-menu [PAGE | --open PAGE | --start | --close | --available]' \
            'Open or toggle the palette-driven desktop drawer.'
        exit 0 ;;
    --close)
        available || exit 1
        ipc close >/dev/null 2>&1
        exit $? ;;
    --start) action=start; page=root ;;
    --open) action=open; page="${2:-root}" ;;
    *) action=toggle; page="${1:-root}" ;;
esac

if [[ ! "$page" =~ ^[a-z][a-z0-9-]*$ ]]; then
    printf 'fox-desktop-menu: invalid page name: %s\n' "$page" >&2
    exit 2
fi
if ! available; then
    printf 'fox-desktop-menu: drawer unavailable; install Quickshell and run fox-install --only drawer.\n' >&2
    exit 1
fi

if ! ipc status >/dev/null 2>&1; then
    quickshell -c foxml --no-duplicate --daemonize >/dev/null 2>&1 || {
        printf 'fox-desktop-menu: could not start the FoxML drawer.\n' >&2
        exit 1
    }
    ready=false
    for (( attempt=0; attempt<30; attempt++ )); do
        if ipc status >/dev/null 2>&1; then ready=true; break; fi
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        printf 'fox-desktop-menu: the drawer did not become ready; check quickshell -c foxml log.\n' >&2
        exit 1
    fi
fi

[[ "$action" == start ]] && exit 0
ipc "$action" "$page"
