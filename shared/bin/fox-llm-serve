#!/usr/bin/env bash
# fox-llm-serve — the llama.cpp router (one URL, many models) built from the roles file.
#
#   fox-llm-serve [--engine main|turbo] run    [extra-model ...]   write the preset, run the router
#   fox-llm-serve [--engine main|turbo] preset [extra-model ...]   write + print the preset INI only
#   fox-llm-serve roles                                            the effective role → model → server table
#
# Two engines, one router each: main = llama.cpp (the llama-cpp package) on :8080 serving roles whose
# server is `llama`; turbo = the TurboQuant fork (llama_turbo module, ~/.local/opt) on :8081 serving
# `llama-turbo` roles — its compressed KV cache generates faster deep into a long context.
#
# Roles: ~/.config/foxml/llm/roles.conf, else ~/code/custom_models/roles.conf (yours — the private
# custom_models repo a reinstall clones back), else roles.default (deployed from Linux_Theme shared/llm/).
# The installer links the first to the second, so tools that only know the old path read yours too; a
# real file there overrides it on one machine.
# Models are Hugging Face GGUFs in llama.cpp's own format: fox-llm-update downloads each listed one to
# ~/.local/share/fox-llm/gguf/<name>.gguf, and it is served under <name> — the name the roles file and
# every client use. Models not downloaded yet are skipped; `fox-llm-update --sync` (run after every
# download) rewrites the preset and has the router reload it — no restart. The main engine also serves
# every other model in that folder (on demand), except
#   · models the roles file gives the turbo engine (`llama-turbo`) — the server column wins;
#   · models this llama.cpp can't load (an architecture newer than the build) — checked once per file.
# Embedding models are served too, in embedding mode (/v1/embeddings) — fask/findex use them through
# libfox-intel, which trims text longer than the model takes. FOX_LLM_ONLY_ROLES=1 limits it to the roles.
#
# Slots (parallel conversations per model) follow RAM: under 48 GB the agent gets ONE slot — its whole
# context goes to the one conversation, nothing to fragment or evict (side requests like the plugin's
# explain cards belong on the quick model); from 48 GB it gets two, each capped at the role's context so
# a second conversation can never squeeze out the first. Override per role: `slots=N` after the server.
#
# Residency, for running ghost text + explain cards + a heavy agent on one laptop: fim stays loaded (tiny,
# on the GPU) — on a GPU of 6 GiB or less it loads when asked instead, its room going to the agent, whose
# context is then 64k (role_flags); the agent sleeps after an hour idle — a sleeping model loses its prompt cache (saving it to
# disk doesn't help hybrid Qwen 3.5/3.6: a restored slot isn't reused, tested 2026-10-14), and re-reading
# a long agent conversation takes minutes; under 48 GB the quick model after 10 min (it is the agents'
# stand-in until the agent model is downloaded), the title and embedding models after 2 and 5, other
# models after 5. The router keeps up to 6 loaded, so one stray model never evicts the agent.
#
# Env: FOX_LLM_SERVER (llama-server binary override), FOX_LLM_PORT.
set -uo pipefail

ENGINE=main
if [[ ${1:-} == --engine ]]; then ENGINE=${2:-}; shift 2; fi
[[ $ENGINE == main || $ENGINE == turbo ]] || { echo "fox-llm-serve: --engine is main or turbo" >&2; exit 2; }

LLM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/foxml/llm"
GGUF_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fox-llm/gguf"
if [[ $ENGINE == turbo ]]; then
  PRESET="$LLM_DIR/llama-presets-turbo.ini"; PORT="${FOX_LLM_PORT:-8081}"; SERVES=llama-turbo
  SRC="$HOME/.local/opt/llama.cpp-turbo"
else
  PRESET="$LLM_DIR/llama-presets.ini";       PORT="${FOX_LLM_PORT:-8080}"; SERVES=llama
  SRC="$HOME/.local/opt/llama.cpp"
fi

die() { echo "fox-llm-serve: $*" >&2; exit 1; }

roles_file() {
  local f
  for f in "$LLM_DIR/roles.conf" "$HOME/code/custom_models/roles.conf" "$LLM_DIR/roles.default"; do
    [[ -f $f ]] && { echo "$f"; return; }
  done
  die "no roles file (roles.conf in $LLM_DIR or ~/code/custom_models, or $LLM_DIR/roles.default)"
}

server_bin() {
  local c
  local pkg=/usr/bin/llama-server
  [[ $ENGINE == turbo ]] && pkg=""                  # the fork is only ever a source build
  for c in "${FOX_LLM_SERVER:-}" $pkg "$SRC"/build-cuda/bin/llama-server "$SRC"/build-cpu/bin/llama-server; do
    [[ -n $c && -x $c ]] && { echo "$c"; return; }
  done
  if [[ $ENGINE == turbo ]]; then die "no TurboQuant build in $SRC (fox-install --only llama_turbo)"; fi
  die "no llama-server — install the llama-cpp package (fox-install --only llama_server)"
}

# llama.cpp's own device list, not nvidia-smi: NVML can fail (driver halves mismatched after an
# update) while CUDA itself works fine.
gpu_ok() { "$1" --list-devices 2>/dev/null | grep -Eq '^[[:space:]]+(CUDA|Vulkan|ROCm|SYCL)[0-9]+:'; }
# The first GPU's size in MiB, from the same list ("CUDA0: NVIDIA T1200 Laptop GPU (3722 MiB, 3300 MiB
# free)"); 0 when there is none or it gives no size.
gpu_mib() {
  local mib
  mib=$("$1" --list-devices 2>/dev/null |
        sed -nE 's/^[[:space:]]+(CUDA|Vulkan|ROCm|SYCL)[0-9]+:.*\(([0-9]+) MiB.*/\2/p' | head -n1)
  echo "${mib:-0}"
}

# Model name → its GGUF, when it is downloaded. A name never holds a slash: it is a file name.
gguf_path() {
  if [[ $1 != */* && -f $GGUF_DIR/$1.gguf ]]; then echo "$GGUF_DIR/$1.gguf"; else return 1; fi
}

# role → flags. No placement flags at all: llama.cpp's auto-fit places as much as fits in the VRAM
# free at load time — whole layers of a dense model; for a MoE model everything but the sparse expert
# weights first, experts to RAM as needed (common/fit.cpp). Any manual placement switches the fit off
# and the load then tries the whole model on the GPU: a forced n-gpu-layers OOMed the 4B beside the
# fim model, cpu-moe (a tensor override) every extra model (2026-10-14). And the Arch package
# (llama-cpp 0.6.0) has no --moe-cache-mib: an agent section asking for it would never start.
# `fit-target` is no placement: it is the margin auto-fit leaves free, and the fit stays on.
RAM_GB=$(awk '/^MemTotal:/{printf "%d", ($2 + 1048575) / 1048576}' "${FOX_LLM_MEMINFO:-/proc/meminfo}")
# A GPU of 6 GiB or less (set by write_preset): its room goes to the agent.
SMALL_GPU=0

# Context per slot. One slot: `c` is that slot's context. Several: the unified KV pool is
# slots × per-slot (kv-unified-per-slot), so no conversation can take another's room.
ctx_flags() {
  local per=$1 slots=$2
  if (( slots <= 1 )); then
    echo "c = $per"; echo "parallel = 1"
  else
    echo "parallel = $slots"; echo "kv-unified-per-slot = $per"
  fi
}

# A small GPU belongs to the agent: the helpers (ghost text, quick, titles, embeddings) run on the CPU.
# Sharing failed both ways (2026-10-16): beside a loaded agent the quick 4B couldn't load (llama.cpp still
# wanted a 555 MiB GPU buffer to read its prompts); loaded first, it took 2.3 GB and the agent came up at
# the CPU-only speed (5.7 tok/s) until it reloaded. On the CPU the 4B reads ~37 tok/s, writes ~5.5.
helper_gpu_flags() { if (( SMALL_GPU )); then echo "device = none"; fi; }

role_flags() {
  local role=$1 slots=$2
  case $role in
    # fim: loaded from the start, except on a small GPU, where its 1.2 GB slowed the agent — there it
    # loads when asked (the first suggestion takes a few seconds) and sleeps after 10 min.
    fim)   ctx_flags 8192 "${slots:-1}"; echo "cache-ram = 256"; helper_gpu_flags
           if (( SMALL_GPU )); then echo "sleep-idle-seconds = 600"; else echo "load-on-startup = true"; fi ;;
    # quick: explain cards, inline edits — short jobs where hidden reasoning only adds minutes on a small
    # GPU (fask sat 9 min on it). Thinking off at the server, for every client; Qwen's template switch,
    # ignored by templates without one. The agent role keeps thinking.
    quick) ctx_flags 32768 "${slots:-2}"; echo "cache-ram = 1024"; helper_gpu_flags
           echo 'chat-template-kwargs = {"enable_thinking": false}'
           if (( RAM_GB < 48 )); then echo "sleep-idle-seconds = 600"; fi ;;
    # agent on a small GPU: auto-fit's default 1 GiB margin left a 35B MoE's dense layers on the CPU of a
    # 3.7 GB T1200 (6.6 tok/s writing, the CPU-only speed). A 512 MiB margin at 64k keeps them on the GPU
    # (14.2) and leaves the desktop, which runs on the same GPU, room for its windows; 128k managed 10.5,
    # and reading 128k there takes an hour anyway (2026-10-16).
    agent) if (( SMALL_GPU )); then
             ctx_flags 65536 "${slots:-$(( RAM_GB >= 48 ? 2 : 1 ))}"; echo "fit-target = 512"
           else
             ctx_flags 131072 "${slots:-$(( RAM_GB >= 48 ? 2 : 1 ))}"
           fi
           echo "cache-ram = 2048"; echo "sleep-idle-seconds = 3600" ;;
    title) ctx_flags 8192 "${slots:-1}"; echo "cache-ram = 256"; helper_gpu_flags
           if (( RAM_GB < 48 )); then echo "sleep-idle-seconds = 120"; fi ;;
    # Embeddings: the model's own context (512 tokens for mxbai-embed-large) — a longer input is an
    # error here, so libfox-intel trims it first; no prompt cache to keep.
    embed) echo "embeddings = true"; echo "cache-ram = 0"; helper_gpu_flags
           if (( RAM_GB < 48 )); then echo "sleep-idle-seconds = 300"; fi ;;
    # `if`, not `&&`: a false test as a function's last command is its status, and write_preset's
    # brace group ends in this call — on a CPU-only box the preset was never written.
    *)     ctx_flags 32768 "${slots:-1}"; echo "cache-ram = 1024"
           if (( RAM_GB < 48 )); then echo "sleep-idle-seconds = 300"; fi ;;
  esac
}

# The downloaded models, one "kind<TAB>name" row each — kind `chat` or `embed` (vision projectors are
# no model of their own). An embedding model says so in its name or carries a pooling type in its
# header (<arch>.pooling_type, near the start of the file) — Qwen3-Embedding's architecture is plain
# qwen3, so the architecture alone can't tell.
store_models() {
  python3 -I - "$GGUF_DIR" <<'EOF'
import pathlib, sys
for p in sorted(pathlib.Path(sys.argv[1]).glob("*.gguf")):
    if "mmproj" in p.stem.lower():
        continue
    try:
        with open(p, "rb") as f:
            head = f.read(1 << 20)
    except OSError:
        continue
    embed = "embed" in p.stem.lower() or b".pooling_type" in head
    print(("embed" if embed else "chat") + "\t" + p.stem)
EOF
}

# Can this llama.cpp load the file? llama-fit-params (shipped beside llama-server) lays the model out
# from the file's header — no weights read, about a second, CPU only — and logs "error loading model:
# <why>" for an architecture or tensor layout this build doesn't know (Ollama's own GGUF variant was
# one). Only that counts: it also fails when the model doesn't fit the RAM free right now, which is no
# reason to drop it (a 19 GB model at 128k failed that way, 2026-10-14). Verdicts are cached per file
# version (name, size, mtime — a refreshed download is probed again), reset when the binary changes.
# Prints why it can't load; nothing when it can, or when there is no probe.
COMPAT="${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-serve/compat-$ENGINE"
load_error() {
  local probe="${1%/*}/llama-fit-params" key stamp line why
  key="${2##*/}@$(stat -c %s-%Y "$2" 2>/dev/null)"; key=${key// /_}
  [[ -x $probe ]] || return 0
  stamp="# $probe $(stat -c %Y "$probe")"
  if [[ -f $COMPAT && $(head -n1 "$COMPAT") == "$stamp" ]]; then
    if line=$(grep -m1 "^$key " "$COMPAT"); then
      why=${line#"$key "}
      if [[ $why != ok ]]; then echo "$why"; fi
      return 0
    fi
  else
    mkdir -p "${COMPAT%/*}" && echo "$stamp" > "$COMPAT"
  fi
  why=$(timeout 120 "$probe" -m "$2" -c 512 -dev none 2>&1 | sed -n 's/.*error loading model: //p' | head -n1)
  echo "$key ${why:-ok}" >> "$COMPAT"
  if [[ -n $why ]]; then echo "$why"; fi
}

# A model's name is its file's: "mxbai-embed-large", "qwen3.5:4b". "name:latest" is the bare name — the
# Ollama spelling older configs, indexes and roles files still carry — and an untagged model answers to
# it too, so those keep working.
canon() {
  if [[ $1 == *:latest && ! -f $GGUF_DIR/$1.gguf ]]; then echo "${1%:latest}"; else echo "$1"; fi
}
aliases() {
  if [[ $1 == *:* ]]; then echo "$1"; else echo "$1,$1:latest"; fi
}

write_preset() {
  local bin=$1; shift
  local roles gpu=0 mib role model server path why kind role_models seen=" "
  local -A kind_of=()
  roles=$(roles_file) || exit 1
  gpu_ok "$bin" && gpu=1
  mib=$(gpu_mib "$bin")
  if (( mib > 0 && mib <= 6144 )); then SMALL_GPU=1; fi
  mkdir -p "$LLM_DIR"
  role_models=$(awk '!/^[[:space:]]*(#|$)/ {print $2}' "$roles" | while read -r model; do canon "$model"; done)
  {
    echo "version = 1"
    echo "; generated by fox-llm-serve from $roles — edit the roles file, not this"
    echo "[*]"
    echo "flash-attn = on"
    echo "cache-type-k = q8_0"     # rotated automatically for quantized caches; free on the GPU
    if [[ $ENGINE == turbo ]]; then
      echo "cache-type-v = turbo4" # the fork's advice for 4-bit weights: keep K at q8_0, compress V
    else
      echo "cache-type-v = q8_0"
    fi
    echo "jinja = true"
    # `|| [[ -n … ]]`: a hand-edited roles file may end without a newline, and `read` drops that line.
    while read -r role model server opts || [[ -n ${role:-} ]]; do
      [[ -z ${role:-} || $role == \#* ]] && continue
      [[ ${server:-} == ollama ]] && server=llama          # a roles file from before llama.cpp served everything
      [[ ${server:-} != "$SERVES" ]] && continue
      model=$(canon "$model")
      path=$(gguf_path "$model") || { echo "; skipped $model ($role): not downloaded yet (fox-llm-update)"; continue; }
      why=$(load_error "$bin" "$path")
      if [[ -n $why ]]; then
        echo "; skipped $model ($role): this llama.cpp can't load it ($why) — pick another model for the role"
        continue
      fi
      seen+="$model "
      echo; echo "[$model]"; echo "; role: $role"; echo "model = $path"
      # The router rewrites `name:tag` section names like a HF `repo:quant` (qwen2.5-coder:1.5b-base was
      # served as qwen2.5-coder:BASE); the alias keeps the real name routable for every client.
      echo "alias = $(aliases "$model")"
      local slots=""; [[ ${opts:-} =~ slots=([0-9]+) ]] && slots=${BASH_REMATCH[1]}
      role_flags "$role" "$slots"
    done < "$roles"
    local extras=("$@")
    if [[ $ENGINE == main && ${FOX_LLM_ONLY_ROLES:-0} != 1 ]]; then
      # the default server: every other downloaded model. A model the roles file names is the roles
      # loop's (here or on the turbo engine), never an extra.
      while IFS=$'\t' read -r kind model; do
        grep -qxF -- "$model" <<<"$role_models" && continue
        extras+=("$model"); kind_of[$model]=$kind
      done < <(store_models)
    fi
    for model in "${extras[@]}"; do
      model=$(canon "$model")
      [[ $seen == *" $model "* ]] && continue
      seen+="$model "
      path=$(gguf_path "$model") || { echo "; skipped $model: not downloaded"; continue; }
      why=$(load_error "$bin" "$path")
      if [[ -n $why ]]; then echo; echo "; skipped $model: this llama.cpp can't load it ($why)"; continue; fi
      echo; echo "[$model]"
      if [[ ${kind_of[$model]:-} == embed ]]; then echo "; extra embedding"; else echo "; extra"; fi
      echo "model = $path"; echo "alias = $(aliases "$model")"
      if [[ ${kind_of[$model]:-} == embed ]]; then role_flags embed ""; else role_flags extra ""; fi
    done
  } > "$PRESET.new" && mv "$PRESET.new" "$PRESET"
  echo "fox-llm-serve: wrote $PRESET ($ENGINE engine, GPU: $( (( gpu )) && echo "yes, $mib MiB" || echo no))" >&2
}

case "${1:-}" in
  roles)  r=$(roles_file) && grep -Ev '^[[:space:]]*(#|$)' "$r" ;;
  preset) shift; bin=$(server_bin) || exit 1; write_preset "$bin" "$@"; cat "$PRESET" ;;
  run)    shift; bin=$(server_bin) || exit 1; write_preset "$bin" "$@"
          echo "fox-llm-serve: $bin on 127.0.0.1:$PORT" >&2
          exec "$bin" --models-preset "$PRESET" --models-max 6 --host 127.0.0.1 --port "$PORT" --no-webui ;;
  *) sed -n '2,/^# Env:/p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
