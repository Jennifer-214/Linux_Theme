#!/usr/bin/env bash
# fox-llm-serve — the llama.cpp router (one URL, many models) built from the roles file.
#
#   fox-llm-serve [--engine main|turbo] run    [extra-model ...]   write the preset, run the router
#   fox-llm-serve [--engine main|turbo] preset [extra-model ...]   write + print the preset INI only
#   fox-llm-serve roles                                            the effective role → model → server table
#
# Two engines, one router each: main = llama.cpp (the llama-cpp package) on :8080 serving roles whose
# server is `llama`; turbo = the TurboQuant fork (llama_turbo module, ~/.local/opt) on :8081 serving
# `llama-turbo` roles — its compressed KV cache generates faster deep into a long context.
#
# Roles: ~/.config/foxml/llm/roles.conf (this machine only), else ~/code/custom_models/roles.conf (yours —
# the private custom_models repo a reinstall clones back), else roles.default (deployed from Linux_Theme
# shared/llm/); the installer never touches the first two. Model files come from Ollama's store — no
# second download — and a preset section is named after the Ollama model, so clients use the same name
# on either server.
# Hugging Face GGUFs (llama.cpp's own format; fox-llm-update downloads them from gguf-models.txt)
# sit in ~/.local/share/fox-llm/gguf/<name>.gguf and are served under <name>, ahead of Ollama.
# Models not downloaded yet are skipped; `fox-llm-update --sync` (run after every download) rewrites
# the preset and has the router reload it — no restart. llama.cpp is the default server: the main
# engine also serves every other chat model in Ollama's store (on demand, ≤3 loaded), except
#   · models the roles file gives another server (`ollama`, `llama-turbo`) — the server column wins;
#   · models whose Modelfile bakes in example messages or a LoRA adapter — llama.cpp would silently
#     drop those, so they stay on Ollama, which runs them as built;
#   · models this llama.cpp can't load (Ollama's own formats) — checked once per file (load_error).
# Embedding models are served too, in embedding mode (/v1/embeddings) — fask/findex use them through
# libfox-intel, which trims long text exactly as Ollama does. FOX_LLM_ONLY_ROLES=1 limits it to the roles.
#
# Slots (parallel conversations per model) follow RAM: under 48 GB the agent gets ONE slot — its whole
# context goes to the one conversation, nothing to fragment or evict (side requests like the plugin's
# explain cards belong on the quick model); from 48 GB it gets two, each capped at the role's context so
# a second conversation can never squeeze out the first. Override per role: `slots=N` after the server.
#
# Residency, for running ghost text + explain cards + a heavy agent on one laptop: fim stays loaded (tiny,
# on the GPU); the agent sleeps after an hour idle — a sleeping model loses its prompt cache (saving it to
# disk doesn't help hybrid Qwen 3.5/3.6: a restored slot isn't reused, tested 2026-10-14), and re-reading
# a long agent conversation takes minutes; under 48 GB the quick model after 10 min (it is the agents'
# stand-in until the agent model is downloaded), the title and embedding models after 2 and 5, other
# models after 5. The router keeps up to 6 loaded, so one stray model never evicts the agent.
#
# Env: FOX_LLM_SERVER (llama-server binary override), FOX_LLM_PORT, OLLAMA_MODELS (Ollama's store).
set -uo pipefail

ENGINE=main
if [[ ${1:-} == --engine ]]; then ENGINE=${2:-}; shift 2; fi
[[ $ENGINE == main || $ENGINE == turbo ]] || { echo "fox-llm-serve: --engine is main or turbo" >&2; exit 2; }

LLM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/foxml/llm"
STORE="${OLLAMA_MODELS:-/usr/share/ollama/.ollama/models}"
GGUF_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fox-llm/gguf"
if [[ $ENGINE == turbo ]]; then
  PRESET="$LLM_DIR/llama-presets-turbo.ini"; PORT="${FOX_LLM_PORT:-8081}"; SERVES=llama-turbo
  SRC="$HOME/.local/opt/llama.cpp-turbo"
else
  PRESET="$LLM_DIR/llama-presets.ini";       PORT="${FOX_LLM_PORT:-8080}"; SERVES=llama
  SRC="$HOME/.local/opt/llama.cpp"
fi

die() { echo "fox-llm-serve: $*" >&2; exit 1; }

roles_file() {
  local f
  for f in "$LLM_DIR/roles.conf" "$HOME/code/custom_models/roles.conf" "$LLM_DIR/roles.default"; do
    [[ -f $f ]] && { echo "$f"; return; }
  done
  die "no roles file (roles.conf in $LLM_DIR or ~/code/custom_models, or $LLM_DIR/roles.default)"
}

server_bin() {
  local c
  local pkg=/usr/bin/llama-server
  [[ $ENGINE == turbo ]] && pkg=""                  # the fork is only ever a source build
  for c in "${FOX_LLM_SERVER:-}" $pkg "$SRC"/build-cuda/bin/llama-server "$SRC"/build-cpu/bin/llama-server; do
    [[ -n $c && -x $c ]] && { echo "$c"; return; }
  done
  if [[ $ENGINE == turbo ]]; then die "no TurboQuant build in $SRC (fox-install --only llama_turbo)"; fi
  die "no llama-server — install the llama-cpp package (fox-install --only llama_server)"
}

# llama.cpp's own device list, not nvidia-smi: NVML can fail (driver halves mismatched after an
# update) while CUDA itself works fine.
gpu_ok() { "$1" --list-devices 2>/dev/null | grep -Eq '^[[:space:]]+(CUDA|Vulkan|ROCm|SYCL)[0-9]+:'; }

# Model name → its GGUF: a Hugging Face download of that name first, else the Ollama model's
# weights blob (the manifest layer of type ...image.model).
gguf_path() {
  if [[ $1 != */* && -f $GGUF_DIR/$1.gguf ]]; then echo "$GGUF_DIR/$1.gguf"; return; fi
  python3 -I - "$STORE" "$1" <<'EOF'
import json, sys, pathlib
root, ref = pathlib.Path(sys.argv[1]), sys.argv[2]
name, _, tag = ref.partition(":")
ns, _, model = name.rpartition("/")
man = root / "manifests/registry.ollama.ai" / (ns or "library") / model / (tag or "latest")
try:
    layers = json.loads(man.read_text())["layers"]
    digest = next(l["digest"] for l in layers if l["mediaType"].endswith(".model"))
except (OSError, StopIteration, KeyError, ValueError):
    sys.exit(1)
print(root / "blobs" / digest.replace(":", "-"))
EOF
}

# role → flags. No placement flags at all: llama.cpp's auto-fit places as much as fits in the VRAM
# free at load time — whole layers of a dense model; for a MoE model everything but the sparse expert
# weights first, experts to RAM as needed (common/fit.cpp). Any manual placement switches the fit off
# and the load then tries the whole model on the GPU: a forced n-gpu-layers OOMed the 4B beside the
# fim model, cpu-moe (a tensor override) every extra model (2026-10-14). And the Arch package
# (llama-cpp 0.6.0) has no --moe-cache-mib: an agent section asking for it would never start.
RAM_GB=$(awk '/^MemTotal:/{printf "%d", ($2 + 1048575) / 1048576}' "${FOX_LLM_MEMINFO:-/proc/meminfo}")

# Context per slot. One slot: `c` is that slot's context. Several: the unified KV pool is
# slots × per-slot (kv-unified-per-slot), so no conversation can take another's room.
ctx_flags() {
  local per=$1 slots=$2
  if (( slots <= 1 )); then
    echo "c = $per"; echo "parallel = 1"
  else
    echo "parallel = $slots"; echo "kv-unified-per-slot = $per"
  fi
}

role_flags() {
  local role=$1 slots=$2
  case $role in
    fim)   ctx_flags 8192 "${slots:-1}";  echo "load-on-startup = true"; echo "cache-ram = 256" ;;
    quick) ctx_flags 32768 "${slots:-2}"; echo "cache-ram = 1024"
           if (( RAM_GB < 48 )); then echo "sleep-idle-seconds = 600"; fi ;;
    agent) ctx_flags 131072 "${slots:-$(( RAM_GB >= 48 ? 2 : 1 ))}"
           echo "cache-ram = 2048"; echo "sleep-idle-seconds = 3600" ;;
    title) ctx_flags 8192 "${slots:-1}"; echo "cache-ram = 256"
           if (( RAM_GB < 48 )); then echo "sleep-idle-seconds = 120"; fi ;;
    # Embeddings: the model's own context (512 tokens for mxbai-embed-large) — a longer input is an
    # error here, so libfox-intel trims it first; no prompt cache to keep.
    embed) echo "embeddings = true"; echo "cache-ram = 0"
           if (( RAM_GB < 48 )); then echo "sleep-idle-seconds = 300"; fi ;;
    # `if`, not `&&`: a false test as a function's last command is its status, and write_preset's
    # brace group ends in this call — on a CPU-only box the preset was never written.
    *)     ctx_flags 32768 "${slots:-1}"; echo "cache-ram = 1024"
           if (( RAM_GB < 48 )); then echo "sleep-idle-seconds = 300"; fi ;;
  esac
}

# The models to serve, one "kind<TAB>name<TAB>why it stays on Ollama" row each — kind `chat` or `embed`,
# always set, first: tab is IFS whitespace to `read`, so an empty middle field would collapse; the reason
# is empty when llama.cpp can run the model as built. The Hugging Face downloads first (vision projectors
# aside), then Ollama's store. A SYSTEM layer alone is no reason — the
# library's Qwen 2.5 models carry their stock default, which the GGUF's own chat template applies too.
store_models() {
  python3 -I - "$STORE" "$GGUF_DIR" <<'EOF'
import json, pathlib, sys
store = pathlib.Path(sys.argv[1])
for p in sorted(pathlib.Path(sys.argv[2]).glob("*.gguf")):
    if "mmproj" not in p.stem:
        print(("embed" if "embed" in p.stem else "chat") + "\t" + p.stem + "\t")
reg = store / "manifests/registry.ollama.ai"
OLLAMA_ONLY = {"messages": "its Modelfile bakes in example messages", "adapter": "its Modelfile adds a LoRA adapter"}
for tag in sorted(p for p in reg.glob("*/*/*") if p.is_file()) if reg.is_dir() else []:
    ns, model = tag.parent.parent.name, tag.parent.name
    name = (model if ns == "library" else f"{ns}/{model}") + ":" + tag.name
    try:
        man = json.loads(tag.read_text())
        kinds = {l["mediaType"].rsplit(".", 1)[-1] for l in man["layers"]}
    except (OSError, ValueError, KeyError, TypeError):
        continue
    try:   # the config blob names the family: nomic-bert, bert, … are embedding models
        family = json.loads((store / "blobs" / man["config"]["digest"].replace(":", "-")).read_text())["model_family"]
    except (OSError, ValueError, KeyError, TypeError):
        family = ""
    if "model" not in kinds:
        continue
    kind = "embed" if "embed" in name or "bert" in family else "chat"
    print(kind + "\t" + name + "\t" + next((why for k, why in OLLAMA_ONLY.items() if k in kinds), ""))
EOF
}

# Can this llama.cpp load the blob? llama-fit-params (shipped beside llama-server) lays the model out
# from the file's header — no weights read, about a second, CPU only — and logs "error loading model:
# <why>" for an architecture or tensor layout this build doesn't know (Ollama's own formats). Only that
# counts: it also fails when the model doesn't fit the RAM free right now, which is no reason to drop
# it (a 19 GB model at 128k failed that way, 2026-10-14). Verdicts are cached per blob, reset when the
# binary changes. Prints why it can't load; nothing when it can, or when there is no probe.
COMPAT="${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-serve/compat-$ENGINE"
load_error() {
  local probe="${1%/*}/llama-fit-params" key=${2##*/} stamp line why
  [[ -x $probe ]] || return 0
  stamp="# $probe $(stat -c %Y "$probe")"
  if [[ -f $COMPAT && $(head -n1 "$COMPAT") == "$stamp" ]]; then
    if line=$(grep -m1 "^$key " "$COMPAT"); then
      why=${line#"$key "}
      if [[ $why != ok ]]; then echo "$why"; fi
      return 0
    fi
  else
    mkdir -p "${COMPAT%/*}" && echo "$stamp" > "$COMPAT"
  fi
  why=$(timeout 120 "$probe" -m "$2" -c 512 -dev none 2>&1 | sed -n 's/.*error loading model: //p' | head -n1)
  echo "$key ${why:-ok}" >> "$COMPAT"
  if [[ -n $why ]]; then echo "$why"; fi
}

# Ollama's naming: a bare "name" is "name:latest". Sections use the full name, so a roles line without
# a tag and the store's own entry are one model, served once; a :latest model also answers to the bare
# name, as on Ollama (libfox-intel asks for "mxbai-embed-large"). A Hugging Face download keeps its name.
canon() {
  if [[ $1 == *:* || -f $GGUF_DIR/$1.gguf ]]; then echo "$1"; else echo "$1:latest"; fi
}
aliases() {
  if [[ $1 == *:latest ]]; then echo "$1,${1%:latest}"; else echo "$1"; fi
}

write_preset() {
  local bin=$1; shift
  local roles gpu=0 role model server path why reason kind role_models seen=" "
  local -A kind_of=()
  roles=$(roles_file) || exit 1
  gpu_ok "$bin" && gpu=1
  mkdir -p "$LLM_DIR"
  role_models=$(awk '!/^[[:space:]]*(#|$)/ {print $2}' "$roles" | while read -r model; do canon "$model"; done)
  {
    echo "version = 1"
    echo "; generated by fox-llm-serve from $roles — edit the roles file, not this"
    echo "[*]"
    echo "flash-attn = on"
    echo "cache-type-k = q8_0"     # rotated automatically for quantized caches; free on the GPU
    if [[ $ENGINE == turbo ]]; then
      echo "cache-type-v = turbo4" # the fork's advice for 4-bit weights: keep K at q8_0, compress V
    else
      echo "cache-type-v = q8_0"
    fi
    echo "jinja = true"
    # `|| [[ -n … ]]`: a hand-edited roles file may end without a newline, and `read` drops that line.
    while read -r role model server opts || [[ -n ${role:-} ]]; do
      [[ -z ${role:-} || $role == \#* || ${server:-} != "$SERVES" ]] && continue
      model=$(canon "$model")
      path=$(gguf_path "$model") || { echo "; skipped $model ($role): not in Ollama's store yet"; continue; }
      why=$(load_error "$bin" "$path")
      if [[ -n $why ]]; then
        echo "; skipped $model ($role): this llama.cpp can't load it ($why) — give the role server ollama"
        continue
      fi
      seen+="$model "
      echo; echo "[$model]"; echo "; role: $role"; echo "model = $path"
      # The router rewrites `name:tag` section names like a HF `repo:quant` (qwen2.5-coder:1.5b-base was
      # served as qwen2.5-coder:BASE); the alias keeps the Ollama name routable for every client.
      echo "alias = $(aliases "$model")"
      local slots=""; [[ ${opts:-} =~ slots=([0-9]+) ]] && slots=${BASH_REMATCH[1]}
      role_flags "$role" "$slots"
    done < "$roles"
    local extras=("$@")
    if [[ $ENGINE == main && ${FOX_LLM_ONLY_ROLES:-0} != 1 ]]; then
      # the default server: every other chat model Ollama holds. A model the roles file names is the
      # roles loop's (here or on another server), never an extra.
      while IFS=$'\t' read -r kind model reason; do
        grep -qxF -- "$model" <<<"$role_models" && continue
        if [[ -n $reason ]]; then echo; echo "; on Ollama only: $model — $reason"; continue; fi
        extras+=("$model"); kind_of[$model]=$kind
      done < <(store_models)
    fi
    for model in "${extras[@]}"; do
      [[ $seen == *" $model "* ]] && continue
      seen+="$model "
      path=$(gguf_path "$model") || { echo "; skipped $model: not in Ollama's store"; continue; }
      why=$(load_error "$bin" "$path")
      if [[ -n $why ]]; then echo; echo "; on Ollama only: $model — this llama.cpp can't load it ($why)"; continue; fi
      echo; echo "[$model]"
      if [[ ${kind_of[$model]:-} == embed ]]; then echo "; extra embedding"; else echo "; extra"; fi
      echo "model = $path"; echo "alias = $(aliases "$model")"
      if [[ ${kind_of[$model]:-} == embed ]]; then role_flags embed ""; else role_flags extra ""; fi
    done
  } > "$PRESET.new" && mv "$PRESET.new" "$PRESET"
  echo "fox-llm-serve: wrote $PRESET ($ENGINE engine, GPU: $( (( gpu )) && echo yes || echo no))" >&2
}

case "${1:-}" in
  roles)  r=$(roles_file) && grep -Ev '^[[:space:]]*(#|$)' "$r" ;;
  preset) shift; bin=$(server_bin) || exit 1; write_preset "$bin" "$@"; cat "$PRESET" ;;
  run)    shift; bin=$(server_bin) || exit 1; write_preset "$bin" "$@"
          echo "fox-llm-serve: $bin on 127.0.0.1:$PORT" >&2
          exec "$bin" --models-preset "$PRESET" --models-max 6 --host 127.0.0.1 --port "$PORT" --no-webui ;;
  *) sed -n '2,/^# Env:/p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
