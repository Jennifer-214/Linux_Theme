#!/usr/bin/env bash
# fox-llm-serve — the llama.cpp router (one URL, many models) built from the roles file.
#
#   fox-llm-serve [--engine main|turbo] run    [extra-model ...]   write the preset, run the router
#   fox-llm-serve [--engine main|turbo] preset [extra-model ...]   write + print the preset INI only
#   fox-llm-serve roles                                            the effective role → model → server table
#
# Two engines, one router each: main = llama.cpp (the llama-cpp package) on :8080 serving roles whose
# server is `llama`; turbo = the TurboQuant fork (llama_turbo module, ~/.local/opt) on :8081 serving
# `llama-turbo` roles — its compressed KV cache generates faster deep into a long context.
#
# Roles: ~/.config/foxml/llm/roles.conf (yours; never overwritten), else roles.default (deployed
# from Linux_Theme shared/llm/). Model files come from Ollama's store — no second download — and a
# preset section is named after the Ollama model, so clients use the same name on either server.
# Models not downloaded yet are skipped and picked up on the next start.
#
# Env: FOX_LLM_SERVER (llama-server binary override), FOX_LLM_PORT, OLLAMA_MODELS (Ollama's store).
set -uo pipefail

ENGINE=main
if [[ ${1:-} == --engine ]]; then ENGINE=${2:-}; shift 2; fi
[[ $ENGINE == main || $ENGINE == turbo ]] || { echo "fox-llm-serve: --engine is main or turbo" >&2; exit 2; }

LLM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/foxml/llm"
STORE="${OLLAMA_MODELS:-/usr/share/ollama/.ollama/models}"
if [[ $ENGINE == turbo ]]; then
  PRESET="$LLM_DIR/llama-presets-turbo.ini"; PORT="${FOX_LLM_PORT:-8081}"; SERVES=llama-turbo
  SRC="$HOME/.local/opt/llama.cpp-turbo"
else
  PRESET="$LLM_DIR/llama-presets.ini";       PORT="${FOX_LLM_PORT:-8080}"; SERVES=llama
  SRC="$HOME/.local/opt/llama.cpp"
fi

die() { echo "fox-llm-serve: $*" >&2; exit 1; }

roles_file() {
  local f
  for f in "$LLM_DIR/roles.conf" "$LLM_DIR/roles.default"; do
    [[ -f $f ]] && { echo "$f"; return; }
  done
  die "no roles file in $LLM_DIR (roles.conf or roles.default)"
}

server_bin() {
  local c
  local pkg=/usr/bin/llama-server
  [[ $ENGINE == turbo ]] && pkg=""                  # the fork is only ever a source build
  for c in "${FOX_LLM_SERVER:-}" $pkg "$SRC"/build-cuda/bin/llama-server "$SRC"/build-cpu/bin/llama-server; do
    [[ -n $c && -x $c ]] && { echo "$c"; return; }
  done
  if [[ $ENGINE == turbo ]]; then die "no TurboQuant build in $SRC (fox-install --only llama_turbo)"; fi
  die "no llama-server — install the llama-cpp package (fox-install --only llama_server)"
}

# llama.cpp's own device list, not nvidia-smi: NVML can fail (driver halves mismatched after an
# update) while CUDA itself works fine.
gpu_ok() { "$1" --list-devices 2>/dev/null | grep -Eq '^[[:space:]]+(CUDA|Vulkan|ROCm|SYCL)[0-9]+:'; }

# Ollama model name → its GGUF weights blob (the manifest layer of type ...image.model).
gguf_path() {
  python3 -I - "$STORE" "$1" <<'EOF'
import json, sys, pathlib
root, ref = pathlib.Path(sys.argv[1]), sys.argv[2]
name, _, tag = ref.partition(":")
ns, _, model = name.rpartition("/")
man = root / "manifests/registry.ollama.ai" / (ns or "library") / model / (tag or "latest")
try:
    layers = json.loads(man.read_text())["layers"]
    digest = next(l["digest"] for l in layers if l["mediaType"].endswith(".model"))
except (OSError, StopIteration, KeyError, ValueError):
    sys.exit(1)
print(root / "blobs" / digest.replace(":", "-"))
EOF
}

# role → flags. GPU layers are never forced: llama.cpp's auto-fit places as much as fits in the VRAM
# free at load time — a forced n-gpu-layers disables the fit, and on a 4 GB card shared with the
# always-loaded fim model (or Ollama) the 4B then failed to allocate (measured 2026-10-14).
# Agents pin the MoE experts in RAM (cpu-moe; a no-op on dense models) so attention + KV get the
# GPU, with a small cache there for the hot experts.
role_flags() {
  local role=$1 gpu=$2
  case $role in
    fim)   echo "c = 8192";   echo "load-on-startup = true"; echo "cache-ram = 256" ;;
    quick) echo "c = 32768";  echo "cache-ram = 1024" ;;
    agent) echo "c = 131072"; echo "cache-ram = 2048"; echo "sleep-idle-seconds = 900"
           (( gpu )) && { echo "cpu-moe = true"; echo "moe-cache-mib = 512"; } ;;
    *)     echo "c = 32768";  echo "cache-ram = 1024" ;;
  esac
}

write_preset() {
  local bin=$1; shift
  local roles gpu=0 role model server path seen=" "
  roles=$(roles_file) || exit 1
  gpu_ok "$bin" && gpu=1
  mkdir -p "$LLM_DIR"
  {
    echo "version = 1"
    echo "; generated by fox-llm-serve from $roles — edit the roles file, not this"
    echo "[*]"
    echo "flash-attn = on"
    echo "cache-type-k = q8_0"     # rotated automatically for quantized caches; free on the GPU
    if [[ $ENGINE == turbo ]]; then
      echo "cache-type-v = turbo4" # the fork's advice for 4-bit weights: keep K at q8_0, compress V
    else
      echo "cache-type-v = q8_0"
    fi
    echo "jinja = true"
    while read -r role model server _; do
      [[ -z ${role:-} || $role == \#* || ${server:-} != "$SERVES" ]] && continue
      path=$(gguf_path "$model") || { echo "; skipped $model ($role): not in Ollama's store yet"; continue; }
      seen+="$model "
      echo; echo "[$model]"; echo "; role: $role"; echo "model = $path"
      # The router rewrites `name:tag` section names like a HF `repo:quant` (qwen2.5-coder:1.5b-base was
      # served as qwen2.5-coder:BASE); the alias keeps the Ollama name routable for every client.
      echo "alias = $model"
      role_flags "$role" "$gpu"
    done < "$roles"
    for model in "$@"; do
      [[ $seen == *" $model "* ]] && continue
      path=$(gguf_path "$model") || { echo "; skipped $model: not in Ollama's store"; continue; }
      echo; echo "[$model]"; echo "; extra"; echo "model = $path"; echo "alias = $model"
      role_flags extra "$gpu"
    done
  } > "$PRESET.new" && mv "$PRESET.new" "$PRESET"
  echo "fox-llm-serve: wrote $PRESET ($ENGINE engine, GPU: $( (( gpu )) && echo yes || echo no))" >&2
}

case "${1:-}" in
  roles)  r=$(roles_file) && grep -Ev '^[[:space:]]*(#|$)' "$r" ;;
  preset) shift; bin=$(server_bin) || exit 1; write_preset "$bin" "$@"; cat "$PRESET" ;;
  run)    shift; bin=$(server_bin) || exit 1; write_preset "$bin" "$@"
          echo "fox-llm-serve: $bin on 127.0.0.1:$PORT" >&2
          exec "$bin" --models-preset "$PRESET" --models-max 3 --host 127.0.0.1 --port "$PORT" --no-webui ;;
  *) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
