#!/usr/bin/env bash
# desk-aider — aider wrapper that stays in sync with the global model choice.
#
# Reads the current model from ~/.config/opencode/opencode.json (the same
# file ai-swap edits) so swapping the model once swaps it for OpenCode
# AND aider in one shot. aider reaches llama.cpp's router as an
# OpenAI-compatible server (127.0.0.1:8080, the TurboQuant one on :8081).
#
# Usage:
#   desk-aider                       # interactive REPL in cwd
#   desk-aider path/to/file          # add file to chat
#   desk-aider --message "<prompt>"  # one-shot prompt
#   FOXAI_MODEL=qwen2.5-coder:14b desk-aider   # explicit override (any name llm-run --list shows)
#
# Anything passed after the wrapper is forwarded to aider verbatim.

set -u

if ! command -v aider >/dev/null 2>&1; then
    echo "desk-aider: aider not installed. Run \`desk-install --only ai\` or" >&2
    echo "  \`pipx install aider-chat && pipx inject aider-chat audioop-lts\`" >&2
    exit 1
fi

# Resolve the model:
#   1. FOXAI_MODEL env wins
#   2. ~/.config/opencode/opencode.json's "model" field (set by ai-swap)
#   3. llm-run's pick: ai-default's, else the roles file's quick model
MODEL="${FOXAI_MODEL:-}"
if [[ -z "$MODEL" && -f "$HOME/.config/opencode/opencode.json" ]] && command -v jq >/dev/null 2>&1; then
    MODEL=$(jq -r '.model // empty' "$HOME/.config/opencode/opencode.json" 2>/dev/null)
fi
# A cloud model (anthropic/…, openai/…) goes to aider as it is. A local one — opencode's llamacpp/…,
# the ollama/… of older configs, or a bare name — is served by llama.cpp's router, which aider
# (litellm) reaches as an OpenAI-compatible server: openai/<name> at its /v1.
if [[ -z "$MODEL" ]] && command -v llm-run >/dev/null 2>&1; then
    MODEL=$(llm-run --model)
fi
API_BASE=""
case "$MODEL" in
    llamacpp-turbo/*) API_BASE=http://127.0.0.1:8081/v1; MODEL="${MODEL#*/}" ;;
    llamacpp/*|ollama/*|ollama_chat/*) API_BASE=http://127.0.0.1:8080/v1; MODEL="${MODEL#*/}" ;;
    */*) ;;
    "") echo "desk-aider: no model — set one with ai-default" >&2; exit 1 ;;
    *) API_BASE=http://127.0.0.1:8080/v1 ;;
esac
LOCAL_ARGS=()
if [[ -n "$API_BASE" ]]; then
    systemctl --user start "fox-llm-server$([[ $API_BASE == *8081* ]] && echo -turbo).service" 2>/dev/null
    MODEL="openai/$MODEL"
    # the router asks for no key; litellm wants one set. A local model is "unknown" to litellm's price
    # and context tables — that warning says nothing here.
    LOCAL_ARGS=(--openai-api-base "$API_BASE" --openai-api-key none --no-show-model-warnings)
fi

# Theme: --no-pretty drops aider's Rich-rendered chrome (frames, "Warning:"
# headers, hyperlink underlines) which were leaning on terminal ANSI
# bright-green and clashing with Linux_Theme. The per-color flags still apply
# to user input and assistant output, so chat itself stays warmly tinted.
# Per-call overrides win because they're later in argv.
# Colours follow the active theme (rendered palette), Classic's as the fallback
_pal="$HOME/.config/hypr/modules/border_colors.sh"
[[ -r "$_pal" ]] && source "$_pal"
exec aider \
    --model "$MODEL" \
    "${LOCAL_ARGS[@]}" \
    --no-pretty \
    --user-input-color       "#${C_PRIMARY:-d4985a}" \
    --assistant-output-color "#${C_FG:-d5c4b0}" \
    --tool-output-color      "#${C_OK:-8a9a7a}" \
    --tool-warning-color     "#${C_WARN:-c4b48a}" \
    --tool-error-color       "#${C_RED:-b05555}" \
    "$@"
