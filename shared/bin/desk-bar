#!/usr/bin/env bash
# The drawer and bar share one named Quickshell service.
set -euo pipefail
launcher_dir="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
export PATH="$launcher_dir:${PATH:-/usr/local/bin:/usr/bin:/bin}"
ipc() { quickshell -c desk ipc call bar "$@"; }
case "${1:-toggle}" in
    --help|-h) printf '%s\n' 'Usage: desk-bar [start|show|hide|toggle|status|refresh [MODULE]]'; exit 0 ;;
    status) ipc status; exit $? ;;
    refresh) ipc refresh "${2:-}" >/dev/null; exit $? ;;
    hide) ipc hide >/dev/null; exit $? ;;
    start|--start|show|toggle) action="${1#--}" ;;
    *) printf 'desk-bar: unknown action: %s\n' "$1" >&2; exit 2 ;;
esac
desktop-menu --start
if [[ "$action" == toggle ]]; then ipc toggle >/dev/null; else ipc start >/dev/null; fi
# Only a bar that failed is hidden (it keeps reporting an error, or never answers), so start_waybar.sh's Waybar is the
# one bar. A bar that is only slow, on a busy first login, is left to show itself: hiding it after four seconds hid it
# later instead, at the first drawer open. One read with an error (a config caught mid-write) is not a failure.
errors=0
for ((attempt=0; attempt<200; attempt++)); do
    state=$(ipc status 2>/dev/null) || state='{}'
    if printf '%s' "$state" | jq -e '.ready == true and .error == ""' >/dev/null 2>&1; then exit 0; fi
    if printf '%s' "$state" | jq -e '(.error // "") != ""' >/dev/null 2>&1; then
        (( ++errors < 20 )) || break
    else
        errors=0
    fi
    sleep .1
done
if (( errors >= 20 )) || [[ "$state" == '{}' ]]; then
    ipc hide >/dev/null 2>&1 || true
    printf 'desk-bar: the bar did not start: %s\n' "$state" >&2
    exit 1
fi
printf 'desk-bar: the bar is still loading; it shows itself when it is ready.\n' >&2
exit 0
