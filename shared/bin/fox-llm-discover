#!/usr/bin/env python3
"""fox-llm-discover — find the newest tool-capable GGUF models on Hugging Face that fit this machine.

Reads the newest uploads of llama.cpp's own org (ggml-org) and unsloth — both quantize notable
releases, where bartowski does nearly every community fine-tune; a model once, from the first that
has it — keeps the chat models whose template takes tools, picks each one's 4-bit single-file GGUF
that fits (MXFP4 for gpt-oss, its native format; else Q4_K_M), and prints the newest first as TSV:

    name  user/repo/file.gguf  size_gb  class  abliterated_name  abliterated_file

class: moe   — mixture-of-experts: agent speed on CPU. From the architecture (qwen3moe, lfm2moe,
               gpt-oss, …) or the name (-A3B: 3B parameters active per token)
       small — dense, ≤ --small-gb: usable
       slow  — dense and bigger: fits in RAM but too slow for agent loops
The abliterated twin is a Huihui abliteration of the same model in a single file ("-" "-" when there is
none). A model you already have — the same model from any quantizer, given by --have — is left out.
"""
import argparse
import concurrent.futures as cf
import json
import re
import sys
import urllib.parse
import urllib.request

API = "https://huggingface.co/api/models"
AUTHORS = ("ggml-org", "unsloth")                         # first one wins a model both publish
TWIN_AUTHORS = ("huihui-ai", "bartowski", "mradermacher")
MOE_ARCH = ("gpt-oss", "deepseek2", "llama4", "mixtral", "dots1", "hunyuan-moe", "ernie4_5-moe")
MOE_NAME = re.compile(r"-a\d+(\.\d+)?b\b", re.I)
SPLIT = re.compile(r"-\d{5}-of-\d{5}\.gguf$")
QUANTS = ("q4_k_m", "q4_k_xl", "q4_k_s", "iq4_xs", "q4_0")  # best first; gpt-oss: mxfp4 before them


def get(url):
    req = urllib.request.Request(url, headers={"User-Agent": "fox-llm-discover"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def key(repo):
    """One spelling per model across quantizers: "unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF",
    "bartowski/Qwen_Qwen3-Coder-30B-A3B-Instruct-GGUF" and "Qwen/Qwen3-Coder-30B-A3B-Instruct" all
    give "qwen3-coder-30b-a3b"."""
    n = repo.rsplit("/", 1)[-1].lower()
    n = re.sub(r"[-_.](gguf)$", "", n)
    n = re.sub(r"[-_.](q\d_k(_[a-z]+)?|q\d_\d|iq\d_\w+|f16|bf16|mxfp4)$", "", n)
    if repo.lower().startswith("bartowski/") and "_" in n:
        n = n.split("_", 1)[1]                                 # bartowski's "Org_" prefix
    return re.sub(r"-instruct\b", "", n)


def base_of(m):
    b = (m.get("cardData") or {}).get("base_model")
    b = b[0] if isinstance(b, list) and b else b
    return b if isinstance(b, str) and "/" in b else m["id"]


def newest(author, limit):
    q = urllib.parse.urlencode([("author", author), ("filter", "gguf"), ("sort", "createdAt"), ("direction", "-1"),
                                ("limit", str(limit)), ("expand[]", "gguf"), ("expand[]", "createdAt"),
                                ("expand[]", "cardData")])
    return get(f"{API}?{q}")


def pick_file(repo, arch, max_gb):
    """(path, GB) of the best single-file 4-bit GGUF in the repo that fits; None when none does."""
    files = [f for f in get(f"{API}/{repo}/tree/main?recursive=1")
             if f.get("path", "").lower().endswith(".gguf") and not SPLIT.search(f["path"])
             and not re.search(r"(^|/)(mmproj|mtp)", f["path"].lower())      # a vision projector, a draft head
             and f.get("size", 0) / 1e9 <= max_gb]
    prefs = (("mxfp4",) if arch == "gpt-oss" else ()) + QUANTS
    for q in prefs:
        hit = [f for f in files if q in f["path"].rsplit("/", 1)[-1].lower()]
        if hit:
            f = min(hit, key=lambda f: len(f["path"]))        # the plain one, not an -imat / -v2 variant
            return f["path"], f["size"] / 1e9
    return None


def twin(base, arch, max_gb, have):
    """("huihui-<model>-abliterated", "user/repo/file.gguf") for a Huihui abliteration of base you
    don't have yet."""
    q = urllib.parse.urlencode([("search", base.rsplit("/", 1)[-1] + "-abliterated"), ("filter", "gguf"),
                                ("sort", "downloads"), ("direction", "-1"), ("limit", "20")])
    for m in get(f"{API}?{q}"):
        repo = m["id"]
        if repo.split("/")[0] not in TWIN_AUTHORS or "huihui" not in repo.lower():
            continue
        if key(repo) in have:
            return "-", "-"
        f = pick_file(repo, arch, max_gb)
        if f:
            return f"huihui-{key(base)}-abliterated", f"{repo}/{f[0]}"
    return "-", "-"


def classify(name, arch, gb, small_gb):
    if "moe" in arch or arch in MOE_ARCH or MOE_NAME.search(name):
        return "moe"
    return "small" if gb <= small_gb else "slow"


def default_max_gb():
    try:
        with open("/proc/meminfo") as f:
            kb = next(int(l.split()[1]) for l in f if l.startswith("MemTotal:"))
        return max(4.0, kb / 1048576 - 8)                     # leave the desktop + a small model their room
    except (OSError, StopIteration, ValueError):
        return 24.0


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--max-gb", type=float, default=default_max_gb(), help="largest file that fits (default: RAM − 8 GB)")
    ap.add_argument("--small-gb", type=float, default=9.0, help="dense models up to this are usable (default 9)")
    ap.add_argument("--limit", type=int, default=60, help="newest uploads read per quantizer (default 60)")
    ap.add_argument("--have", default="", help="file of user/repo/file.gguf lines you already have")
    a = ap.parse_args()
    have = set()
    if a.have:
        with open(a.have) as f:
            have = {key(l.split()[0].rsplit("/", 1)[0]) for l in f if l.strip() and "/" in l}

    found = {}                                                 # model key → (createdAt, author rank, repo, info)
    for rank, author in enumerate(AUTHORS):
        try:
            models = newest(author, a.limit)
        except Exception as e:
            print(f"fox-llm-discover: {author}: {e}", file=sys.stderr)
            continue
        for m in models:
            g = m.get("gguf") or {}
            if "tools" not in (g.get("chat_template") or "") or not g.get("architecture"):
                continue                                       # no tool calls, or no chat model at all
            if (g.get("total") or 0) * 0.55 / 1e9 > a.max_gb:
                continue                                       # even 4-bit won't fit
            k = key(base_of(m))
            if k in have or key(m["id"]) in have:
                continue
            if k not in found or rank < found[k][1]:
                found[k] = (m.get("createdAt", ""), rank, m["id"], g, base_of(m))

    def row(item):
        created, _, repo, g, base = item
        try:
            f = pick_file(repo, g["architecture"], a.max_gb)
            if not f:
                return None
            name = key(base)
            cls = classify(name, g["architecture"], f[1], a.small_gb)
            abl = twin(base, g["architecture"], a.max_gb, have)
            return created, f"{name}\t{repo}/{f[0]}\t{f[1]:.1f}\t{cls}\t{abl[0]}\t{abl[1]}"
        except Exception as e:
            print(f"fox-llm-discover: {repo}: {e}", file=sys.stderr)
            return None

    with cf.ThreadPoolExecutor(8) as ex:
        rows = [r for r in ex.map(row, found.values()) if r]
    for _, line in sorted(rows, reverse=True):                  # newest first
        print(line)


if __name__ == "__main__":
    sys.exit(main())
