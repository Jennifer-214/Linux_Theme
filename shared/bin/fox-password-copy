#!/usr/bin/env bash
# fox-password-copy — let pass copy without adding passwords to clipboard history.
set -euo pipefail
[[ $# == 1 && -n "$1" ]] || exit 2
# pass owns decryption and expiry; only add Wayland's sensitive-content hint.
wl-copy() { command wl-copy --sensitive "$@"; }
export -f wl-copy
exec pass show --clip=1 -- "$1"
