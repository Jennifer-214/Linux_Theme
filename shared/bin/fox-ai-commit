#!/bin/bash
# fox-ai-commit — Generate git commit messages with the local model (llama.cpp)

if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo "Error: Not a git repository."
    exit 1
fi

DIFF=$(git diff --cached)

if [[ -z "$DIFF" ]]; then
    echo "Error: No staged changes. Use 'git add' first."
    exit 1
fi

# fox-llm-run picks the model: FOXAI_MODEL, else fox-ai-default's, else opencode's local default,
# else the roles file's quick model.
MODEL=$(fox-llm-run --model) || exit 1

echo "Generating commit message with $MODEL..."

PROMPT="You are a senior developer. Write a concise, professional git commit message based on the following diff. Use the conventional commits format (type: description). Keep the summary line under 50 characters. If the changes are complex, add a few bullet points in the body. Do not include markdown code blocks, just the raw text.

Diff:
$DIFF"

MESSAGE=$(fox-llm-run "$PROMPT")

echo -e "\n-- PROPOSED MESSAGE --\n"
echo "$MESSAGE"
echo -e "\n----------------------\n"

read -p "Use this message? [y/N] " -n 1 -r
echo ""
if [[ $REPLY =~ ^[Yy]$ ]]; then
    git commit -m "$MESSAGE"
else
    echo "Commit aborted."
fi
