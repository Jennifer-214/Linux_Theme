#!/usr/bin/env bash
# fox-hl — send one command to Hyprland in whichever language it speaks.
# Hyprland 0.57 takes only Lua (`hyprctl dispatch 'hl.dsp.…'`, `hyprctl eval
# 'hl.config(…)'`); 0.56 and older take only the legacy forms (`hyprctl dispatch
# <name> <args>`, `hyprctl keyword`). Call sites pass both, so the scripts keep
# working across the upgrade and after a downgrade.
#
#   fox-hl dispatch '<hl.dsp.… expression>' '<legacy dispatcher> <args>'
#   fox-hl config   '<table for hl.config>'  '<legacy "keyword …" batch, ;-separated>'
set -u

mode="${1:-}" lua="${2:-}" legacy="${3:-}"
if [[ -z "$mode" || -z "$lua" || -z "$legacy" ]]; then
    echo "usage: fox-hl dispatch|config '<lua>' '<legacy>'" >&2
    exit 2
fi

# Legacy builds answer `eval` with an error ("unknown request" before 0.55,
# "only supported with the lua config manager" on a hyprlang config).
reply=$(hyprctl eval 'return 1' 2>&1)
if [[ "$reply" == *"unknown request"* || "$reply" == *"only supported with the lua"* ]]; then
    case "$mode" in
        dispatch) read -r -a args <<<"$legacy"; exec hyprctl dispatch "${args[@]}" ;;
        config)   exec hyprctl --batch "$legacy" ;;
    esac
else
    case "$mode" in
        dispatch) exec hyprctl dispatch "$lua" ;;
        config)   exec hyprctl eval "hl.config($lua)" ;;
    esac
fi
echo "fox-hl: unknown mode '$mode' (dispatch|config)" >&2
exit 2
