#!/bin/bash
# FoxML AI Status — Waybar module for OpenCode model status.
# Display reads as a peer of the memory module: "<icon> <size> X/Yg",
# where X is the default model's resident memory while llama.cpp's router has it loaded (fox-llm-run
# --ps) and Y is total VRAM. Falls back to "idle" when it isn't loaded.

CONFIG_FILE="$HOME/.config/opencode/opencode.json"

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo '{"text": "  OFF", "tooltip": "OpenCode config not found", "class": "offline"}'
    exit 0
fi

MODEL_FULL=$(jq -r '.model // empty' "$CONFIG_FILE")
if [[ -z "$MODEL_FULL" || "$MODEL_FULL" == "null" ]]; then
    echo '{"text": "  OFF", "tooltip": "No model set in config", "class": "offline"}'
    exit 0
fi

MODEL_NAME="${MODEL_FULL#*/}"
SIZE=$(echo "$MODEL_NAME" | grep -ioP '\d+[bB]' | head -n1 | tr '[:lower:]' '[:upper:]')
DISPLAY_TAG="${SIZE:-${MODEL_NAME:0:8}}"

# ── Total VRAM (GB, one decimal) ─────────────────────────────────
# Asked of nvidia-smi once per boot, not every 2 s tick: the total never changes, and an NVIDIA update without a
# reboot makes every call fail ("Driver/library version mismatch") and leave a kernel log entry — 2026-10-13..15,
# ~1,800 an hour from this module alone, while windows opened since the update drew on the CPU. Asked again when
# the NVML library changes (that update), so the mismatch shows here at once: "reboot", until the reboot that
# fixes it. The answer lives in the runtime dir, which a reboot empties.
CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}/foxml-waybar"
VRAM_CACHE="$CACHE_DIR/vram-total"                # "<MB>|<nvml lib>" | "none|<lib>" | "mismatch|<lib>|<module>|<library>"
nvml_lib=$(readlink -f "${FOX_NVML_LIB:-/usr/lib/libnvidia-ml.so.1}" 2>/dev/null)
vram_state="" cached_lib=""
[[ -r $VRAM_CACHE ]] && IFS='|' read -r vram_state cached_lib drv_mod drv_lib < "$VRAM_CACHE"
if [[ -z $vram_state || $cached_lib != "$nvml_lib" ]]; then
    state="none" smi="${FOX_NVIDIA_SMI:-nvidia-smi}"
    if command -v "$smi" &>/dev/null; then
        out=$("$smi" --query-gpu=memory.total --format=csv,noheader,nounits 2>&1)
        first=$(head -1 <<<"$out" | tr -d ' ')
        if grep -q 'version mismatch' <<<"$out"; then
            mod=$(grep -oP '\b[0-9]{3}\.[0-9]+(\.[0-9]+)?\b' "${FOX_NVIDIA_VERSION:-/proc/driver/nvidia/version}" 2>/dev/null | head -1)
            lib=$(grep -oP 'NVML library version: \K[0-9.]+' <<<"$out")
            state="mismatch|$nvml_lib|${mod:-?}|${lib:-?}"
        elif [[ $first =~ ^[0-9]+$ ]]; then
            state="$first|$nvml_lib"
        fi
    fi
    [[ $state == mismatch* ]] || state="${state%%|*}|$nvml_lib"
    mkdir -p "$CACHE_DIR" && printf '%s\n' "$state" > "$VRAM_CACHE"
    IFS='|' read -r vram_state cached_lib drv_mod drv_lib <<<"$state"
fi
vram_total_gb=""
if [[ $vram_state =~ ^[0-9]+$ ]] && (( vram_state > 0 )); then
    vram_total_gb=$(awk -v mb="$vram_state" 'BEGIN { printf "%.1f", mb/1024 }')
fi

# ── Loaded models from llama.cpp's router (fox-llm-run --ps: name, state, GB) ──
# The default model's footprint; the always-loaded ghost-text model alone reads as idle.
loaded_size_gb=""
loaded_proc=""
loaded_name=""
loaded_all=""
if command -v fox-llm-run &>/dev/null; then
    ps_out=$(fox-llm-run --ps 2>/dev/null)
    loaded_all=$(cut -f1 <<<"$ps_out" | paste -sd, - | sed 's/,/, /g')
    ps_line=$(awk -F'\t' -v m="$MODEL_NAME" '$1 == m || $1 == m ":latest" { print; exit }' <<<"$ps_out")
    if [[ -n "$ps_line" ]]; then
        IFS=$'\t' read -r loaded_name loaded_proc gb <<<"$ps_line"
        [[ "$gb" != "-" ]] && loaded_size_gb="$gb"
    fi
fi

# ── Compose text + class ─────────────────────────────────────────
ICON=""
CLASS="smart"
if [[ -n "$SIZE" ]]; then
    num=$(echo "$SIZE" | tr -dc '0-9')
    if [[ -n "$num" ]]; then
        if   (( num <= 8 ));  then CLASS="fast"
        elif (( num <= 20 )); then CLASS="smart"
        else                       CLASS="expert"
        fi
    fi
fi

if [[ $vram_state == mismatch ]]; then
    TEXT="$ICON ⚠ reboot"
    CLASS="warning"
elif [[ -n "$loaded_size_gb" && -n "$vram_total_gb" ]]; then
    TEXT="$ICON $DISPLAY_TAG $loaded_size_gb/${vram_total_gb}g"
elif [[ -n "$loaded_size_gb" ]]; then
    TEXT="$ICON $DISPLAY_TAG ${loaded_size_gb}g"
else
    TEXT="$ICON $DISPLAY_TAG idle"
fi

# ── Tooltip ──────────────────────────────────────────────────────
tip=""
if [[ $vram_state == mismatch ]]; then
    tip="NVIDIA was updated without a reboot (kernel module ${drv_mod}, driver library ${drv_lib}):\\n"
    tip+="GPU tools fail, and windows opened since then draw on the CPU.\\nReboot to load the new driver.\\n\\n"
fi
tip+="Model: $MODEL_NAME"
if [[ -n "$loaded_name" ]]; then
    tip+="\\nLoaded: $loaded_name"
    [[ -n "$loaded_size_gb" ]] && tip+=" (${loaded_size_gb}g RAM)"
    [[ "$loaded_proc" == loading ]] && tip+="  loading"
else
    tip+="\\nLoaded: (idle)"
fi
[[ -n "$vram_total_gb" ]] && tip+="\\nVRAM total: ${vram_total_gb}g"
[[ -n "$loaded_all" ]] && tip+="\\nIn memory: $loaded_all"

printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$TEXT" "$tip" "$CLASS"
