#!/usr/bin/env bash
# desk-bouncer — alert when USBGuard blocks a device WHILE the screen is locked.
#
# Threat model: "evil maid". You step away, someone plugs a Rubber Ducky
# or keylogger. USBGuard already blocks it — we just want a phone
# notification so you know it happened.
#
# No webcam, no force-shutdown. That stuff is dramatic and loses work.
# Detection-only alerts via desk-dispatch (falls back to notify-send).
#
# Modes:
#   foreground:  desk-bouncer run         (for systemd unit)
#   install:     desk-bouncer --install
#   uninstall:   desk-bouncer --uninstall
#   status:      desk-bouncer --status

set -u

CONF_DIR="$HOME/.config/foxml"
SERVICE_NAME="fox-bouncer.service"

C_GRN=$'\e[32m'
C_YEL=$'\e[33m'
C_RED=$'\e[31m'
C_RST=$'\e[0m'

# A "locked" probe — Hyprland-aware first, generic fallback. Returns 0
# if the screen is currently locked, 1 otherwise.
_is_locked() {
    pgrep -x hyprlock >/dev/null 2>&1 && return 0
    pgrep -x swaylock  >/dev/null 2>&1 && return 0
    pgrep -x i3lock    >/dev/null 2>&1 && return 0
    return 1
}

act_install() {
    if ! command -v journalctl >/dev/null 2>&1; then
        echo "${C_RED}journalctl required (systemd)${C_RST}" >&2
        return 1
    fi
    local unit_dir="$HOME/.config/systemd/user"
    mkdir -p "$unit_dir"
    cat > "$unit_dir/$SERVICE_NAME" <<EOF
[Unit]
Description=desk-bouncer — alert on USBGuard blocks while screen locked
After=default.target

[Service]
Type=simple
ExecStart=$(command -v desk-bouncer) run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now "$SERVICE_NAME"
    echo "${C_GRN}✓ $SERVICE_NAME enabled + started${C_RST}"
    echo "  watching: journalctl -u usbguard (system-level)"
    echo "  log:      journalctl --user -u $SERVICE_NAME -f"
}

act_uninstall() {
    systemctl --user disable --now "$SERVICE_NAME" 2>/dev/null || true
    rm -f "$HOME/.config/systemd/user/$SERVICE_NAME"
    systemctl --user daemon-reload 2>/dev/null || true
    echo "${C_GRN}✓ desk-bouncer uninstalled${C_RST}"
}

act_status() {
    if systemctl --user is-active --quiet "$SERVICE_NAME"; then
        echo "  service:  ${C_GRN}active${C_RST}"
    else
        echo "  service:  ${C_RED}inactive${C_RST}"
    fi
    echo "  log:      journalctl --user -u $SERVICE_NAME --no-pager -n 30"
}

# usbguard writes each policy decision to its journal as one audit line:
#   uid=0 pid=779 result='SUCCESS' device.system_name='/devices/…/usb3/3-12' target.new='block'
#   device.rule='block id 2109:0103 serial "" name "USB2.0 BILLBOARD" … via-port "3-12" …' target.old='block'
#   type='Policy.Device.Update'
# A device it blocks or rejects has target.new='block' or 'reject'. Only that field counts: the old match, BLOCK or
# REJECT anywhere in capitals, never met a real line, and the word can sit in a device name or a Device.Insert rule.
_blocked() {
    local re="(^|[[:space:]])target\.new='(block|reject)'([[:space:]]|$)"
    [[ "${1,,}" =~ $re ]]
}

# What usbguard did and to which device, from the line's own fields; the start of the line when they are missing.
_describe() {
    local line="$1" what="blocked" id="" name="" port=""
    local re_id="device\.rule='[a-z]+ id ([^ ]+)" re_name=' name "([^"]*)"' re_port='via-port "([^"]*)"'
    [[ "${line,,}" == *"target.new='reject'"* ]] && what="rejected"
    [[ "$line" =~ $re_id ]] && id="${BASH_REMATCH[1]}"
    [[ "$line" =~ $re_name ]] && name="${BASH_REMATCH[1]}"
    [[ "$line" =~ $re_port ]] && port="${BASH_REMATCH[1]}"
    if [[ -n "$id" ]]; then
        printf 'usbguard %s %s "%s" on port %s' "$what" "$id" "$name" "${port:-?}"
    else
        printf '%s' "${line:0:200}"
    fi
}

act_run() {
    # Stream the usbguard journal; alert on a block or reject while the screen is locked.
    local last_alert=0
    local ALERT_COOLDOWN=10

    journalctl --no-pager --since=now -u usbguard.service -f -o cat 2>/dev/null \
        | while read -r line; do
            if _blocked "$line"; then
                if _is_locked; then
                    local now
                    now=$(date +%s)
                    if (( now - last_alert < ALERT_COOLDOWN )); then
                        continue
                    fi
                    last_alert=$now

                    local msg
                    msg=$(_describe "$line")
                    echo "$(date -Iseconds) $msg" >&2
                    desk-dispatch "USB blocked (screen LOCKED)" "$msg" 2>/dev/null \
                        || notify-send -u critical -t 10000 "USB blocked (locked)" "$msg"
                fi
            fi
        done
}

case "${1:-}" in
    --install)    act_install ;;
    --uninstall)  act_uninstall ;;
    --status)     act_status ;;
    run)          act_run ;;
    -h|--help|"") cat <<EOF
desk-bouncer — USB-block alerts while screen locked

  desk-bouncer --install     enable user service
  desk-bouncer --uninstall   disable + remove
  desk-bouncer --status      show service state
  desk-bouncer run           run in foreground

Coverage:
  fires desk-dispatch "USB blocked (screen LOCKED)" when usbguard blocks
  or rejects a device (target.new='block'|'reject' in its journal)
  while hyprlock/swaylock/i3lock is up.
  Falls back to notify-send if desk-dispatch isn't configured.

  Does NOT auto-shutdown, take webcam photos, or play alarms. Detection
  + notification only. USBGuard itself is doing the actual blocking.
EOF
    ;;
    *) echo "unknown: $1" >&2; exit 2 ;;
esac
