#!/usr/bin/env bash
# Fuzzy session switcher / project launcher for tmux. Bound to prefix+w,
# replacing the stock `choose-tree`. Runs inside a `display-popup`, so it
# does NOT source .zshrc — themed colors arrive via env vars seeded into the
# tmux global environment from the (templated) .tmux.conf:
#   FOX_SESH_FZF  — fzf --color/border/pointer flags (whole-popup theming)
#   FOX_SESH_C1   — accent hex (live-session ◆ marker)
#   FOX_SESH_C2   — muted  hex (project    ◇ marker)
#
# Navigation is modal, vim-style: the list opens in nav mode (hjkl move,
# l/enter open, h/esc/q back out) and `/` drops into fuzzy-search like less.
#
# Menu order: live sessions first (one keystroke to switch), then project
# roots under ~/code & ~/school not yet open (zoxide frecency, then the rest).
set -u

SELF="$HOME/.local/bin/tmux-sessionizer"
TAB=$'\t'

sess_name() { basename "$1" | tr ' .:' '___'; }

# hex (rrggbb) -> "R;G;B"; and -> truecolor SGR (empty arg = no-color).
rgb() { printf '%d;%d;%d' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
fg()  { [ -n "${1:-}" ] && printf '\033[38;2;%sm' "$(rgb "$1")"; }

# Render a path like the zsh prompt: $HOME→~, segments in a peach/pink/mauve
# gradient with pink slashes (mirrors caramel.zsh-theme's gradient_path, using
# the same ANSI 256 indices). So the preview header matches your real prompt.
prompt_path() {
    local raw="$1" E=$'\033' R=$'\033[0m'
    [[ "$raw" == "$HOME"/* || "$raw" == "$HOME" ]] && raw="~${raw#"$HOME"}"
    local a1="${FOX_SESH_A1:-173}" a2="${FOX_SESH_A2:-180}" a3="${FOX_SESH_A3:-138}"
    local grad=("$a2" "$a1" "$a3") lead="" idx=0 p
    local -a toks=()
    if   [[ "$raw" == "~"* ]]; then toks+=("${E}[38;5;${a2}m~"); raw="${raw#\~}"; raw="${raw#/}"
    elif [[ "$raw" == /*   ]]; then lead="${E}[38;5;${a1}m/";   raw="${raw#/}"
    fi
    local IFS='/'; local -a parts=($raw)
    for p in "${parts[@]}"; do
        [[ -z "$p" ]] && continue
        toks+=("${E}[38;5;${grad[idx % 3]}m${p}"); ((idx++))
    done
    local sep="${E}[38;5;${a1}m/" joined="" t
    for t in "${toks[@]}"; do [[ -n "$joined" ]] && joined+="$sep"; joined+="$t"; done
    printf '%s%s%s' "$lead" "$joined" "$R"
}

# Resolve a pane's *real* app, not the runtime: gemini, not node. Strict — only
# upgrades the label when confident. For interpreter runtimes we read the
# foreground process's args and take the script basename, but reject internal
# entrypoints (node_modules, /usr/lib, /usr/share, *.js/.mjs/.cjs/.ts) and fall
# back to the bare runtime name. Non-interpreters (claude, nvim, zsh) and the
# common case cost no extra process — they pass straight through.
pane_app() {
    local cmd="$1" tty="${2#/dev/}"
    case "$cmd" in
        node|nodejs|python|python2|python3|ruby|perl) ;;
        *) printf '%s' "$cmd"; return ;;
    esac
    [ -n "$tty" ] && [ "$tty" != - ] || { printf '%s' "$cmd"; return; }
    local pgid; pgid="$(ps -t "$tty" -o tpgid= 2>/dev/null | awk 'NF{print $1; exit}')"
    [ -n "$pgid" ] && [ "$pgid" -gt 0 ] 2>/dev/null || { printf '%s' "$cmd"; return; }
    local args; args="$(ps -p "$pgid" -o args= 2>/dev/null)"
    [ -n "$args" ] || { printf '%s' "$cmd"; return; }
    local -a toks; read -ra toks <<< "$args"
    local i script=''
    for ((i=1; i<${#toks[@]}; i++)); do            # skip argv0 (the interpreter)
        case "${toks[i]}" in -*) continue ;; esac
        script="${toks[i]}"; break
    done
    [ -n "$script" ] || { printf '%s' "$cmd"; return; }
    case "$script" in */node_modules/*|/usr/lib/*|/usr/share/*) printf '%s' "$cmd"; return ;; esac
    local base="${script##*/}"
    case "$base" in *.js|*.mjs|*.cjs|*.ts) printf '%s' "$cmd"; return ;; esac
    printf '%s' "$base"
}

list_all() {
    local A M R D
    A="$(fg "${FOX_SESH_C1:-}")"      # accent  (live sessions, active pane)
    M="$(fg "${FOX_SESH_C2:-}")"      # muted   (projects, tree branches)
    R=$'\033[0m'; D=$'\033[2m'

    local cur; cur="$(tmux display-message -p '#S' 2>/dev/null)"
    local live; live="$(tmux list-sessions -F '#{session_name}' 2>/dev/null)"

    # Live sessions as a tree (choose-tree, nicer UI). ● = current session /
    # active pane, ◆ = other. Single-pane sessions collapse to one row with the
    # app inline ("0 · claude"); multi-pane sessions list each pane below as a
    # ├/└ branch you can switch to or ^x-kill on its own. kind=s → session
    # (target=name), kind=p → pane (target=pane_id).
    local s='' m='' panes='' npanes='' wp='' pid='' tty='' pa='' cmd='' app='' idx=0 br='' dot=''
    printf '%s\n' "$live" | while IFS= read -r s; do
        [ -n "$s" ] || continue
        m='◆'; [ "$s" = "$cur" ] && m='●'
        panes="$(tmux list-panes -s -t "$s" \
            -F "#{window_index}.#{pane_index}${TAB}#{pane_id}${TAB}#{pane_tty}${TAB}#{pane_active}${TAB}#{pane_current_command}" 2>/dev/null)"
        npanes="$(printf '%s\n' "$panes" | grep -c .)"
        if [ "${npanes:-0}" -le 1 ]; then
            IFS="$TAB" read -r wp pid tty pa cmd <<< "$panes"
            app="$(pane_app "$cmd" "$tty")"
            printf 's\t%s%s%s %s %s· %s%s\t%s\n' "$A" "$m" "$R" "$s" "$D" "$app" "$R" "$s"
        else
            printf 's\t%s%s%s %s %s· %sp%s\t%s\n' "$A" "$m" "$R" "$s" "$D" "$npanes" "$R" "$s"
            idx=0
            printf '%s\n' "$panes" | while IFS="$TAB" read -r wp pid tty pa cmd; do
                [ -n "$wp" ] || continue
                idx=$((idx+1)); br='├'; [ "$idx" -eq "$npanes" ] && br='└'
                app="$(pane_app "$cmd" "$tty")"; dot=''
                [ "$pa" = 1 ] && dot="$(printf ' %s●%s' "$A" "$R")"
                printf 'p\t   %s%s%s %s%s%s  %s%s\t%s\n' "$M" "$br" "$R" "$D" "$wp" "$R" "$app" "$dot" "$pid"
            done
        fi
    done

    # Project roots not already open: kind=d, "◇ name", target=path.
    {
        zoxide query -l 2>/dev/null | grep -E "^$HOME/(code|school)/[^/]+/?$"
        ls -d ~/code/*/ ~/school/*/ 2>/dev/null
    } | sed 's:/\+$::' | awk 'NF && !seen[$0]++' | while IFS= read -r dir; do
        [ -d "$dir" ] || continue
        local name; name="$(sess_name "$dir")"
        printf '%s\n' "$live" | grep -qxF "$name" && continue
        printf 'd\t%s◇%s %s\t%s\n' "$M" "$R" "$name" "$dir"
    done
}

# visible (column) width of a label that may carry the ● active marker —
# locale-safe: ● collapses to one char whether the shell is UTF-8 or C.
vis_len() { local s="${1//●/X}"; printf '%s' "${#s}"; }
hrule()   { local n="$1" s=''; while [ "$n" -gt 0 ]; do s+='─'; n=$((n-1)); done; printf '%s' "$s"; }
pad_to()  { local s="$1" w="$2" vl; vl="$(vis_len "$s")"; printf '%s%*s' "$s" "$(( w - vl > 0 ? w - vl : 0 ))" ''; }

# ASCII diagram of ONE window's pane arrangement, drawn above the stacked
# captures so you can see *where* each pane sits, not just what's in it.
# Proportional boxes for a single row or single column of panes; a one-line
# list for nested layouts (2x2, L-shapes — no honest box exists) or when the
# labels won't fit. Sized to the preview's real width (FZF_PREVIEW_COLUMNS).
pane_map() {
    local tw="$1" win="${1##*:}"
    local C; C="$(printf '\033[38;5;%sm' "${FOX_SESH_A3:-138}")"
    local D=$'\033[2m' R=$'\033[0m'
    local cols="${FZF_PREVIEW_COLUMNS:-${COLUMNS:-72}}"
    [ "$cols" -ge 8 ] 2>/dev/null || cols=72

    local -a T=() L=() W=() LBL=()
    local pi pl pt pw pa ptty pc m app
    while IFS="$TAB" read -r pi pl pt pw pa ptty pc; do
        [ -n "$pi" ] || continue
        m=''; [ "$pa" = 1 ] && m=' ●'
        app="$(pane_app "$pc" "$ptty")"
        T+=("$pt"); L+=("$pl"); W+=("$pw")
        LBL+=("$(printf '%s.%s %s%s' "$win" "$pi" "$app" "$m")")
    done < <(tmux list-panes -t "$tw" \
        -F "#{pane_index}${TAB}#{pane_left}${TAB}#{pane_top}${TAB}#{pane_width}${TAB}#{pane_active}${TAB}#{pane_tty}${TAB}#{pane_current_command}" 2>/dev/null)

    local n="${#LBL[@]}" i
    [ "$n" -ge 2 ] || return 0          # 0/1 pane: the per-pane header says it all

    local same_top=1 same_left=1
    for ((i=1; i<n; i++)); do
        [ "${T[i]}" = "${T[0]}" ] || same_top=0
        [ "${L[i]}" = "${L[0]}" ] || same_left=0
    done

    # single row → proportional side-by-side boxes
    if [ "$same_top" = 1 ]; then
        local inner=$(( cols - (n + 1) )) sumw=0 c acc=0
        for ((i=0; i<n; i++)); do sumw=$(( sumw + ${W[i]} )); done
        [ "$sumw" -gt 0 ] || sumw=1
        local -a cell=()
        for ((i=0; i<n; i++)); do c=$(( ${W[i]} * inner / sumw )); cell+=("$c"); acc=$(( acc + c )); done
        cell[$((n-1))]=$(( ${cell[$((n-1))]} + inner - acc ))
        local fits=1
        for ((i=0; i<n; i++)); do [ "${cell[i]}" -ge "$(( $(vis_len "${LBL[i]}") + 2 ))" ] || fits=0; done
        if [ "$fits" = 1 ]; then
            local top="$C┌" mid="$C│" bot="$C└"
            for ((i=0; i<n; i++)); do
                top+="$(hrule "${cell[i]}")"; mid+=" $(pad_to "${LBL[i]}" "$(( ${cell[i]} - 1 ))")│"; bot+="$(hrule "${cell[i]}")"
                if [ "$i" -lt "$((n-1))" ]; then top+='┬'; bot+='┴'; else top+='┐'; bot+='┘'; fi
            done
            printf '%s\n%s\n%s%s\n' "$top" "$mid" "$bot" "$R"
            return 0
        fi
    # single column → stacked boxes
    elif [ "$same_left" = 1 ]; then
        local w=$(( cols - 2 )) fits=1
        for ((i=0; i<n; i++)); do [ "$w" -ge "$(( $(vis_len "${LBL[i]}") + 1 ))" ] || fits=0; done
        if [ "$fits" = 1 ]; then
            printf '%s┌%s┐\n' "$C" "$(hrule "$w")"
            for ((i=0; i<n; i++)); do
                printf '%s│%s│\n' "$C" "$(pad_to " ${LBL[i]}" "$w")"
                [ "$i" -lt "$((n-1))" ] && printf '%s├%s┤\n' "$C" "$(hrule "$w")"
            done
            printf '%s└%s┘%s\n' "$C" "$(hrule "$w")" "$R"
            return 0
        fi
    fi

    # nested layout, or labels too wide for boxes → one-line list
    local line="${D}${n} panes${R}  "
    for ((i=0; i<n; i++)); do
        [ "$i" -gt 0 ] && line+="${D} │ ${R}"
        line+="${C}${LBL[i]}${R}"
    done
    printf '%s\n' "$line"
}

do_preview() {
    local line="$1" kind tgt
    kind="${line%%$TAB*}"; tgt="${line##*$TAB}"
    if [ "$kind" = p ]; then
        # A single pane row: just that pane's capture, with a context header.
        local pcmd ptty psess pwin papp
        pcmd="$(tmux display-message -p -t "$tgt" '#{pane_current_command}' 2>/dev/null)"
        ptty="$(tmux display-message -p -t "$tgt" '#{pane_tty}' 2>/dev/null)"
        psess="$(tmux display-message -p -t "$tgt" '#{session_name}' 2>/dev/null)"
        pwin="$(tmux display-message -p -t "$tgt" '#{window_index}' 2>/dev/null)"
        papp="$(pane_app "$pcmd" "$ptty")"
        printf '\033[38;5;%sm── %s · %s · win %s ──\033[0m\n' "${FOX_SESH_A3:-138}" "$papp" "$psess" "$pwin"
        tmux capture-pane -ep -t "$tgt" 2>/dev/null
        return
    fi
    if [ "$kind" = s ]; then
        # Per window: a layout map (where the panes sit) then each pane's
        # capture stacked below (what's in them). capture-pane with a bare
        # session name only ever shows one pane, so split panes / background
        # work (gemini, builds, ...) were invisible before.
        local first=1 win wp pid ptty pa cmd app mk
        while IFS= read -r win; do
            [ -n "$win" ] || continue
            [ -n "$first" ] || printf '\n'
            first=
            pane_map "${tgt}:${win}"
            tmux list-panes -t "${tgt}:${win}" \
                -F "#{window_index}.#{pane_index}${TAB}#{pane_id}${TAB}#{pane_tty}${TAB}#{pane_active}${TAB}#{pane_current_command}" \
                2>/dev/null | while IFS="$TAB" read -r wp pid ptty pa cmd; do
                app="$(pane_app "$cmd" "$ptty")"; mk=''; [ "$pa" = 1 ] && mk=' ●'
                printf '\033[38;5;%sm── %s · %s%s ──\033[0m\n' "${FOX_SESH_A3:-138}" "$wp" "$app" "$mk"
                tmux capture-pane -ep -t "$pid" 2>/dev/null
            done
        done < <(tmux list-windows -t "$tgt" -F "#{window_index}" 2>/dev/null)
        return
    fi
    # Prompt-styled header (no eza cyan abs-path) + git branch like the footer,
    # then a flat themed listing — reads like you cd'd in and ran ls. eza is
    # recoloured warm (di→peach, ln/ex→mauve), scoped here only.
    prompt_path "$tgt"
    if git -C "$tgt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local br dot=''
        br="$(git -C "$tgt" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
            || br="$(git -C "$tgt" rev-parse --short HEAD 2>/dev/null)"
        git -C "$tgt" status --porcelain 2>/dev/null | grep -q . && dot=' ●'
        [ -n "$br" ] && printf '  \033[38;5;%sm⎇ %s%s\033[0m' "${FOX_SESH_A3:-138}" "$br" "$dot"
    fi
    printf '\n\n'
    local di lk
    di="$(rgb "${FOX_SESH_C1:-d4985a}")"
    lk="$(rgb "${FOX_SESH_C3:-c49aab}")"
    EZA_COLORS="di=38;2;${di}:ln=38;2;${lk}:ex=38;2;${lk}:or=38;2;$(rgb "${FOX_SESH_C2:-8c8070}")" \
        eza -1 --icons=always --color=always --group-directories-first "$tgt" 2>/dev/null \
        || ls -1 --color=always "$tgt" 2>/dev/null || ls -1 "$tgt"
}

do_kill() {
    local line="$1" kind tgt cur me
    kind="${line%%$TAB*}"; tgt="${line##*$TAB}"
    if [ "$kind" = s ]; then
        cur="$(tmux display-message -p '#S' 2>/dev/null)"
        [ "$tgt" = "$cur" ] && return 0          # never kill the session we're popped over
        tmux kill-session -t "$tgt" 2>/dev/null
    elif [ "$kind" = p ]; then
        cur="$(tmux display-message -p '#S' 2>/dev/null)"
        me="$(tmux display-message -p -t "$cur" '#{pane_id}' 2>/dev/null)"
        [ "$tgt" = "$me" ] && return 0           # never kill the pane we're popped over
        tmux kill-pane -t "$tgt" 2>/dev/null
    fi
    return 0
}

do_rename() {
    local line="$1" kind tgt new
    kind="${line%%$TAB*}"; tgt="${line##*$TAB}"
    [ "$kind" = s ] || return 0
    printf '\n  rename "%s" → ' "$tgt" > /dev/tty
    IFS= read -r new < /dev/tty
    [ -n "$new" ] && tmux rename-session -t "$tgt" "$new" 2>/dev/null
}

connect() {
    local line="$1" kind tgt name sess win
    kind="${line%%$TAB*}"; tgt="${line##*$TAB}"
    if [ "$kind" = s ]; then
        tmux switch-client -t "$tgt"
    elif [ "$kind" = p ]; then
        sess="$(tmux display-message -p -t "$tgt" '#{session_name}' 2>/dev/null)"
        win="$(tmux display-message -p -t "$tgt" '#{window_index}' 2>/dev/null)"
        [ -n "$sess" ] && tmux switch-client -t "$sess"
        [ -n "$win" ] && tmux select-window -t "$sess:$win" 2>/dev/null
        tmux select-pane -t "$tgt" 2>/dev/null
    else
        name="$(sess_name "$tgt")"
        tmux has-session -t "=$name" 2>/dev/null \
            || tmux new-session -d -s "$name" -c "$tgt"
        tmux switch-client -t "$name"
    fi
}

case "${1:-}" in
    --list)    list_all;            exit 0 ;;
    --preview) do_preview "${2:-}"; exit 0 ;;
    --kill)    do_kill    "${2:-}"; exit 0 ;;
    --rename)  do_rename  "${2:-}"; exit 0 ;;
esac

# Keys that navigate in nav mode; unbound on `/` (so they type) and rebound on esc.
NAV='j,k,g,G,h,l,q'

sel="$(list_all | fzf \
    --ansi --no-sort --cycle --disabled \
    --layout=reverse --info=inline-right \
    --delimiter="$TAB" --with-nth=2 --nth=2 \
    --border=rounded --border-label=' sessions ' --border-label-pos=3 \
    --prompt='  ' --pointer='▸' \
    --preview="$SELF --preview {}" \
    --preview-window='right,55%,wrap,border-left' --preview-label=' preview ' \
    --header='j/k move · / search · l open · ^r rename · ^x kill · q quit' \
    --bind='start,resize:transform:[ $((FZF_LINES*2)) -gt $FZF_COLUMNS ] && echo "change-preview-window(down,55%,wrap,border-top)" || echo "change-preview-window(right,55%,wrap,border-left)"' \
    --bind='j:down,k:up,g:first,G:last,l:accept,h:abort,q:abort' \
    --bind="/:unbind($NAV)+change-prompt(search ❯ )+enable-search" \
    --bind="esc:rebind($NAV)+change-prompt(  )+disable-search+clear-query" \
    --bind='ctrl-/:toggle-preview' \
    --bind='ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up' \
    --bind="ctrl-x:execute-silent($SELF --kill {})+reload($SELF --list)" \
    --bind="ctrl-r:execute($SELF --rename {})+reload($SELF --list)" \
    ${FOX_SESH_FZF:-})" || exit 0

[ -n "$sel" ] && connect "$sel"
