#!/usr/bin/env bash
# desk-sandbox — launch a disposable, sandboxed program.
#
# Wraps the chosen target in firejail with --private so it gets a
# fresh tmpfs $HOME that's wiped when the process exits. Anything the
# program reads / writes lives in that tmpfs and disappears on close.
# Network access stays intact (mostly the point — you can still hit
# the random site you needed to visit).
#
# Picker mode (no args): Quickshell menu with the common sandbox targets.
# Direct mode: desk-sandbox <command> [args...] runs that command
# directly under firejail --private. Pair with the $mod+SHIFT+Return
# keybind that opens this in Quickshell.
#
# Requires firejail. Falls back to bwrap (bubblewrap) if firejail is
# absent. Refuses to run unsandboxed — a leaky sandbox is worse than
# no sandbox because it gives false confidence.

set -u

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    sed -n '2,17p' "$0" | sed 's/^# \?//'
    exit 0
fi

# Discover sandbox tool. firejail first (better defaults, includes
# bundled pQuickshellles for firefox / discord). bwrap as fallback.
# Use an ARRAY so word-splitting doesn't drop or merge args — passing
# unquoted $SANDBOX through setsid only worked by accident with simple
# flags; pQuickshellle names with spaces would have broken the sandbox.
SANDBOX=()
if command -v firejail >/dev/null 2>&1; then
    SANDBOX=(firejail --private --quiet)
elif command -v bwrap >/dev/null 2>&1; then
    SANDBOX=(bwrap --dev-bind / / --tmpfs /home --tmpfs /tmp --setenv HOME /home/sandbox)
else
    notify-send -u critical "desk-sandbox" "Neither firejail nor bwrap installed. \`sudo pacman -S firejail\`."
    exit 1
fi

# Direct mode — caller passed a command on the CLI.
if (( $# > 0 )); then
    notify-send -t 2000 "desk-sandbox" "Launching: $*"
    setsid -f "${SANDBOX[@]}" "$@" >/dev/null 2>&1 < /dev/null
    exit 0
fi

choices=(
    "Firefox (private session)"
    "Chromium (private session)"
    "Kitty (disposable terminal)"
    "Yazi (file browser, tmpfs home)"
    "Pager (disposable terminal)"
)
sel=$(printf '%s\n' "${choices[@]}" | desk-picker --title "A fresh little sandbox" --index) || exit 0
case "$sel" in
    0) cmd_argv=(firefox) ;;
    1) cmd_argv=(chromium --incognito) ;;
    2) cmd_argv=(kitty) ;;
    3) cmd_argv=(kitty -e yazi) ;;
    4) cmd_argv=(kitty -e less) ;;
    *) exit 1 ;;
esac
notify-send -t 2000 "desk-sandbox" "${choices[$sel]}"
setsid -f "${SANDBOX[@]}" "${cmd_argv[@]}" >/dev/null 2>&1 < /dev/null
