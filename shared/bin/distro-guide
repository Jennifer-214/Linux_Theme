#!/bin/bash
# distro-guide — Instructions for the Linux_Theme Distro experience

echo "Linux_Theme — High-Discipline Workstation"
echo "----------------------------------------"
echo "You can now deploy Linux_Theme as a complete OS experience in two ways:"
echo ""
echo "1. The archinstall Profile (Recommended)"
echo "   Boot a standard Arch Linux ISO and run:"
echo "   archinstall --config https://raw.githubusercontent.com/Jennifer-214/Linux_Theme/main/shared/foxml-profile.json"
echo ""
echo "   This will automatically:"
echo "   - Install linux-zen kernel (optimized for desktop responsiveness)"
echo "   - Configure systemd-boot, pipewire, and NetworkManager"
echo "   - Install NVIDIA drivers (if needed) and base-devel"
echo "   - Trigger the Linux_Theme one-command bootstrap at first boot"
echo ""
echo "2. Build a Custom Linux_Theme ISO"
echo "   If you want a 'live' environment with Linux_Theme baked in:"
echo "   - Install 'archiso': sudo pacman -S archiso"
echo "   - Run the build script:"
echo "     cd \${FOXML_WORKSTATION_DIR:-\$HOME/code/Linux_Theme}/distro && ./build.sh"
echo ""
echo "   This will produce a bootable .iso in distro/out/ that has"
echo "   the 'desk-install' command built-in."
echo ""
echo "3. Flash the ISO to USB"
echo "   Once the build is complete, run the flasher:"
echo "   ai-distro-flash"
echo ""
echo "Your entire workstation is now defined as a portable OS manifest."
