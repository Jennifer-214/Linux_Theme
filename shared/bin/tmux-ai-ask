#!/usr/bin/env bash
# AI-ask popup body for tmux (prefix+a). Prompts for a natural-language
# question, answers it with the local model via fox-ai-oracle (streamed),
# then waits for a key so you can read it before the popup closes.
# Themed with the same FOX_SESH_A* ANSI indices seeded by .tmux.conf.
set -u

a1="${FOX_SESH_A1:-173}" a2="${FOX_SESH_A2:-180}"
P() { printf '\033[38;5;%sm' "$1"; }   # set fg
R=$'\033[0m'; D=$'\033[2m'

if ! command -v fox-ai-oracle >/dev/null 2>&1; then
    printf '%sfox-ai-oracle not found%s — build it with `make -C src/fox-ai-oracle`\n' "$(P "$a1")" "$R"
    read -rsn1 _; exit 1
fi

printf '%s  ask your stack%s  %s(enter to ask · empty to cancel)%s\n\n' "$(P "$a2")" "$R" "$D" "$R"
printf '%s❯ %s' "$(P "$a1")" "$R"
IFS= read -r q || exit 0
[ -z "${q// /}" ] && exit 0

printf '\n'
fox-ai-oracle "$q"
printf '\n\n%s── press any key to close ──%s' "$D" "$R"
read -rsn1 _
