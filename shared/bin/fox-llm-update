#!/usr/bin/env bash
# fox-llm-update — keep the local-LLM stack (ollama, pi, opencode, models) current.
#
#   fox-llm-update            full run: tools (sudo) + ollama context (sudo) + models + sync
#   fox-llm-update --auto     what the daily timer runs: --check, --models, and --discover when
#                             the last scan is over a week old. Downloads wait for a fast link.
#   fox-llm-update --models   pull missing wanted models, refresh every registry model (no sudo)
#   fox-llm-update --check    report tool updates, desktop-notify if any (no sudo)
#   fox-llm-update --discover find new tool-capable models that fit this box (fox-llm-discover),
#                             auto-pull up to MAX_AUTO_PULLS new MoE ones + abliterated twins
#   fox-llm-update --list     show the last discovery report
#   fox-llm-update --wanted   print the models this machine should have (tiered list + extras)
#   fox-llm-update --sync     wire installed models into opencode + pi; fill missing defaults;
#                             have the llama.cpp router (the default server) reload its model list
#   fox-llm-update --queue    slow link: download wanted models in the background, resuming
#                             across reboots (user service fox-llm-pull), then stop
#
# Wanted models, in download order: ~/.config/foxml/llm/extra-models.txt (this machine; a "-model"
# line skips a model everywhere), then your personal lists — the ones fox-install's models step reads:
# ~/.config/foxml/models.private, ~/code/*/foxml-models.txt, ~/code/custom_models/*.txt — then the RAM
# tier of shared/llm/core-models.txt. fox-install queues them all here instead of pulling them itself. Binaries are never auto-upgraded: the timer only notifies.
# Hugging Face GGUFs — llama.cpp's own format, for models whose Ollama copy llama.cpp can't load
# (a fox-llm-serve load check says so): "name user/repo/file.gguf" lines in
# ~/.config/foxml/llm/gguf-models.txt or, to survive a reinstall, ~/code/custom_models/gguf-models.conf
# (not .txt: fox-install's models module reads those as Ollama lists). Downloaded before the Ollama
# models, resumably, size + sha256 checked against Hugging Face's own record, into
# ~/.local/share/fox-llm/gguf/<name>.gguf, where fox-llm-serve serves them under that name.
# --sync fills in what is missing and never changes keys you set in opencode.json / ~/.pi/agent/*.json,
# with two exceptions: a local model default follows llama.cpp while its router is enabled, and the
# local providers' model lists mirror what each server runs — every model once, under the server that
# serves it (your settings on an entry are kept while the model is there).
set -uo pipefail

LLM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/foxml/llm"
CORE_LIST="$LLM_DIR/core-models.txt"      # deployed from Linux_Theme shared/llm/
EXTRA_LIST="$LLM_DIR/extra-models.txt"    # personal; never in the repo
GGUF_LIST="$LLM_DIR/gguf-models.txt"      # personal Hugging Face GGUFs; never in the repo
GGUF_PRIVATE="$HOME/code/custom_models/gguf-models.conf"   # the same, where a reinstall finds it
GGUF_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fox-llm/gguf"
DROPIN=/etc/systemd/system/ollama.service.d/foxml-context.conf
UNIT=/etc/systemd/system/ollama.service
WORK="${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-update"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/fox-llm-update"
MODELS_DIR=/usr/share/ollama/.ollama/models
MAX_AUTO_PULLS=2     # new base models per discovery run (abliterated twins ride along)
MIN_FREE_GB=100      # never auto-pull below this much free disk
MIN_MBPS=2           # timer skips pulls on slow links (guest / hotspot Wi-Fi): 20 GB at 2 MB/s ≈ 3 h
QUEUE_TRIES=30       # --queue: per-model retries, a minute apart, before moving on
OPENCODE_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
PI_DIR="$HOME/.pi/agent"
AGENT_DEFAULT=qwen3-coder:30b   # promoted to default once installed
TITLE_MODEL=qwen2.5:3b          # opencode small_model: fits a 4 GB GPU whole
# fox-llm-serve deploys beside this script; a timer's PATH need not include ~/.local/bin.
SERVE_BIN="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fox-llm-serve"

log()  { printf '\033[1;33m[fox-llm]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m[fox-llm]\033[0m %s\n' "$*" >&2; }

ver_ollama()        { ollama -v 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | tail -1; }
# The running server's version — differs from the client's mid-update.
ver_ollama_server() { curl -fs --max-time 5 localhost:11434/api/version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+'; }
latest_ollama()     { curl -fsS https://api.github.com/repos/ollama/ollama/releases/latest \
                        | python3 -I -c 'import json,sys;print(json.load(sys.stdin)["tag_name"].lstrip("v"))'; }
ver_pi()            { pi --version 2>&1 | grep -oE "[0-9]+\.[0-9]+\.[0-9]+" | head -1; }
# pi moved to @earendil-works at 1.0; @mariozechner/pi-coding-agent stops at 0.73.1 (deprecated, 2026-10-14)
PI_PKG=@earendil-works/pi-coding-agent PI_PKG_OLD=@mariozechner/pi-coding-agent
latest_pi()         { npm view "$PI_PKG" version 2>/dev/null; }
ram_gb()            { awk '/^MemTotal:/{printf "%d", ($2 + 1048575) / 1048576}' "${FOX_LLM_MEMINFO:-/proc/meminfo}"; }

# Same tiers as fox-install's models module.
ram_tier() {
  local ram; ram=$(ram_gb)
  if (( ram >= 32 )); then echo large; elif (( ram >= 16 )); then echo medium; else echo small; fi
}

# "-model" lines in extra-models.txt: models this machine should not pull, from any list.
skipped_models() {
  [[ -f $EXTRA_LIST ]] && awk '/^[[:space:]]*-/ { sub(/^[[:space:]]*-/, ""); printf "%s ", tolower($1) }' "$EXTRA_LIST"
}

# Your personal model lists — the ones fox-install's models step reads (a local override file, any
# private repo's foxml-models.txt, the custom_models repo's lists), each once.
personal_lists() {
  local f
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}/foxml/models.private" "$HOME"/code/*/foxml-models.txt \
           "$HOME"/code/custom_models/*.txt; do
    if [[ -f $f ]]; then echo "$f"; fi
  done | awk '!seen[$0]++'
}

# This machine's extras first (deliberate picks, in priority order), then your personal lists, then
# the RAM-tiered core list; "-model" lines drop a model from all of them. Lowercase, as Ollama wants.
wanted_models() {
  local tier f; tier=$(ram_tier)
  {
    if [[ -f $EXTRA_LIST ]]; then
      awk '!/^[[:space:]]*(#|$)/ { print $1 }' "$EXTRA_LIST"
    fi
    while read -r f; do
      awk '!/^[[:space:]]*(#|$)/ { print $1 }' "$f"
    done < <(personal_lists)
    if [[ -f $CORE_LIST ]]; then
      awk -v t="$tier" '
        /^# tier:/ { b = $3; next }
        /^[[:space:]]*(#|$)/ { next }
        b == t || b == "all" { print $1 }' "$CORE_LIST"
    fi
  } | awk -v skip="$(skipped_models)" '
      BEGIN { n = split(skip, s, " "); for (i = 1; i <= n; i++) drop[s[i]] = 1 }
      /^-/ { next }
      { $0 = tolower($0) }
      !($0 in drop) && !seen[$0]++'
}

# "name user/repo/file.gguf" rows of the GGUF lists — this machine's first, a name once.
gguf_wanted() {
  local f
  for f in "$GGUF_LIST" "$GGUF_PRIVATE"; do
    if [[ -f $f ]]; then awk '!/^[[:space:]]*(#|$)/ && NF >= 2 { print $1, $2 }' "$f"; fi
  done | awk '!seen[$1]++'
}

# One Hugging Face GGUF into GGUF_DIR/<name>.gguf: resumes a partial file, gives up on a stalled link
# (the queue retries a minute later, resuming again), and checks size and sha256 against Hugging Face's
# own record before the file goes live. Exit 0 only when it is in place.
fetch_gguf() {
  local name=$1 src=$2 repo file dir meta size sha part dst have avail
  if [[ $name == */* || $src != */*/* ]]; then echo "bad GGUF line: $name $src"; return 1; fi
  repo=$(cut -d/ -f1-2 <<<"$src"); file=${src#"$repo/"}
  dst="$GGUF_DIR/$name.gguf"; part="$dst.part"
  [[ -f $dst ]] && return 0
  dir=$(dirname "$file"); [[ $dir == . ]] && dir=""
  meta=$(curl -fsS -m 60 "https://huggingface.co/api/models/$repo/tree/main${dir:+/$dir}" | python3 -I -c '
import json, sys
f = next((f for f in json.load(sys.stdin) if f.get("path") == sys.argv[1]), {})
print(f.get("size", ""), (f.get("lfs") or {}).get("oid", ""))' "$file" 2>/dev/null)
  read -r size sha <<<"$meta"
  [[ -n $size && -n $sha ]] || { echo "no size + sha256 on Hugging Face for $src"; return 1; }
  mkdir -p "$GGUF_DIR"
  have=$(stat -c %s "$part" 2>/dev/null || echo 0)
  if (( have > size )); then rm -f "$part"; have=0; fi
  avail=$(df -B1 --output=avail "$GGUF_DIR" | tail -1)
  (( avail > size - have + 10 * 1024 ** 3 )) || { echo "not enough disk for $name ($(( size / 1024 ** 3 )) GiB)"; return 1; }
  if (( have < size )); then
    local show=(-sS); [[ -t 2 ]] && show=(-#)
    curl -fL "${show[@]}" --retry 5 --retry-delay 30 --speed-limit 1024 --speed-time 300 -C - -o "$part" \
      "https://huggingface.co/$repo/resolve/main/$file" \
      || { echo "interrupted at $(( $(stat -c %s "$part" 2>/dev/null || echo 0) / 1024 ** 2 )) of $(( size / 1024 ** 2 )) MiB"; return 1; }
  fi
  [[ $(stat -c %s "$part") == "$size" ]] || { echo "size mismatch for $name"; return 1; }
  if [[ $(sha256sum "$part" | cut -d' ' -f1) != "$sha" ]]; then
    rm -f "$part"; echo "sha256 mismatch for $name — discarded, it downloads again"; return 1
  fi
  mv "$part" "$dst" && echo "$name: verified, $(( size / 1024 ** 3 )) GiB"
}

# On the registry? Custom `ollama create` models are not, and are skipped.
on_registry() {
  local name=${1%%:*} tag=latest
  [[ $1 == *:* ]] && tag=${1##*:}
  [[ $name == */* ]] || name="library/$name"
  [[ $(curl -s -o /dev/null -w '%{http_code}' \
        -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
        "https://registry.ollama.ai/v2/$name/manifests/$tag") == 200 ]]
}

# Download speed from the Ollama registry in MB/s (12 s sample of a real model blob).
link_mbps() {
  local digest
  digest=$(curl -fs --max-time 10 -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
             https://registry.ollama.ai/v2/library/gpt-oss/manifests/20b \
           | python3 -I -c 'import json,sys;print(next(l["digest"] for l in json.load(sys.stdin)["layers"] if l["mediaType"].endswith(".model")))') || { echo 0; return; }
  curl -sL -o /dev/null --max-time 12 -w '%{speed_download}' \
    "https://registry.ollama.ai/v2/library/gpt-oss/blobs/$digest" | awk '{printf "%d", $1/1e6}'
}

fast_link() {
  local mbps; mbps=$(link_mbps)
  if (( mbps < MIN_MBPS )); then
    warn "registry link is ~${mbps} MB/s (< ${MIN_MBPS}) — skipping downloads; rerun on a faster network"
    warn "or download in the background anyway: fox-llm-update --queue"
    return 1
  fi
}

ollama_up() { ollama list >/dev/null 2>&1; }

# hf.co refs by huggingface.co: Ollama checks the auth realm against that host (the manifest server
# redirects there), so the short form fails.
hf_form() { if [[ $1 == hf.co/* ]]; then echo "huggingface.co/${1#hf.co/}"; else echo "$1"; fi; }

pull_once() {
  ollama pull "$1" 2>&1 | tr '\r' '\n' | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' \
    | grep -vE '^pulling [0-9a-f]+: +[0-9]+%' | grep -v '^[[:space:]]*$' | tail -3
}

# Prints the last status lines; exit 0 only when the pull reported success. Normalised as fox-install's
# models step always did: lowercase names, hf.co → huggingface.co, and a namespaced ref the Ollama
# registry doesn't have (user/repo:tag, no host) tried as a Hugging Face repo.
pull_quiet() {
  local ref out
  ref=$(hf_form "${1,,}")
  out=$(pull_once "$ref")
  if ! grep -q '^success' <<<"$out" && [[ $ref == */* && $ref != *.*/* ]] \
     && grep -qiE 'not found|does not exist' <<<"$out"; then
    out=$(pull_once "huggingface.co/$ref")
  fi
  printf '%s\n' "$out"
  grep -q '^success' <<<"$out"
}

# Is a wanted ref among the installed ones ($2, `ollama list` names)? A bare name is name:latest, and
# pull_quiet may have fetched a namespaced ref as its Hugging Face form.
installed_as() {
  local ref; ref=$(hf_form "${1,,}")
  [[ $ref == *:* ]] || ref+=":latest"
  grep -qxF -e "$ref" -e "huggingface.co/$ref" <<<"$2"
}

free_gb() { df -BG --output=avail "${MODELS_DIR%/.ollama/models}" 2>/dev/null | tail -1 | tr -dc 0-9; }

do_check() {
  local msgs=() cur new
  cur=$(ver_ollama); new=$(latest_ollama || true)
  [[ -n $new && $cur != "$new" ]] && msgs+=("ollama $cur → $new")
  cur=$(ver_pi); new=$(latest_pi || true)
  [[ -n $new && $cur != "$new" ]] && msgs+=("pi $cur → $new")
  if command -v checkupdates >/dev/null; then
    new=$(checkupdates 2>/dev/null | awk '$1=="opencode"{print $2" → "$4}')
    [[ -n $new ]] && msgs+=("opencode $new (pacman -Syu)")
  fi
  if ((${#msgs[@]})); then
    log "updates available: ${msgs[*]}"
    command -v notify-send >/dev/null && \
      notify-send -a fox-llm "🦊 LLM tool updates" "$(printf '%s\n' "${msgs[@]}")
Run: fox-llm-update"
  else
    log "ollama, pi, opencode are current"
  fi
}

# $1 = "check-link" for the timer path; the interactive full run pulls regardless.
do_models() {
  [[ ${1:-} == check-link ]] && { fast_link || return 0; }
  local m have name src
  while read -r name src; do                  # Hugging Face GGUFs first: each one listed on purpose
    [[ -f $GGUF_DIR/$name.gguf ]] && continue
    log "downloading $name from Hugging Face"
    fetch_gguf "$name" "$src" || warn "$name not downloaded — the background queue retries: fox-llm-update --queue"
  done < <(gguf_wanted)
  ollama_up || { warn "ollama is not running — skipping model refresh"; return 1; }
  have=$(ollama list | awk 'NR>1{print $1}')
  while read -r m; do
    installed_as "$m" "$have" || { log "pulling missing model $m"; pull_quiet "$m"; }
  done < <(wanted_models)
  for m in $have; do
    if on_registry "$m"; then
      log "refreshing $m"; pull_quiet "$m"
    else
      log "skip $m (local/custom model)"
    fi
  done
}

# pi's bundled example extensions/agents/prompts, wired in without vendoring copies:
# symlinks track the installed pi version; agents are copied once with their Claude
# `model:` pins stripped so subagents inherit the local default. Existing files win.
sync_pi_resources() {
  command -v npm >/dev/null || return 0
  local root ex; root="$(npm root -g 2>/dev/null)"
  ex="$root/$PI_PKG/examples/extensions"
  [[ -d $ex ]] || ex="$root/$PI_PKG_OLD/examples/extensions"   # a pi not yet moved to the new name
  [[ -d $ex ]] || return 0
  mkdir -p "$PI_DIR/extensions/subagent" "$PI_DIR/agents" "$PI_DIR/prompts"
  ln -sfn "$ex/git-checkpoint.ts"  "$PI_DIR/extensions/git-checkpoint.ts"
  ln -sfn "$ex/plan-mode"          "$PI_DIR/extensions/plan-mode"
  ln -sfn "$ex/subagent/index.ts"  "$PI_DIR/extensions/subagent/index.ts"
  ln -sfn "$ex/subagent/agents.ts" "$PI_DIR/extensions/subagent/agents.ts"
  local f dst
  for f in "$ex"/subagent/agents/*.md; do
    dst="$PI_DIR/agents/$(basename "$f")"
    [[ -e $dst ]] || grep -v '^model:' "$f" > "$dst"
  done
  for f in "$ex"/subagent/prompts/*.md; do
    dst="$PI_DIR/prompts/$(basename "$f")"
    [[ -e $dst ]] || cp "$f" "$dst"
  done
}

# Wire installed (non-embedding) models into opencode + pi and fill defaults that are
# missing. Only adds: an existing key is never changed, except a model default still
# pointing at a model that is no longer installed, the old stand-in once the agent
# default lands, or a local default moving onto llama.cpp while its router is enabled
# (and back to Ollama when it is not). First touch of an existing opencode.json keeps a
# .foxml-bak copy.
sync_configs() {
  local installed=""
  ollama_up && installed=$(ollama list 2>/dev/null | awk 'NR>1 && $1 !~ /embed/ {print $1}')
  [[ -f $OPENCODE_JSON && ! -e $OPENCODE_JSON.foxml-bak ]] && cp -p "$OPENCODE_JSON" "$OPENCODE_JSON.foxml-bak"
  mkdir -p "$PI_DIR"
  sync_pi_resources
  # What each llama.cpp router serves (llama → :8080, llama-turbo → :8081), read back from the preset
  # fox-llm-serve writes — one source of truth for names, roles and contexts. "server model role ctx"
  # rows; role "-" for the other chat models (llama.cpp is the default server). Plus which of the two
  # units is enabled ("main turbo" flags).
  local served="" server_on="" engine sv unit
  for engine in main turbo; do
    if [[ $engine == main ]]; then sv=llama unit=fox-llm-server; else sv=llama-turbo unit=fox-llm-server-turbo; fi
    systemctl --user is-enabled "$unit.service" >/dev/null 2>&1 && server_on+="1" || server_on+="0"
    served+=$("$SERVE_BIN" --engine "$engine" preset 2>/dev/null | awk -v sv="$sv" '
      function row() { if (m != "" && m != "*") print sv, m, r, c }
      /^\[/                         { row(); m = substr($0, 2, length($0) - 2); r = "-"; c = 32768; next }
      /^; role: /                   { r = $3 }
      /^; extra embedding/          { r = "embed" }
      /^(c|kv-unified-per-slot) = / { c = $3 }
      END                           { row() }')$'\n'
  done
  # Models the roles file gives Ollama — with llama.cpp the one server, the only ones Ollama lists.
  local roles_f="" pinned="" f
  for f in "$LLM_DIR/roles.conf" "$HOME/code/custom_models/roles.conf" "$LLM_DIR/roles.default"; do
    [[ -f $f ]] && { roles_f=$f; break; }
  done
  [[ -n $roles_f ]] && pinned=$(awk '!/^[[:space:]]*(#|$)/ && $3 == "ollama" {
    m = $2; if (m !~ /:/) m = m ":latest"; print m }' "$roles_f")      # Ollama's names: bare = :latest
  mkdir -p "$STATE"
  # stdin carries the script, so the model list goes in as an argument.
  python3 -I - "$OPENCODE_JSON" "$PI_DIR" "$installed" "$AGENT_DEFAULT" "$TITLE_MODEL" "$served" "$server_on" \
    "$pinned" "$STATE/defaults.json" <<'EOF'
import json, os, sys
oc_path, pi_dir, installed_raw, agent_default, title_model, served_raw, server_on, pinned_raw, state_path = sys.argv[1:10]
installed = [l.strip() for l in installed_raw.splitlines() if l.strip()]
# server column → (provider id, display name, URL, unit enabled?)
ENGINES = {"llama":       ("llamacpp",       "llama.cpp (Local)",            "http://127.0.0.1:8080/v1", server_on[:1] == "1"),
           "llama-turbo": ("llamacpp-turbo", "llama.cpp TurboQuant (Local)", "http://127.0.0.1:8081/v1", server_on[1:2] == "1")}
# (role, model, server, context) for every model a llama.cpp router serves, from its preset: the roles
# file's models plus every other chat model llama.cpp can run (role "-").
llama = [(r, m, sv, int(c)) for sv, m, r, c in
         (f for f in (l.split() for l in served_raw.splitlines()) if len(f) == 4)
         if sv in ENGINES and c.isdigit()]
agent_role = next(((m, sv) for r, m, sv, _ in llama if r == "agent"), None)
quick_role = next((m for r, m, sv, _ in llama if r == "quick" and ENGINES[sv][3]), None)
LOCAL = ("ollama/",) + tuple(f"{e[0]}/" for e in ENGINES.values())
# Where each model runs: a router whose unit is enabled serves its models. With the main router on,
# llama.cpp is the one server: Ollama only downloads, and lists just what the roles file gives it.
# Without it, Ollama lists what no router serves. The ghost-text (fim) base model and the embedding
# models are no chat picker's.
on_llama = {m for _, m, sv, _ in llama if ENGINES[sv][3]}
not_chat = {m for r, m, _, _ in llama if r in ("fim", "embed")}
pinned = {l.strip() for l in pinned_raw.splitlines() if l.strip()}
single = ENGINES["llama"][3]
ollama_list = [m for m in installed if m not in on_llama and m not in not_chat and (not single or m in pinned)]
def gone_why(m):
    return ("on llama.cpp" if m in on_llama else "not a chat model" if m in not_chat
            else "llama.cpp is the one server" if single and m in installed else "not installed")
def where(m):
    """The provider of the local server that runs m now: an enabled router, else Ollama; None: neither."""
    p = next((ENGINES[sv][0] for _, mm, sv, _ in llama if mm == m and ENGINES[sv][3]), None)
    return p or ("ollama" if m in installed else None)
STANDIN = "qwen2.5-coder:14b"   # used while the agent default downloads
LIMIT = {"context": 32768, "output": 8192}
READ_ONLY = ["ls*", "pwd", "cat *", "head *", "tail *", "wc *", "file *", "stat *", "tree*",
             "rg *", "grep *", "fd *", "which *", "type *",   # not find: -delete / -exec write
             "git status*", "git diff*", "git log*", "git show*", "git branch*", "git blame*"]
notes = []

def load(p, default):
    try:
        with open(p) as f: return json.load(f)
    except FileNotFoundError:
        return default

def save(p, d):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p + ".new", "w") as f: f.write(json.dumps(d, indent=2) + "\n")
    os.replace(p + ".new", p)

def pick_default(current):
    """Keep the current default unless it is gone or is the stand-in that the agent default replaces."""
    if current and (not installed or current in installed) and not (current == STANDIN and agent_default in installed):
        return current
    for cand in (agent_default, STANDIN):
        if cand in installed: return cand
    return current or (installed[0] if installed else None)

def llama_default(cur):
    """Where a local default belongs while a llama.cpp router is enabled: the roles file's agent, else
    the usual pick (the current model, the agent default, the stand-in) on the router serving it.
    None when no enabled router serves it — Ollama keeps it."""
    if agent_role and ENGINES[agent_role[1]][3]:
        return f"{ENGINES[agent_role[1]][0]}/{agent_role[0]}"
    # No agent yet: stand in with the roles file's quick model, sized for this machine, instead of
    # the fixed STANDIN (which the sync picked, so it may move it). Measured 2026-10-14 on the 4 GB
    # T1200, pi's ~6k-token opening prompt: the 14B read it at ~40 tok/s (~3 min to the first word,
    # pi gave up), the quick 4B at ~150 tok/s (~1 min), then 1-2 s per turn from the prompt cache.
    if quick_role and (not cur or cur == STANDIN):
        cur = quick_role
    pick = pick_default(cur)
    return next((f"{ENGINES[sv][0]}/{m}" for _, m, sv, _ in llama if m == pick and ENGINES[sv][3]), None)

# The default the sync set last time, per tool. A model she picked herself (fox-ai-swap, opencode's or
# pi's own picker) stays hers: only its server follows the stack. One the sync picked may change model
# too — the stand-in gives way to the agent, a model that's gone is replaced.
try:
    state = json.load(open(state_path))
except (OSError, ValueError):
    state = {}
state_before = dict(state)

def local_default(cur, auto):
    """(new default, is it the sync's own) for a local default `cur` ("" when there is none). With no
    `auto` on record (first run), `cur` counts as the sync's."""
    model = cur.split("/", 1)[1] if "/" in cur else None
    if cur and auto is not None and cur != auto and model and where(model):
        return f"{where(model)}/{model}", False
    want = llama_default(model)
    if want:
        return want, True
    pick = pick_default(model)
    return (f"{where(pick) or 'ollama'}/{pick}" if pick else cur), True

# ── opencode ──
oc = load(oc_path, {"$schema": "https://opencode.ai/config.json"})
prov = oc.setdefault("provider", {}).setdefault("ollama", {})
prov.setdefault("name", "Ollama (Local)")
prov.setdefault("npm", "@ai-sdk/openai-compatible")
prov.setdefault("options", {"baseURL": "http://localhost:11434/v1"})
models = prov.setdefault("models", {})
for m in ollama_list:
    if m not in models:
        models[m] = {"name": m}; notes.append(f"opencode: + {m}")
    models[m].setdefault("limit", dict(LIMIT))
if installed or single:      # an empty `ollama list` (Ollama down) says nothing — unless llama.cpp serves all
    for m in [m for m in models if m not in ollama_list]:
        del models[m]; notes.append(f"opencode: − {m} ({gone_why(m)})")
if "small_model" not in oc and title_model in installed:
    oc["small_model"] = f"ollama/{title_model}"
sm = oc.get("small_model") or ""
if sm.startswith(LOCAL):     # the title model, on whichever local server runs it now
    m = sm.split("/", 1)[1]
    p = next((ENGINES[sv][0] for _, mm, sv, _ in llama if mm == m and ENGINES[sv][3]),
             "ollama" if m in installed else None)
    if p and sm != f"{p}/{m}":
        oc["small_model"] = f"{p}/{m}"; notes.append(f"opencode small_model → {p}/{m}")
# llama.cpp routers: providers listing what each serves while its unit is enabled.
for sv, (pid, pname, url, enabled) in ENGINES.items():
    rows = [(r, m, ctx) for r, m, s, ctx in llama if s == sv and enabled and m not in not_chat]
    if not rows and pid not in oc["provider"]:
        continue
    lp = oc["provider"].setdefault(pid, {})
    lp.setdefault("name", pname)
    lp.setdefault("npm", "@ai-sdk/openai-compatible")
    lp.setdefault("options", {"baseURL": url})
    lmodels = lp.setdefault("models", {})
    for r, m, ctx in rows:
        if m not in lmodels:
            lmodels[m] = {"name": m if r == "-" else f"{m} ({r})", "limit": {"context": ctx, "output": 8192}}
            notes.append(f"opencode: + {pid}/{m}")
    served = {m for _, m, _ in rows}
    for m in [m for m in lmodels if m not in served]:
        del lmodels[m]; notes.append(f"opencode: − {pid}/{m} ({'server off' if not enabled else 'not served'})")
cur = oc.get("model") or ""
if not cur or cur.startswith(LOCAL):          # a cloud default (anthropic/…, openai/…) is hers: never touched
    new, ours = local_default(cur, state.get("opencode"))
    if new and new != cur:
        oc["model"] = new; notes.append(f"opencode default → {new}")
    if ours and oc.get("model"):
        state["opencode"] = oc["model"]
oc.setdefault("autoupdate", False)          # pacman owns opencode; the timer reports updates
oc.setdefault("share", "disabled")          # never upload sessions
oc.setdefault("permission", {"edit": "ask", "webfetch": "ask",
                             "bash": {"*": "ask", **{k: "allow" for k in READ_ONLY}}})
save(oc_path, oc)

# ── pi ──
pm_path = os.path.join(pi_dir, "models.json")
pm = load(pm_path, {})
pprov = pm.setdefault("providers", {}).setdefault("ollama", {})
pprov.setdefault("baseUrl", "http://localhost:11434/v1")
pprov.setdefault("api", "openai-completions")
pprov.setdefault("apiKey", "ollama")
pprov.setdefault("compat", {"supportsDeveloperRole": False, "supportsReasoningEffort": False})
pms = pprov.setdefault("models", [])
have = {x.get("id") for x in pms}
for m in ollama_list:
    if m not in have:
        pms.append({"id": m, "contextWindow": LIMIT["context"], "maxTokens": LIMIT["output"]})
        notes.append(f"pi: + {m}")
if installed or single:
    for x in [x for x in pms if x.get("id") not in ollama_list]:
        notes.append(f"pi: − {x.get('id')} ({gone_why(x.get('id'))})")
    pprov["models"] = [x for x in pms if x.get("id") in ollama_list]
for sv, (pid, _, url, enabled) in ENGINES.items():
    rows = [(r, m, ctx) for r, m, s, ctx in llama if s == sv and enabled and m not in not_chat]
    if not rows and pid not in pm["providers"]:
        continue
    lpp = pm["providers"].setdefault(pid, {})
    lpp.setdefault("baseUrl", url)
    lpp.setdefault("api", "openai-completions")
    lpp.setdefault("apiKey", "none")
    lpp.setdefault("compat", {"supportsDeveloperRole": False, "supportsReasoningEffort": False})
    lms = lpp.setdefault("models", [])
    for r, m, ctx in rows:
        if m not in {x.get("id") for x in lms}:
            lms.append({"id": m, "name": m if r == "-" else f"{m} ({r})", "contextWindow": ctx, "maxTokens": 8192})
            notes.append(f"pi: + {pid}/{m}")
    served = {m for _, m, _ in rows}
    for x in [x for x in lms if x.get("id") not in served]:
        notes.append(f"pi: − {pid}/{x.get('id')} ({'server off' if not enabled else 'not served'})")
    lpp["models"] = [x for x in lms if x.get("id") in served]
save(pm_path, pm)

st_path = os.path.join(pi_dir, "settings.json")
st = load(st_path, {})
local_providers = ("ollama",) + tuple(e[0] for e in ENGINES.values())
prov, model = st.get("defaultProvider"), st.get("defaultModel")
if not prov or prov in local_providers:
    cur = f"{prov}/{model}" if prov and model else ""
    new, ours = local_default(cur, state.get("pi"))
    if new and new != cur:
        st["defaultProvider"], st["defaultModel"] = new.split("/", 1)
        notes.append(f"pi default → {new}")
    if ours and st.get("defaultModel"):
        state["pi"] = f"{st['defaultProvider']}/{st['defaultModel']}"
st.setdefault("enableInstallTelemetry", False)
# pi's defaults assume a 200k window; these fit the 32k local context.
st.setdefault("compaction", {"enabled": True, "reserveTokens": 4096, "keepRecentTokens": 8000})
st.setdefault("branchSummary", {"reserveTokens": 4096})
if os.path.exists(os.path.join(pi_dir, "themes", "foxml.json")):
    st.setdefault("theme", "foxml")
save(st_path, st)

if state != state_before:
    save(state_path, state)
for n in notes: print(n)
EOF
  # A download shows up without a restart: the router re-reads the preset fox-llm-serve just
  # rewrote; a loaded model stays loaded unless its own section changed.
  if [[ ${server_on:0:1} == 1 ]]; then curl -fs -m 5 -o /dev/null "http://127.0.0.1:8080/models?reload=1" || true; fi
  if [[ ${server_on:1:1} == 1 ]]; then curl -fs -m 5 -o /dev/null "http://127.0.0.1:8081/models?reload=1" || true; fi
}

do_discover() {
  mkdir -p "$STATE"
  local report="$STATE/discovered.tsv" seen="$STATE/seen.txt" have ref gb cls abl pulled=0 skipped=()
  touch "$seen"
  fast_link || return 0
  log "scanning ollama.com for new tool-capable models (takes a few minutes)"
  fox-llm-discover --pages 6 > "$report.new" || { warn "discovery failed"; return 1; }
  mv "$report.new" "$report"
  have=$(ollama list 2>/dev/null | awk 'NR>1{print $1}')
  while IFS=$'\t' read -r ref gb cls abl; do
    grep -qxF "${ref%%:*}" "$seen" && continue
    echo "${ref%%:*}" >> "$seen"
    [[ $cls == moe ]] || continue                       # dense ones stay in the report only
    grep -qxF "$ref" <<<"$have" && continue
    if (( pulled >= MAX_AUTO_PULLS )) || (( $(free_gb) - ${gb%.*} - 1 < MIN_FREE_GB )); then
      skipped+=("$ref (${gb} GB)"); continue
    fi
    log "new model: $ref (${gb} GB, MoE) — pulling"; pull_quiet "$ref"; pulled=$((pulled + 1))
    if [[ $abl != - ]] && (( $(free_gb) - ${gb%.*} - 1 >= MIN_FREE_GB )); then
      log "  + abliterated twin $abl"; pull_quiet "$abl"
    fi
  done < "$report"
  sync_configs
  local msg=""
  (( pulled )) && msg="Pulled $pulled new model(s)."
  (( ${#skipped[@]} )) && msg+=$'\n'"Also new, not pulled: ${skipped[*]}"$'\n'"fox-llm-update --list"
  if [[ -n $msg ]]; then
    log "$msg"; command -v notify-send >/dev/null && notify-send -a fox-llm "🦊 New local models" "$msg"
  else
    log "no new models since last scan"
  fi
}

# Discovery scrapes ~120 ollama.com pages; once a week is plenty.
do_auto() {
  do_check
  do_models check-link && sync_configs
  local report="$STATE/discovered.tsv"
  if [[ ! -f $report ]] || [[ -n $(find "$report" -mtime +6 2>/dev/null) ]]; then
    do_discover
  else
    log "discovery ran within the last week — skipping"
  fi
}

do_list() {
  local report="$STATE/discovered.tsv"
  [[ -f $report ]] || { warn "no report yet — run fox-llm-update --discover"; return 1; }
  printf 'model\tGB\tclass\tabliterated\n' | cat - "$report" | column -t -s $'\t'
  echo; echo "class: moe = agent speed here · small = usable · slow = fits RAM, too slow for agents"
}

do_queue() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  mkdir -p "$dir" "${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-update"
  cat > "$dir/fox-llm-pull.service.new" <<'EOF'
[Unit]
Description=fox-llm pull queue — download wanted local models (resumes after reboot, then disables itself)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fox-llm-update --queue-run
StandardOutput=append:%h/.cache/fox-llm-update/queue.log
StandardError=append:%h/.cache/fox-llm-update/queue.log
Nice=10

[Install]
WantedBy=default.target
EOF
  mv "$dir/fox-llm-pull.service.new" "$dir/fox-llm-pull.service"
  systemctl --user daemon-reload
  # restart, not `enable --now`: a queue already running keeps the code it started with, and after an
  # update that old code synced pi/opencode the old way (2026-10-14). Downloads resume where they were.
  systemctl --user enable fox-llm-pull.service && systemctl --user restart fox-llm-pull.service \
    && log "queue running — progress: tail -f ${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-update/queue.log"
}

# The service body. Downloads the first wanted model that is still missing — Hugging Face GGUFs
# before Ollama models — then re-reads the lists, so reordering or parking models in
# extra-models.txt / gguf-models.txt takes effect at the next model, not after a whole pass. Each model gets QUEUE_TRIES attempts a minute apart; one that
# runs out is set aside for the rest of the pass and retried in the next one. An Ollama too
# old for the registry (HTTP 412) stops the queue with a notice; `fox-llm-update` restarts it.
do_queue_run() {
  local m cand try out have pass=1 set_aside=" " src=""
  while :; do
    have=$(ollama list 2>/dev/null | awk 'NR>1{print $1}')
    m="" src=""
    while read -r cand src; do
      [[ -f $GGUF_DIR/$cand.gguf || $set_aside == *" $cand "* ]] && continue
      m=$cand; break
    done < <(gguf_wanted)
    [[ -n $m ]] || src=""
    if [[ -z $m ]]; then
      while read -r cand; do
        installed_as "$cand" "$have" && continue
        [[ $set_aside == *" $cand "* ]] && continue
        m=$cand; break
      done < <(wanted_models)
    fi
    if [[ -z $m ]]; then
      [[ $set_aside == " " ]] && break                  # everything wanted is installed
      echo "--- pass $pass left missing:$set_aside— next pass in 10 min"; sleep 600
      set_aside=" " pass=$((pass + 1)); continue
    fi
    echo "=== $(date '+%a %H:%M') $m (pass $pass)"
    for (( try = 1; try <= QUEUE_TRIES; try++ )); do
      if [[ -n $src ]]; then
        out=$(fetch_gguf "$m" "$src" 2>&1) && { echo "  done $(date '+%a %H:%M')"; sync_configs; continue 2; }
      else
        out=$(pull_quiet "$m") && { echo "  done $(date '+%a %H:%M')"; sync_configs; continue 2; }
      fi
      if grep -q 'newer version of Ollama' <<<"$out"; then
        local server; server=$(ver_ollama_server)
        warn "ollama server ${server:-?} is too old for the registry — run: fox-llm-update"
        command -v notify-send >/dev/null && notify-send -a fox-llm "🦊 Model downloads paused" \
          "Ollama ${server:-?} is too old for the registry. Run: fox-llm-update"
        exit 1
      fi
      echo "  attempt $try failed: $(tail -1 <<<"$out")"; sleep 60
    done
    set_aside+="$m "
  done
  echo "ALL_DONE $(date)"
  systemctl --user disable fox-llm-pull.service 2>/dev/null || true
}

update_ollama() {
  local cur new
  cur=$(ver_ollama); new=$(latest_ollama || true)
  if [[ -z $new ]]; then warn "could not reach GitHub for the ollama version"; return 1; fi
  if [[ $cur == "$new" ]]; then log "ollama $cur is current"; return 1; fi
  log "ollama $cur → $new"
  mkdir -p "$WORK"
  curl -fsSL https://ollama.com/install.sh -o "$WORK/install.sh" || return 1
  # install.sh rewrites the unit file; keep ours (PATH line etc.). Drop-ins are untouched.
  sudo cp -a "$UNIT" "$WORK/ollama.service.keep"
  sh "$WORK/install.sh"
  sudo cp -a "$WORK/ollama.service.keep" "$UNIT"
  sudo rm -f "$WORK/ollama.service.keep"
}

# Same file + tiers as fox-install's ollama_hardening; an existing drop-in that already
# sets both values wins (it may be hand-tuned). Returns 0 only when it wrote something.
tune_ollama() {
  if [[ -f $DROPIN ]] && grep -q OLLAMA_CONTEXT_LENGTH "$DROPIN" && grep -q OLLAMA_KEEP_ALIVE "$DROPIN"; then
    log "ollama context drop-in already in place"; return 1
  fi
  local ctx=8192 ram; ram=$(ram_gb)
  (( ram >= 16 )) && ctx=16384
  (( ram >= 32 )) && ctx=32768
  log "writing $DROPIN (context $ctx)"
  printf '[Service]\nEnvironment="OLLAMA_CONTEXT_LENGTH=%s"\nEnvironment="OLLAMA_KEEP_ALIVE=10m"\n' "$ctx" \
    | sudo tee "$DROPIN.tmp" >/dev/null && sudo mv "$DROPIN.tmp" "$DROPIN"
}

do_full() {
  sudo -v || { warn "sudo needed for the full run"; exit 1; }
  local changed=0
  update_ollama && changed=1
  tune_ollama && changed=1
  if (( changed )); then
    log "restarting ollama"
    sudo systemctl daemon-reload && sudo systemctl restart ollama && sleep 3
  fi

  local cur new
  cur=$(ver_pi); new=$(latest_pi || true)
  if [[ -n $new && $cur != "$new" ]]; then
    log "pi ${cur:-none} → $new"
    # both packages install a `pi` command, so the old one goes first; the example links follow in sync_configs
    if npm ls -g --depth=0 "$PI_PKG_OLD" >/dev/null 2>&1; then sudo npm uninstall -g "$PI_PKG_OLD"; fi
    sudo npm install -g "$PI_PKG@$new"
  else
    log "pi $cur is current"
  fi
  log "opencode comes from pacman ($(pacman -Q opencode 2>/dev/null)) — updates with pacman -Syu"

  # On a slow link a 20 GB model takes hours: hand the downloads to the background queue.
  if fast_link; then
    do_models
  else
    log "slow link — downloading in the background instead (survives reboots)"
    do_queue
  fi
  sync_configs
  log "done — ollama $(ver_ollama), pi $(ver_pi)"
}

case "${1:-}" in
  "")          do_full ;;
  --auto)      do_auto ;;
  --sync)      sync_configs ;;
  --queue)     do_queue ;;
  --queue-run) do_queue_run ;;
  --wanted)    wanted_models ;;
  --models|--check|--discover|--list)
    for a in "$@"; do
      case $a in
        --check) do_check ;; --discover) do_discover ;; --list) do_list ;;
        --models) do_models; sync_configs ;;
        *) warn "unknown arg $a"; exit 2 ;;
      esac
    done ;;
  -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)         warn "unknown arg $1"; exit 2 ;;
esac
