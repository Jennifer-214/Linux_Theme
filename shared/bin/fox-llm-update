#!/usr/bin/env bash
# fox-llm-update — keep the local-LLM stack (models, pi, opencode) current.
#
#   fox-llm-update            full run: pi (sudo, only when it has an update) + models + sync
#   fox-llm-update --auto     what the daily timer runs: --check, --models, and --discover when
#                             the last scan is over a week old. Downloads wait for a fast link.
#   fox-llm-update --models   download missing wanted models, and newer uploads of the ones it downloaded
#   fox-llm-update --check    report tool updates, desktop-notify if any (no sudo)
#   fox-llm-update --discover find new tool-capable models on Hugging Face that fit this box
#                             (fox-llm-discover), download up to MAX_AUTO_PULLS new MoE ones + abliterated twins
#   fox-llm-update --list     show the last discovery report
#   fox-llm-update --wanted   the models this machine should have, one "name user/repo/file.gguf" each
#   fox-llm-update --sync     wire the served models into opencode + pi; fill missing defaults;
#                             have the llama.cpp router reload its model list
#   fox-llm-update --queue    download wanted models in the background, resuming across reboots
#                             (user service fox-llm-pull), then stop
#
# Every model is a Hugging Face GGUF in llama.cpp's own format, downloaded resumably — size + sha256
# checked against Hugging Face's own record — to ~/.local/share/fox-llm/gguf/<name>.gguf, where
# fox-llm-serve serves it under <name>. Before a download its header goes through this llama.cpp's
# loader, so a model the build can't run never costs a 20 GB download. The lists: "name user/repo/
# file.gguf" lines, and "-name" skips a model from every list. In download order: the core list's
# helpers (shared/llm/core-models.txt, "tier: all" — small, and other tools need them), this machine's
# ~/.config/foxml/llm/gguf-models.txt, yours in ~/code/custom_models/gguf-models.conf (the private repo
# a reinstall clones back), then the core list's RAM tier. fox-install's models step queues them all here.
# Binaries are never auto-upgraded: the timer only notifies.
# --sync fills in what is missing and never changes keys you set in opencode.json / ~/.pi/agent/*.json,
# with two exceptions: a local model default follows the router that serves it, and the local
# providers' model lists mirror what each router serves (your settings on an entry are kept while the
# model is there).
set -uo pipefail

LLM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/foxml/llm"
CORE_LIST="$LLM_DIR/core-models.txt"      # deployed from Linux_Theme shared/llm/
GGUF_LIST="$LLM_DIR/gguf-models.txt"      # this machine's picks + skips; never in a repo
GGUF_PRIVATE="$HOME/code/custom_models/gguf-models.conf"   # yours, where a reinstall finds it
GGUF_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fox-llm/gguf"
WORK="${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-update"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/fox-llm-update"
MAX_AUTO_PULLS=2     # new base models per discovery run (abliterated twins ride along)
MIN_FREE_GB=100      # never auto-download below this much free disk
MIN_MBPS=2           # timer skips downloads on slow links (guest / hotspot Wi-Fi): 20 GB at 2 MB/s ≈ 3 h
QUEUE_TRIES=30       # --queue: per-model retries, a minute apart, before moving on
OPENCODE_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
PI_DIR="$HOME/.pi/agent"
# fox-llm-serve and fox-llm-discover deploy beside this script; a timer's PATH need not include ~/.local/bin.
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
SERVE_BIN="$HERE/fox-llm-serve"
GRADE_BIN="$HERE/fox-llm-grade"
DISCOVER_BIN="$HERE/fox-llm-discover"

log()  { printf '\033[1;33m[fox-llm]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m[fox-llm]\033[0m %s\n' "$*" >&2; }
# A desktop notice (mako). The queue and the daily timer run as user services, which see the session bus.
notify() { command -v notify-send >/dev/null && notify-send -a fox-llm "$@" 2>/dev/null; return 0; }

ver_pi()            { pi --version 2>&1 | grep -oE "[0-9]+\.[0-9]+\.[0-9]+" | head -1; }
# pi moved to @earendil-works at 1.0; @mariozechner/pi-coding-agent stops at 0.73.1 (deprecated, 2026-10-14)
PI_PKG=@earendil-works/pi-coding-agent PI_PKG_OLD=@mariozechner/pi-coding-agent
latest_pi()         { npm view "$PI_PKG" version 2>/dev/null; }
ram_gb()            { awk '/^MemTotal:/{printf "%d", ($2 + 1048575) / 1048576}' "${FOX_LLM_MEMINFO:-/proc/meminfo}"; }

# Same tiers as fox-install's models module.
ram_tier() {
  local ram; ram=$(ram_gb)
  if (( ram >= 32 )); then echo large; elif (( ram >= 16 )); then echo medium; else echo small; fi
}

# "-name" lines in your lists: models this machine should not download, from any list.
skipped_models() {
  local f
  for f in "$GGUF_LIST" "$GGUF_PRIVATE"; do
    if [[ -f $f ]]; then awk '/^[[:space:]]*-/ { sub(/^[[:space:]]*-/, ""); printf "%s ", $1 }' "$f"; fi
  done
}

# The core list's "name src" rows for one tier block.
core_rows() {
  [[ -f $CORE_LIST ]] || return 0
  awk -v t="$1" '/^# tier:/ { b = $3; next } /^[[:space:]]*(#|$)/ { next } b == t && NF >= 2 { print $1, $2 }' "$CORE_LIST"
}

# Every model this machine should have, "name user/repo/file.gguf", each name once (the first list that
# names it decides its file), in download order.
wanted_models() {
  local f
  {
    core_rows all
    for f in "$GGUF_LIST" "$GGUF_PRIVATE"; do
      if [[ -f $f ]]; then awk '!/^[[:space:]]*(#|-|$)/ && NF >= 2 { print $1, $2 }' "$f"; fi
    done
    core_rows "$(ram_tier)"
  } | awk -v skip="$(skipped_models)" '
      BEGIN { n = split(skip, s, " "); for (i = 1; i <= n; i++) drop[s[i]] = 1 }
      !($1 in drop) && !seen[$1]++'
}

# Lists from before Hugging Face was the only source hold Ollama names — nothing to download them
# from. Said on interactive runs, so their models get a "name user/repo/file.gguf" line instead.
legacy_notice() {
  local f old=()
  for f in "$LLM_DIR/extra-models.txt" "${XDG_CONFIG_HOME:-$HOME/.config}/foxml/models.private" \
           "$HOME"/code/*/foxml-models.txt; do
    if [[ -f $f ]] && grep -qvE '^[[:space:]]*(#|-|$)' "$f"; then old+=("$f"); fi
  done
  if (( ${#old[@]} )); then
    warn "not read any more (Ollama names): ${old[*]} — give each model a 'name user/repo/file.gguf' line in $GGUF_LIST or $GGUF_PRIVATE"
  fi
  return 0
}

# Hugging Face's record of one file: "size sha256", nothing when it has none.
hf_meta() {
  local repo=$1 file=$2 dir
  dir=$(dirname "$file"); [[ $dir == . ]] && dir=""
  curl -fsS -m 60 "https://huggingface.co/api/models/$repo/tree/main${dir:+/$dir}" | python3 -I -c '
import json, sys
f = next((f for f in json.load(sys.stdin) if f.get("path") == sys.argv[1]), {})
print(f.get("size", ""), (f.get("lfs") or {}).get("oid", ""))' "$file" 2>/dev/null
}

# llama.cpp's header-only loader: the package's, else a source build's.
probe_bin() {
  local c
  for c in "$(command -v llama-fit-params 2>/dev/null)" \
           "$HOME"/.local/opt/llama.cpp/build-cuda/bin/llama-fit-params "$HOME"/.local/opt/llama.cpp/build-cpu/bin/llama-fit-params; do
    if [[ -n $c && -x $c ]]; then echo "$c"; return 0; fi
  done
  return 1
}

# Why this llama.cpp can't load a file, from an earlier check with this same build — nothing when it
# could, or wasn't checked. "src<TAB>build<TAB>why" lines; a llama.cpp update checks again.
INCOMPATIBLE="$WORK/incompatible"
known_incompatible() {
  local probe line
  probe=$(probe_bin) || return 1
  line=$(grep -m1 -F "$1	$probe@$(stat -c %Y "$probe")	" "$INCOMPATIBLE" 2>/dev/null) || return 1
  echo "${line##*	}"
}

# Can this llama.cpp load the file? Its header — key-values and the tensor list, the first MBs — goes
# into a sparse copy of the full size, and llama-fit-params lays the model out from it without reading a
# weight; "error loading model: <why>" means an architecture or tensor layout this build doesn't know
# (how Ollama's own GGUF variant of the abliterated Qwen 3.5/3.6 failed, 2026-10-14). Prints why; nothing
# when it loads, or when it can't be told — no llama.cpp here yet (the first install queues models before
# its llama_server step; the core list's files were all checked when they went in), or a header past 64 MB.
header_error() {
  local name=$1 repo=$2 file=$3 size=$4 probe dir head skel mb end why
  probe=$(probe_bin) || return 0
  why=$(known_incompatible "$repo/$file") && { echo "$why"; return 0; }
  dir="$GGUF_DIR/.probe"; head="$dir/$name.head"; skel="$dir/$name.gguf"
  mkdir -p "$dir"
  for mb in 16 64; do
    curl -fsSL -m 900 -r "0-$(( mb * 1048576 - 1 ))" -o "$head" "https://huggingface.co/$repo/resolve/main/$file" \
      || { rm -f "$head"; return 0; }
    end=$(python3 -I - "$head" <<'EOF'
import struct, sys
SIZES = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
data = open(sys.argv[1], "rb").read()
pos = 0
def take(n):
    global pos
    if pos + n > len(data):
        raise EOFError
    pos += n
    return data[pos - n:pos]
def num(fmt):
    return struct.unpack(fmt, take(struct.calcsize(fmt)))[0]
try:
    if take(4) != b"GGUF":
        raise ValueError
    num("<I"); n_tensors, n_kv = num("<Q"), num("<Q")
    for _ in range(n_kv):
        take(num("<Q")); t = num("<I")
        if t == 9:
            et, n = num("<I"), num("<Q")
            if et == 8:
                for _ in range(n): take(num("<Q"))
            else:
                take(SIZES[et] * n)
        elif t == 8:
            take(num("<Q"))
        else:
            take(SIZES[t])
    for _ in range(n_tensors):
        take(num("<Q")); dims = num("<I"); take(8 * dims + 4 + 8)
    print("ok")
except EOFError:
    print("short")
except Exception:
    print("unknown")
EOF
)
    [[ $end == short ]] || break
  done
  if [[ $end != ok ]]; then rm -f "$head"; return 0; fi
  rm -f "$skel"
  truncate -s "$size" "$skel" && dd if="$head" of="$skel" conv=notrunc status=none
  why=$(timeout 120 "$probe" -m "$skel" -c 512 -dev none 2>&1 | sed -n 's/.*error loading model: //p' | head -n1)
  rm -f "$skel" "$head"
  if [[ -n $why ]]; then
    mkdir -p "$WORK"
    printf '%s\t%s\t%s\n' "$repo/$file" "$probe@$(stat -c %Y "$probe")" "$why" >> "$INCOMPATIBLE"
    echo "$why"
  fi
}

# One Hugging Face GGUF into GGUF_DIR/<name>.gguf: resumes a partial file, gives up on a stalled link
# (the queue retries a minute later, resuming again), and checks size and sha256 against Hugging Face's
# own record before the file goes live. A new download first passes header_error. Each download is
# recorded in .src/<name> ("user/repo/file.gguf sha256") — with $3 = refresh, a recorded file is replaced
# by Hugging Face's newer upload of the same file (repos fix chat templates in place); a model you put
# there yourself has no record and is never touched. Exit 0 when the file is in place, 2 when this
# llama.cpp can't load it (retrying won't help), 1 otherwise.
fetch_gguf() {
  local name=$1 src=$2 mode=${3:-} repo file meta size sha part dst rec have avail why
  if [[ $name == */* || $name == .* || $src != */*/* ]]; then echo "bad GGUF line: $name $src"; return 1; fi
  # A model split over several files (…-00001-of-00003.gguf) is one model in three downloads, and its
  # first file alone doesn't load: single-file GGUFs only.
  if [[ $src =~ -[0-9]{5}-of-[0-9]{5}\.gguf$ ]]; then echo "$name: $src is one part of a split model — pick a single-file GGUF"; return 2; fi
  repo=$(cut -d/ -f1-2 <<<"$src"); file=${src#"$repo/"}
  dst="$GGUF_DIR/$name.gguf"; part="$dst.part"; rec="$GGUF_DIR/.src/$name"
  if [[ $mode == refresh ]]; then
    [[ -f $dst && -f $rec && $(cut -d' ' -f1 "$rec") == "$src" ]] || return 0
  elif [[ -f $dst ]]; then
    return 0
  fi
  meta=$(hf_meta "$repo" "$file")
  read -r size sha <<<"$meta"
  [[ -n $size && -n $sha ]] || { echo "no size + sha256 on Hugging Face for $src"; return 1; }
  if [[ $mode == refresh ]]; then
    [[ $(cut -d' ' -f2 "$rec") == "$sha" ]] && return 0
    echo "$name: Hugging Face has a newer upload of $file — downloading it (the current file serves until then)"
  fi
  mkdir -p "$GGUF_DIR/.src"
  have=$(stat -c %s "$part" 2>/dev/null || echo 0)
  if (( have > size )); then rm -f "$part"; have=0; fi
  if (( have == 0 )); then
    why=$(header_error "$name" "$repo" "$file" "$size")
    if [[ -n $why ]]; then echo "$name: this llama.cpp can't load $src ($why) — not downloaded"; return 2; fi
  fi
  avail=$(df -B1 --output=avail "$GGUF_DIR" | tail -1)
  (( avail > size - have + 10 * 1024 ** 3 )) || { echo "not enough disk for $name ($(( size / 1024 ** 3 )) GiB)"; return 1; }
  if (( have < size )); then
    local show=(-sS); [[ -t 2 ]] && show=(-#)
    curl -fL "${show[@]}" --retry 5 --retry-delay 30 --speed-limit 1024 --speed-time 300 -C - -o "$part" \
      "https://huggingface.co/$repo/resolve/main/$file" \
      || { echo "interrupted at $(( $(stat -c %s "$part" 2>/dev/null || echo 0) / 1024 ** 2 )) of $(( size / 1024 ** 2 )) MiB"; return 1; }
  fi
  [[ $(stat -c %s "$part") == "$size" ]] || { echo "size mismatch for $name"; return 1; }
  if [[ $(sha256sum "$part" | cut -d' ' -f1) != "$sha" ]]; then
    rm -f "$part"; echo "sha256 mismatch for $name — discarded, it downloads again"; return 1
  fi
  mv "$part" "$dst" && echo "$src $sha" > "$rec" && echo "$name: verified, $(( size / 1024 ** 3 )) GiB"
}

# Download speed from Hugging Face in MB/s (a 12 s sample of a real model file).
link_mbps() {
  curl -sL -o /dev/null --max-time 12 -r 0-999999999 -w '%{speed_download}' \
    https://huggingface.co/ggml-org/gpt-oss-20b-GGUF/resolve/main/gpt-oss-20b-MXFP4.gguf | awk '{printf "%d", $1/1e6}'
}

fast_link() {
  local mbps; mbps=$(link_mbps)
  if (( ${mbps:-0} < MIN_MBPS )); then
    warn "Hugging Face link is ~${mbps:-0} MB/s (< ${MIN_MBPS}) — skipping downloads; rerun on a faster network"
    warn "or download in the background anyway: fox-llm-update --queue"
    return 1
  fi
}

free_gb() { mkdir -p "$GGUF_DIR"; df -BG --output=avail "$GGUF_DIR" 2>/dev/null | tail -1 | tr -dc 0-9; }

do_check() {
  local msgs=() cur new pkg old
  cur=$(ver_pi); new=$(latest_pi || true)
  [[ -n $new && $cur != "$new" ]] && msgs+=("pi $cur → $new")
  if command -v checkupdates >/dev/null; then
    while read -r pkg old _ new; do
      msgs+=("$pkg $old → $new (pacman -Syu)")
    done < <(checkupdates 2>/dev/null | awk '$1 ~ /^(opencode|llama-cpp|ggml|ggml-cuda|ggml-vulkan)$/')
  fi
  if ((${#msgs[@]})); then
    log "updates available: ${msgs[*]}"
    notify "🦊 LLM tool updates" "$(printf '%s\n' "${msgs[@]}")
Run: fox-llm-update"
  else
    log "pi, opencode, llama.cpp are current"
  fi
}

# $1 = "check-link" for the timer path; the interactive full run downloads regardless.
do_models() {
  [[ ${1:-} == check-link ]] && { fast_link || return 0; }
  [[ ${1:-} == check-link ]] || legacy_notice
  local name src rec
  while read -r name src; do
    [[ -f $GGUF_DIR/$name.gguf ]] && continue
    log "downloading $name ($src)"
    fetch_gguf "$name" "$src" || warn "$name not downloaded — the background queue retries: fox-llm-update --queue"
  done < <(wanted_models)
  for rec in "$GGUF_DIR"/.src/*; do
    [[ -f $rec ]] || continue
    name=${rec##*/}; read -r src _ < "$rec"
    fetch_gguf "$name" "$src" refresh || warn "$name: the newer upload didn't download — the current file stays"
  done
}

# pi's bundled example extensions/agents/prompts, wired in without vendoring copies:
# symlinks track the installed pi version; agents are copied once with their Claude
# `model:` pins stripped so subagents inherit the local default. Existing files win.
sync_pi_resources() {
  command -v npm >/dev/null || return 0
  local root ex; root="$(npm root -g 2>/dev/null)"
  ex="$root/$PI_PKG/examples/extensions"
  [[ -d $ex ]] || ex="$root/$PI_PKG_OLD/examples/extensions"   # a pi not yet moved to the new name
  [[ -d $ex ]] || return 0
  mkdir -p "$PI_DIR/extensions/subagent" "$PI_DIR/agents" "$PI_DIR/prompts"
  ln -sfn "$ex/git-checkpoint.ts"  "$PI_DIR/extensions/git-checkpoint.ts"
  ln -sfn "$ex/plan-mode"          "$PI_DIR/extensions/plan-mode"
  ln -sfn "$ex/subagent/index.ts"  "$PI_DIR/extensions/subagent/index.ts"
  ln -sfn "$ex/subagent/agents.ts" "$PI_DIR/extensions/subagent/agents.ts"
  local f dst
  for f in "$ex"/subagent/agents/*.md; do
    dst="$PI_DIR/agents/$(basename "$f")"
    [[ -e $dst ]] || grep -v '^model:' "$f" > "$dst"
  done
  for f in "$ex"/subagent/prompts/*.md; do
    dst="$PI_DIR/prompts/$(basename "$f")"
    [[ -e $dst ]] || cp "$f" "$dst"
  done
}

# opencode's commands from the prompt library (~/.config/foxml/prompts, format 1 — its README is the contract, agreed
# with the fox-symdeps line, whose generators feed pi and CodeCompanion from the same files). A prompt becomes
# commands/<name>.md: its description and its `opencode:` block (agent, model, subtask) as front matter, its body as the
# template ($ARGUMENTS and $1… are opencode's own; a "## system" part goes first, headings dropped). Only files this
# made are ever written or deleted — they start with a "# generated" line; one a person wrote is never touched.
sync_prompts() {
  local lib="${XDG_CONFIG_HOME:-$HOME/.config}/foxml/prompts"
  [[ -d $lib || -d $(dirname "$OPENCODE_JSON")/commands ]] || return 0
  python3 -I - "$lib" "$(dirname "$OPENCODE_JSON")/commands" <<'EOF'
import os, re, sys
try:
    import yaml
except ImportError:
    print("opencode: prompt library skipped — python-yaml is not installed"); sys.exit(0)
lib, out = sys.argv[1:3]
MARK = "# generated by fox-llm-update from "
EDITOR = re.compile(r"\{\{(selection|filetype|file|buffer)\}\}")
BUILTIN = {"agents", "commands", "compact", "connect", "copy", "details", "editor", "exit", "export", "fork", "help",
           "init", "mcp", "models", "new", "redo", "rename", "review", "sessions", "share", "skills", "status",
           "themes", "thinking", "timeline", "undo"}          # opencode's own slash commands
notes, want = [], {}

def render(path):
    """(name, file text) for opencode, None when the prompt isn't for opencode; raises ValueError(why) to refuse."""
    name = os.path.basename(path)[:-3]
    text = open(path, encoding="utf-8").read()
    m = re.match(r"---\n(.*?)\n---\n?(.*)\Z", text, re.S)
    if not m:
        raise ValueError("no front matter")
    meta, body = yaml.safe_load(m.group(1)) or {}, m.group(2)
    targets = meta.get("targets")
    if targets is not None and "opencode" not in targets:
        return None
    if EDITOR.search(body):
        if targets is not None:
            raise ValueError("it uses the editor's context, which opencode can't fill")
        return None                                     # CodeCompanion's alone
    if not re.fullmatch(r"[a-z0-9-]+", name):
        raise ValueError("a name is lowercase a-z, 0-9 and -")
    if name in BUILTIN:
        raise ValueError(f"/{name} is opencode's own command — rename the file")
    if not isinstance(meta.get("description"), str) or not meta["description"].strip():
        raise ValueError("no description")
    s = re.match(r"\s*## system[ \t]*\n(.*?)\n## user[ \t]*\n(.*)\Z", body, re.S)
    if s:
        body = s.group(1).strip() + "\n\n" + s.group(2).strip() + "\n"
    elif re.search(r"^## system[ \t]*$", body, re.M):
        raise ValueError("a '## system' part must open the body and be followed by '## user'")
    front = {"description": meta["description"].strip()}
    for k in ("agent", "model", "subtask"):
        if k in (meta.get("opencode") or {}):
            front[k] = meta["opencode"][k]
    fm = yaml.safe_dump(front, sort_keys=False, allow_unicode=True, width=10**6)
    return name, f"---\n{MARK}{path}\n{fm}---\n{body.lstrip(chr(10))}"

for f in sorted(os.listdir(lib)) if os.path.isdir(lib) else []:
    if not f.endswith(".md") or f == "README.md" or f.startswith("_"):
        continue
    try:
        r = render(os.path.join(lib, f))
    except (ValueError, yaml.YAMLError, OSError) as e:
        why = str(e).splitlines()[0] if str(e) else type(e).__name__
        notes.append(f"opencode: /{f[:-3]} not made — {why} ({os.path.join(lib, f)})"); continue
    if r:
        want[r[0]] = r[1]

def ours(p):
    try:
        with open(p, encoding="utf-8") as fh:
            return fh.readline() == "---\n" and fh.readline().startswith(MARK)
    except OSError:
        return False

for name, text in want.items():
    p = os.path.join(out, name + ".md")
    if os.path.exists(p) and not ours(p):
        notes.append(f"opencode: /{name} not made — {p} is a command you wrote"); continue
    if os.path.exists(p) and open(p, encoding="utf-8").read() == text:
        continue
    os.makedirs(out, exist_ok=True)
    with open(p + ".new", "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(p + ".new", p)
    notes.append(f"opencode: + /{name} (from the prompt library)")
for f in sorted(os.listdir(out)) if os.path.isdir(out) else []:
    p = os.path.join(out, f)
    if f.endswith(".md") and f[:-3] not in want and ours(p):
        os.remove(p); notes.append(f"opencode: − /{f[:-3]} (its prompt is gone or not for opencode)")
for n in notes: print(n)
EOF
}

# Wire the served chat models into opencode + pi and fill defaults that are missing. Only adds: an
# existing key is never changed, except a local model default the sync itself picked (it moves to the
# agent once that is served), a default on a model no router serves any more, a default whose router
# changed, and the Ollama provider entries from before llama.cpp served everything (dropped). First touch
# of an existing opencode.json keeps a .foxml-bak copy.
sync_configs() {
  [[ -f $OPENCODE_JSON && ! -e $OPENCODE_JSON.foxml-bak ]] && cp -p "$OPENCODE_JSON" "$OPENCODE_JSON.foxml-bak"
  mkdir -p "$PI_DIR"
  sync_pi_resources
  # What each llama.cpp router serves (llama → :8080, llama-turbo → :8081), read back from the preset
  # fox-llm-serve writes — one source of truth for names, roles and contexts. "server model role ctx"
  # rows; role "-" for the other models (the main router serves every downloaded one). Plus which of
  # the two units is enabled ("main turbo" flags).
  local served="" server_on="" engine sv unit preset skipped=""
  for engine in main turbo; do
    if [[ $engine == main ]]; then sv=llama unit=fox-llm-server; else sv=llama-turbo unit=fox-llm-server-turbo; fi
    systemctl --user is-enabled "$unit.service" >/dev/null 2>&1 && server_on+="1" || server_on+="0"
    preset=$("$SERVE_BIN" --engine "$engine" preset 2>/dev/null)
    served+=$(awk -v sv="$sv" '
      function row() { if (m != "" && m != "*") print sv, m, r, c }
      /^\[/                         { row(); m = substr($0, 2, length($0) - 2); r = "-"; c = 32768; next }
      /^; role: /                   { r = $3 }
      /^; extra embedding/          { r = "embed" }
      /^(c|kv-unified-per-slot) = / { c = $3 }
      END                           { row() }' <<<"$preset")$'\n'
    # a role the router can't fill (its model isn't downloaded, or won't load): "name (role): why" lines
    if [[ ${server_on: -1} == 1 ]]; then skipped+=$(sed -n 's/^; skipped //p' <<<"$preset")$'\n'; fi
  done
  mkdir -p "$STATE"
  # stdin carries the script, so the lists go in as arguments. Its notes are kept for the notices below.
  python3 -I - "$OPENCODE_JSON" "$PI_DIR" "$served" "$server_on" "$STATE/defaults.json" <<'EOF' | tee "$STATE/sync-notes.txt"
import json, os, sys
oc_path, pi_dir, served_raw, server_on, state_path = sys.argv[1:6]
# server column → (provider id, display name, URL, unit enabled?)
ENGINES = {"llama":       ("llamacpp",       "llama.cpp (Local)",            "http://127.0.0.1:8080/v1", server_on[:1] == "1"),
           "llama-turbo": ("llamacpp-turbo", "llama.cpp TurboQuant (Local)", "http://127.0.0.1:8081/v1", server_on[1:2] == "1")}
# (role, model, server, context) for every model a llama.cpp router serves, from its preset: the roles
# file's models plus every other downloaded one (role "-").
llama = [(r, m, sv, int(c)) for sv, m, r, c in
         (f for f in (l.split() for l in served_raw.splitlines()) if len(f) == 4)
         if sv in ENGINES and c.isdigit()]
# Chat models on an enabled router — the ghost-text (fim) base model and the embedding models are no
# chat picker's.
not_chat = {m for r, m, _, _ in llama if r in ("fim", "embed")}
chat = [(m, sv) for r, m, sv, _ in llama if ENGINES[sv][3] and m not in not_chat]
def role(name):
    return next(((m, sv) for r, m, sv, _ in llama if r == name and ENGINES[sv][3]), None)
agent_role, quick_role, title_role = role("agent"), role("quick"), role("title")
# ollama/: defaults written before llama.cpp served everything — moved like any other local default.
LOCAL = ("ollama/",) + tuple(f"{e[0]}/" for e in ENGINES.values())
def norm(m):
    """Ollama's spelling of an untagged name ("name:latest") is the name."""
    return m[:-len(":latest")] if m.endswith(":latest") else m
def where(m):
    """The provider of the enabled router serving chat model m; None when none does."""
    return next((ENGINES[sv][0] for mm, sv in chat if mm == norm(m)), None)
def ref(pair):
    return f"{ENGINES[pair[1]][0]}/{pair[0]}" if pair else None
def why(new, cur):
    """Why a local default moved from cur, for its note (and the desktop notice that repeats it)."""
    if cur and norm(cur.split("/", 1)[-1]) == new.split("/", 1)[1]:
        return "same model, now on the router that serves it"
    if agent_role and new == ref(agent_role):
        return "the roles file's agent"
    if quick_role and new == ref(quick_role):
        return "standing in for the agent, which isn't served yet"
    return "the model it had isn't served any more"
READ_ONLY = ["ls*", "pwd", "cat *", "head *", "tail *", "wc *", "file *", "stat *", "tree*",
             "rg *", "grep *", "fd *", "which *", "type *",   # not find: -delete / -exec write
             "git status*", "git diff*", "git log*", "git show*", "git branch*", "git blame*"]
# pi's fox-guard secrets (shared/pi/extensions/fox-guard.ts: PROTECTED_PREFIXES under ~, PROTECTED_FRAGMENTS but /.git/;
# a test keeps the lists equal). opencode asks before a command or one of its own tools touches one. Its rules match a
# command line or a path, * spans slashes, and the last match wins (its own read rules: *.env ask, *.env.example
# allow), so these go after everything else.
SECRET_DIRS = [".ssh", ".gnupg", ".claude", ".config/foxml", ".local/share/keyrings"]
SECRET_BITS = ["/priv/", "/.env", ".pem", ".key", "id_rsa", "id_ed25519"]
HOME = os.path.expanduser("~")
def secret_rules(tool):
    if tool == "bash":
        pats = [p for d in SECRET_DIRS for p in (f"*~/{d}*", f"*$HOME/{d}*", f"*{HOME}/{d}*")]
    else:
        pats = [p for d in SECRET_DIRS for p in (f"{HOME}/{d}", f"{HOME}/{d}/*")]
    pats += [f"*{b}*" for b in SECRET_BITS]
    if tool == "grep":                  # a search from ~ or / reads every secret folder below it
        pats += [HOME, f"{HOME}/", "/"]
    return pats
notes = []

def load(p, default):
    try:
        with open(p) as f: return json.load(f)
    except FileNotFoundError:
        return default

def save(p, d):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p + ".new", "w") as f: f.write(json.dumps(d, indent=2) + "\n")
    os.replace(p + ".new", p)

def is_local_ollama(url):
    return any(h in (url or "") for h in ("localhost:11434", "127.0.0.1:11434"))

def sync_default(cur):
    """The sync's own pick: the roles file's agent once it is served; until then the model it picked
    before while that is still served, else the quick model — the agents' stand-in, sized for this
    machine (measured 2026-10-14 on the 4 GB T1200, pi's ~6k-token opening prompt: a 14B read it at
    ~40 tok/s, ~3 min to the first word, and pi gave up; the quick 4B at ~150 tok/s, ~1 min, then 1-2 s
    per turn from the prompt cache). No roles served: any chat model. None: no router serves one."""
    if agent_role:
        return ref(agent_role)
    if cur and where(cur):
        return f"{where(cur)}/{norm(cur)}"
    if quick_role:
        return ref(quick_role)
    return ref(chat[0]) if chat else None

# The default the sync set last time, per tool. A model she picked herself (fox-ai-swap, opencode's or
# pi's own picker) stays hers: only its router follows the stack. One the sync picked may change model
# too — the stand-in gives way to the agent, a model that's gone is replaced.
try:
    state = json.load(open(state_path))
except (OSError, ValueError):
    state = {}
state_before = dict(state)

def local_default(cur, auto):
    """(new default, is it the sync's own) for a local default `cur` ("" when there is none). With no
    `auto` on record (first run), `cur` counts as the sync's."""
    model = cur.split("/", 1)[1] if "/" in cur else None
    if cur and auto is not None and cur != auto and model and where(model):
        return f"{where(model)}/{norm(model)}", False
    return (sync_default(model) or cur), True

def drop_ollama(providers, url_key, tool):
    p = providers.get("ollama")
    url = ((p or {}).get("options") or {}).get("baseURL") if tool == "opencode" else (p or {}).get(url_key)
    if p is not None and is_local_ollama(url):
        del providers["ollama"]; notes.append(f"{tool}: − ollama provider (llama.cpp serves every model)")

# ── opencode ──
oc = load(oc_path, {"$schema": "https://opencode.ai/config.json"})
providers = oc.setdefault("provider", {})
drop_ollama(providers, "baseURL", "opencode")
sm = oc.get("small_model") or ""
if not sm and title_role:
    oc["small_model"] = ref(title_role); notes.append(f"opencode small_model → {oc['small_model']}")
elif sm.startswith(LOCAL):     # the title model, on whichever router serves it now
    p, m = where(sm.split("/", 1)[1]), norm(sm.split("/", 1)[1])
    want = f"{p}/{m}" if p else ref(title_role)
    if want and sm != want:
        oc["small_model"] = want; notes.append(f"opencode small_model → {want}")
# llama.cpp routers: providers listing what each serves while its unit is enabled.
for sv, (pid, pname, url, enabled) in ENGINES.items():
    rows = [(r, m, ctx) for r, m, s, ctx in llama if s == sv and enabled and m not in not_chat]
    if not rows and pid not in providers:
        continue
    lp = providers.setdefault(pid, {})
    lp.setdefault("name", pname)
    lp.setdefault("npm", "@ai-sdk/openai-compatible")
    lp.setdefault("options", {"baseURL": url})
    lmodels = lp.setdefault("models", {})
    for r, m, ctx in rows:
        if m not in lmodels:
            lmodels[m] = {"name": m if r == "-" else f"{m} ({r})", "limit": {"context": ctx, "output": 8192}}
            notes.append(f"opencode: + {pid}/{m}")
    served = {m for _, m, _ in rows}
    for m in [m for m in lmodels if m not in served]:
        del lmodels[m]; notes.append(f"opencode: − {pid}/{m} ({'server off' if not enabled else 'not served'})")
cur = oc.get("model") or ""
if not cur or cur.startswith(LOCAL):          # a cloud default (anthropic/…, openai/…) is hers: never touched
    new, ours = local_default(cur, state.get("opencode"))
    if new and new != cur:
        oc["model"] = new; notes.append(f"opencode default → {new} ({why(new, cur)})")
    if ours and oc.get("model"):
        state["opencode"] = oc["model"]
oc.setdefault("autoupdate", False)          # pacman owns opencode; the timer reports updates
oc.setdefault("share", "disabled")          # never upload sessions
perm = oc.setdefault("permission", {"edit": "ask", "webfetch": "ask",
                                    "bash": {"*": "ask", **{k: "allow" for k in READ_ONLY}}})
if isinstance(perm, dict):
    added = 0
    for tool in ("bash", "read", "grep", "glob", "list"):
        rules = perm.setdefault(tool, {})    # only the secret rules: what else a tool may do stays as it was
        if not isinstance(rules, dict):
            continue                         # one action for the whole tool: hers
        for pat in secret_rules(tool):
            if pat not in rules:
                rules[pat] = "ask"; added += 1
    if added:
        notes.append(f"opencode: + {added} rules — secret paths ask first, as in pi")
save(oc_path, oc)

# ── pi ──
pm_path = os.path.join(pi_dir, "models.json")
pm = load(pm_path, {})
pproviders = pm.setdefault("providers", {})
drop_ollama(pproviders, "baseUrl", "pi")
for sv, (pid, _, url, enabled) in ENGINES.items():
    rows = [(r, m, ctx) for r, m, s, ctx in llama if s == sv and enabled and m not in not_chat]
    if not rows and pid not in pproviders:
        continue
    lpp = pproviders.setdefault(pid, {})
    lpp.setdefault("baseUrl", url)
    lpp.setdefault("api", "openai-completions")
    lpp.setdefault("apiKey", "none")
    lpp.setdefault("compat", {"supportsDeveloperRole": False, "supportsReasoningEffort": False})
    lms = lpp.setdefault("models", [])
    for r, m, ctx in rows:
        if m not in {x.get("id") for x in lms}:
            lms.append({"id": m, "name": m if r == "-" else f"{m} ({r})", "contextWindow": ctx, "maxTokens": 8192})
            notes.append(f"pi: + {pid}/{m}")
    served = {m for _, m, _ in rows}
    for x in [x for x in lms if x.get("id") not in served]:
        notes.append(f"pi: − {pid}/{x.get('id')} ({'server off' if not enabled else 'not served'})")
    lpp["models"] = [x for x in lms if x.get("id") in served]
save(pm_path, pm)

st_path = os.path.join(pi_dir, "settings.json")
st = load(st_path, {})
local_providers = ("ollama",) + tuple(e[0] for e in ENGINES.values())
prov, model = st.get("defaultProvider"), st.get("defaultModel")
if not prov or prov in local_providers:
    cur = f"{prov}/{model}" if prov and model else ""
    new, ours = local_default(cur, state.get("pi"))
    if new and new != cur:
        st["defaultProvider"], st["defaultModel"] = new.split("/", 1)
        notes.append(f"pi default → {new} ({why(new, cur)})")
    if ours and st.get("defaultModel"):
        state["pi"] = f"{st['defaultProvider']}/{st['defaultModel']}"
st.setdefault("enableInstallTelemetry", False)
# pi's defaults assume a 200k window; these fit the 32k local context.
st.setdefault("compaction", {"enabled": True, "reserveTokens": 4096, "keepRecentTokens": 8000})
st.setdefault("branchSummary", {"reserveTokens": 4096})
if os.path.exists(os.path.join(pi_dir, "themes", "foxml.json")):
    st.setdefault("theme", "foxml")
save(st_path, st)

if state != state_before:
    save(state_path, state)
for n in notes: print(n)
EOF
  # Said on the desktop too, so a change the queue or the timer makes overnight doesn't pass unseen: a default that
  # moved, and a role newly without a model (each once — the list of unfilled roles is kept until it changes).
  local moved new
  moved=$(grep -E '^(opencode|pi) default → ' "$STATE/sync-notes.txt")
  [[ -n $moved ]] && notify "🦊 Local model default changed" "$moved"
  skipped=$(grep -v '^$' <<<"$skipped" | sort -u)
  new=$(comm -13 <(sort -u "$STATE/unfilled-roles.txt" 2>/dev/null) <(printf '%s\n' "$skipped" | grep -v '^$'))
  [[ -n $new ]] && notify "🦊 A role has no model to serve" "$new"
  printf '%s\n' "$skipped" | grep -v '^$' > "$STATE/unfilled-roles.txt"
  sync_prompts
  # A download shows up without a restart: the router re-reads the preset fox-llm-serve just
  # rewrote; a loaded model stays loaded unless its own section changed.
  if [[ ${server_on:0:1} == 1 ]]; then curl -fs -m 5 -o /dev/null "http://127.0.0.1:8080/models?reload=1" || true; fi
  if [[ ${server_on:1:1} == 1 ]]; then curl -fs -m 5 -o /dev/null "http://127.0.0.1:8081/models?reload=1" || true; fi
}

# New models from Hugging Face's newest GGUF uploads (fox-llm-discover: tool-capable, fit this box). The
# MoE ones download — up to MAX_AUTO_PULLS a run, each with its abliterated twin when one exists, never
# below MIN_FREE_GB free — the rest stay in the report (--list). A model is considered once: seen-hf.txt.
# The first scan only notes what is already out, so the switch from Ollama didn't download a backlog.
do_discover() {
  mkdir -p "$STATE"
  local report="$STATE/discovered.tsv" seen="$STATE/seen-hf.txt" first=0 name src gb cls abl abl_src pulled=0 skipped=()
  [[ -f $seen ]] || first=1
  touch "$seen"
  fast_link || return 0
  log "scanning Hugging Face for new tool-capable models (a minute or two)"
  # what you already have — listed, or downloaded here — from any quantizer, is no news
  { wanted_models | awk '{print $2}'; cat "$GGUF_DIR"/.src/* 2>/dev/null | awk '{print $1}'; } > "$STATE/have.txt"
  "$DISCOVER_BIN" --have "$STATE/have.txt" > "$report.new" || { warn "discovery failed"; rm -f "$report.new"; return 1; }
  mv "$report.new" "$report"
  while IFS=$'\t' read -r name src gb cls abl abl_src; do
    grep -qxF "$name" "$seen" && continue
    echo "$name" >> "$seen"
    (( first )) && continue
    [[ $cls == moe ]] || continue                       # dense ones stay in the report only
    [[ -f $GGUF_DIR/$name.gguf ]] && continue
    if (( pulled >= MAX_AUTO_PULLS )) || (( $(free_gb) - ${gb%.*} - 1 < MIN_FREE_GB )); then
      skipped+=("$name (${gb} GB)"); continue
    fi
    log "new model: $name (${gb} GB, MoE) — downloading"
    fetch_gguf "$name" "$src" && pulled=$((pulled + 1))
    if [[ $abl != - ]] && (( $(free_gb) - ${gb%.*} - 1 >= MIN_FREE_GB )); then
      log "  + abliterated twin $abl"; fetch_gguf "$abl" "$abl_src"
    fi
  done < "$report"
  sync_configs
  local msg=""
  (( first )) && msg="First Hugging Face scan: $(wc -l < "$report") models noted (fox-llm-update --list). New ones download from the next scan on."
  (( pulled )) && msg="Downloaded $pulled new model(s)."
  (( ${#skipped[@]} )) && msg+=$'\n'"Also new, not downloaded: ${skipped[*]}"$'\n'"fox-llm-update --list"
  if [[ -n $msg ]]; then
    log "$msg"; notify "🦊 New local models" "$msg"
  else
    log "no new models since last scan"
  fi
}

# Discovery reads a few hundred Hugging Face API pages; once a week is plenty.
do_auto() {
  do_check
  do_models check-link && sync_configs
  # models still waiting for their report card (fox-llm-grade waits until no chat model is in use)
  if [[ -x $GRADE_BIN ]]; then "$GRADE_BIN" --queue >/dev/null 2>&1 || true; fi
  local report="$STATE/discovered.tsv"
  if [[ ! -f $report ]] || [[ -n $(find "$report" -mtime +6 2>/dev/null) ]]; then
    do_discover
  else
    log "discovery ran within the last week — skipping"
  fi
}

do_list() {
  local report="$STATE/discovered.tsv"
  [[ -f $report ]] || { warn "no report yet — run fox-llm-update --discover"; return 1; }
  printf 'model\tGB\tclass\tabliterated twin\tfile\n' \
    | cat - <(awk -F'\t' -v OFS='\t' '{ print $1, $3, $4, $5, $2 }' "$report") | column -t -s $'\t'
  echo; echo "class: moe = agent speed here · small = usable · slow = fits RAM, too slow for agents"
  echo "download one: add its 'model file' line to ~/.config/foxml/llm/gguf-models.txt, then fox-llm-update --models"
}

do_queue() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  mkdir -p "$dir" "${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-update"
  cat > "$dir/fox-llm-pull.service.new" <<'EOF'
[Unit]
Description=fox-llm download queue — download wanted local models (resumes after reboot, then disables itself)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fox-llm-update --queue-run
StandardOutput=append:%h/.cache/fox-llm-update/queue.log
StandardError=append:%h/.cache/fox-llm-update/queue.log
Nice=10

[Install]
WantedBy=default.target
EOF
  mv "$dir/fox-llm-pull.service.new" "$dir/fox-llm-pull.service"
  systemctl --user daemon-reload
  # restart, not `enable --now`: a queue already running keeps the code it started with, and after an
  # update that old code synced pi/opencode the old way (2026-10-14). Downloads resume where they were.
  systemctl --user enable fox-llm-pull.service && systemctl --user restart fox-llm-pull.service \
    && log "queue running — progress: tail -f ${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-update/queue.log"
}

# The service body. Downloads the first wanted model still missing, then re-reads the lists, so
# reordering or parking models in your lists takes effect at the next model, not after a whole pass.
# Each model gets QUEUE_TRIES attempts a minute apart; one that runs out is set aside for the rest of
# the pass and retried in the next one. One this llama.cpp can't load is left out until llama.cpp updates.
do_queue_run() {
  local name src cand csrc try out rc pass=1 set_aside=" "
  while :; do
    name="" src=""
    while read -r cand csrc; do
      [[ -f $GGUF_DIR/$cand.gguf || $set_aside == *" $cand "* ]] && continue
      known_incompatible "$csrc" >/dev/null && continue
      name=$cand src=$csrc; break
    done < <(wanted_models)
    if [[ -z $name ]]; then
      [[ $set_aside == " " ]] && break                  # everything wanted is downloaded
      echo "--- pass $pass left missing:$set_aside— next pass in 10 min"; sleep 600
      set_aside=" " pass=$((pass + 1)); continue
    fi
    echo "=== $(date '+%a %H:%M') $name (pass $pass)"
    for (( try = 1; try <= QUEUE_TRIES; try++ )); do
      out=$(fetch_gguf "$name" "$src" 2>&1); rc=$?
      if (( rc == 0 )); then
        echo "  done $(date '+%a %H:%M')"; notify "🦊 Model downloaded" "$(tail -1 <<<"$out")"
        sync_configs
        # its report card, in the background once no chat model is in use (fox-llm-grade --report)
        if [[ -x $GRADE_BIN ]]; then "$GRADE_BIN" --queue "$name" >/dev/null 2>&1 || true; fi
        continue 2
      fi
      if (( rc == 2 )); then echo "  $(tail -1 <<<"$out")"; continue 2; fi
      echo "  attempt $try failed: $(tail -1 <<<"$out")"; sleep 60
    done
    set_aside+="$name "
  done
  echo "ALL_DONE $(date)"
  notify "🦊 Downloads finished" "Every wanted model is downloaded."
  systemctl --user disable fox-llm-pull.service 2>/dev/null || true
}

do_full() {
  local cur new
  cur=$(ver_pi); new=$(latest_pi || true)
  if [[ -n $new && $cur != "$new" ]]; then
    sudo -v || { warn "sudo needed to update pi"; exit 1; }
    log "pi ${cur:-none} → $new"
    # both packages install a `pi` command, so the old one goes first; the example links follow in sync_configs
    if npm ls -g --depth=0 "$PI_PKG_OLD" >/dev/null 2>&1; then sudo npm uninstall -g "$PI_PKG_OLD"; fi
    sudo npm install -g "$PI_PKG@$new"
  else
    log "pi $cur is current"
  fi
  log "opencode and llama.cpp come from pacman ($(pacman -Q opencode llama-cpp 2>/dev/null | tr '\n' ' ')) — they update with pacman -Syu"

  # On a slow link a 20 GB model takes hours: hand the downloads to the background queue.
  if fast_link; then
    do_models
  else
    log "slow link — downloading in the background instead (survives reboots)"
    do_queue
  fi
  sync_configs
  log "done — pi $(ver_pi)"
}

case "${1:-}" in
  "")          do_full ;;
  --auto)      do_auto ;;
  --sync)      sync_configs ;;
  --queue)     do_queue ;;
  --queue-run) do_queue_run ;;
  --wanted)    wanted_models ;;
  --models|--check|--discover|--list)
    for a in "$@"; do
      case $a in
        --check) do_check ;; --discover) do_discover ;; --list) do_list ;;
        --models) do_models; sync_configs ;;
        *) warn "unknown arg $a"; exit 2 ;;
      esac
    done ;;
  -h|--help) sed -n '2,/^set -uo pipefail$/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *)         warn "unknown arg $1"; exit 2 ;;
esac
