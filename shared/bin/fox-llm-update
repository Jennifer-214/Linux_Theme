#!/usr/bin/env bash
# fox-llm-update — keep the local-LLM stack (ollama, pi, opencode, models) current.
#
#   fox-llm-update            full run: tools (sudo) + ollama context (sudo) + models + sync
#   fox-llm-update --auto     what the daily timer runs: --check, --models, and --discover when
#                             the last scan is over a week old. Downloads wait for a fast link.
#   fox-llm-update --models   pull missing wanted models, refresh every registry model (no sudo)
#   fox-llm-update --check    report tool updates, desktop-notify if any (no sudo)
#   fox-llm-update --discover find new tool-capable models that fit this box (fox-llm-discover),
#                             auto-pull up to MAX_AUTO_PULLS new MoE ones + abliterated twins
#   fox-llm-update --list     show the last discovery report
#   fox-llm-update --wanted   print the models this machine should have (tiered list + extras)
#   fox-llm-update --sync     wire installed models into opencode + pi; fill missing defaults
#   fox-llm-update --queue    slow link: download wanted models in the background, resuming
#                             across reboots (user service fox-llm-pull), then stop
#
# Wanted models = shared/llm/core-models.txt (RAM tier) + ~/.config/foxml/llm/extra-models.txt
# (personal, Ollama registry refs, in priority order — pulled before the core list;
# a "-model" line skips a model). Binaries are never auto-upgraded: the timer only notifies.
# --sync only ever ADDS: keys you set in opencode.json / ~/.pi/agent/*.json are left alone.
set -uo pipefail

LLM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/foxml/llm"
CORE_LIST="$LLM_DIR/core-models.txt"      # deployed from Linux_Theme shared/llm/
EXTRA_LIST="$LLM_DIR/extra-models.txt"    # personal; never in the repo
DROPIN=/etc/systemd/system/ollama.service.d/foxml-context.conf
UNIT=/etc/systemd/system/ollama.service
WORK="${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-update"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/fox-llm-update"
MODELS_DIR=/usr/share/ollama/.ollama/models
MAX_AUTO_PULLS=2     # new base models per discovery run (abliterated twins ride along)
MIN_FREE_GB=100      # never auto-pull below this much free disk
MIN_MBPS=2           # timer skips pulls on slow links (guest / hotspot Wi-Fi): 20 GB at 2 MB/s ≈ 3 h
QUEUE_TRIES=30       # --queue: per-model retries, a minute apart, before moving on
OPENCODE_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
PI_DIR="$HOME/.pi/agent"
AGENT_DEFAULT=qwen3-coder:30b   # promoted to default once installed
TITLE_MODEL=qwen2.5:3b          # opencode small_model: fits a 4 GB GPU whole

log()  { printf '\033[1;33m[fox-llm]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m[fox-llm]\033[0m %s\n' "$*" >&2; }

ver_ollama()        { ollama -v 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | tail -1; }
# The running server's version — differs from the client's mid-update.
ver_ollama_server() { curl -fs --max-time 5 localhost:11434/api/version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+'; }
latest_ollama()     { curl -fsS https://api.github.com/repos/ollama/ollama/releases/latest \
                        | python3 -I -c 'import json,sys;print(json.load(sys.stdin)["tag_name"].lstrip("v"))'; }
ver_pi()            { pi --version 2>&1 | grep -oE "[0-9]+\.[0-9]+\.[0-9]+" | head -1; }
latest_pi()         { npm view @mariozechner/pi-coding-agent version 2>/dev/null; }
ram_gb()            { awk '/^MemTotal:/{printf "%d", ($2 + 1048575) / 1048576}' "${FOX_LLM_MEMINFO:-/proc/meminfo}"; }

# Same tiers as fox-install's models module.
ram_tier() {
  local ram; ram=$(ram_gb)
  if (( ram >= 32 )); then echo large; elif (( ram >= 16 )); then echo medium; else echo small; fi
}

# "-model" lines in extra-models.txt: core models this machine should not pull.
skipped_models() {
  [[ -f $EXTRA_LIST ]] && awk '/^[[:space:]]*-/ { sub(/^[[:space:]]*-/, ""); printf "%s ", $1 }' "$EXTRA_LIST"
}

# Personal extras first (they are deliberate picks, in priority order), then the
# RAM-tiered core list; "-model" lines drop a model from both.
wanted_models() {
  local tier; tier=$(ram_tier)
  {
    if [[ -f $EXTRA_LIST ]]; then
      awk '!/^[[:space:]]*(#|$)/ { print $1 }' "$EXTRA_LIST"
    fi
    if [[ -f $CORE_LIST ]]; then
      awk -v t="$tier" '
        /^# tier:/ { b = $3; next }
        /^[[:space:]]*(#|$)/ { next }
        b == t || b == "all" { print $1 }' "$CORE_LIST"
    fi
  } | awk -v skip="$(skipped_models)" '
      BEGIN { n = split(skip, s, " "); for (i = 1; i <= n; i++) drop[s[i]] = 1 }
      /^-/ { next }
      !($0 in drop) && !seen[$0]++'
}

# On the registry? Custom `ollama create` models are not, and are skipped.
on_registry() {
  local name=${1%%:*} tag=latest
  [[ $1 == *:* ]] && tag=${1##*:}
  [[ $name == */* ]] || name="library/$name"
  [[ $(curl -s -o /dev/null -w '%{http_code}' \
        -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
        "https://registry.ollama.ai/v2/$name/manifests/$tag") == 200 ]]
}

# Download speed from the Ollama registry in MB/s (12 s sample of a real model blob).
link_mbps() {
  local digest
  digest=$(curl -fs --max-time 10 -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
             https://registry.ollama.ai/v2/library/gpt-oss/manifests/20b \
           | python3 -I -c 'import json,sys;print(next(l["digest"] for l in json.load(sys.stdin)["layers"] if l["mediaType"].endswith(".model")))') || { echo 0; return; }
  curl -sL -o /dev/null --max-time 12 -w '%{speed_download}' \
    "https://registry.ollama.ai/v2/library/gpt-oss/blobs/$digest" | awk '{printf "%d", $1/1e6}'
}

fast_link() {
  local mbps; mbps=$(link_mbps)
  if (( mbps < MIN_MBPS )); then
    warn "registry link is ~${mbps} MB/s (< ${MIN_MBPS}) — skipping downloads; rerun on a faster network"
    warn "or download in the background anyway: fox-llm-update --queue"
    return 1
  fi
}

ollama_up() { ollama list >/dev/null 2>&1; }

# Prints the last status lines; exit 0 only when the pull reported success.
pull_quiet() {
  local out
  out=$(ollama pull "$1" 2>&1 | tr '\r' '\n' | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' \
          | grep -vE '^pulling [0-9a-f]+: +[0-9]+%' | grep -v '^[[:space:]]*$' | tail -3)
  printf '%s\n' "$out"
  grep -q '^success' <<<"$out"
}

free_gb() { df -BG --output=avail "${MODELS_DIR%/.ollama/models}" 2>/dev/null | tail -1 | tr -dc 0-9; }

do_check() {
  local msgs=() cur new
  cur=$(ver_ollama); new=$(latest_ollama || true)
  [[ -n $new && $cur != "$new" ]] && msgs+=("ollama $cur → $new")
  cur=$(ver_pi); new=$(latest_pi || true)
  [[ -n $new && $cur != "$new" ]] && msgs+=("pi $cur → $new")
  if command -v checkupdates >/dev/null; then
    new=$(checkupdates 2>/dev/null | awk '$1=="opencode"{print $2" → "$4}')
    [[ -n $new ]] && msgs+=("opencode $new (pacman -Syu)")
  fi
  if ((${#msgs[@]})); then
    log "updates available: ${msgs[*]}"
    command -v notify-send >/dev/null && \
      notify-send -a fox-llm "🦊 LLM tool updates" "$(printf '%s\n' "${msgs[@]}")
Run: fox-llm-update"
  else
    log "ollama, pi, opencode are current"
  fi
}

# $1 = "check-link" for the timer path; the interactive full run pulls regardless.
do_models() {
  ollama_up || { warn "ollama is not running — skipping model refresh"; return 1; }
  [[ ${1:-} == check-link ]] && { fast_link || return 0; }
  local m have
  have=$(ollama list | awk 'NR>1{print $1}')
  while read -r m; do
    grep -qxF "$m" <<<"$have" || { log "pulling missing model $m"; pull_quiet "$m"; }
  done < <(wanted_models)
  for m in $have; do
    if on_registry "$m"; then
      log "refreshing $m"; pull_quiet "$m"
    else
      log "skip $m (local/custom model)"
    fi
  done
}

# pi's bundled example extensions/agents/prompts, wired in without vendoring copies:
# symlinks track the installed pi version; agents are copied once with their Claude
# `model:` pins stripped so subagents inherit the local default. Existing files win.
sync_pi_resources() {
  command -v npm >/dev/null || return 0
  local ex; ex="$(npm root -g 2>/dev/null)/@mariozechner/pi-coding-agent/examples/extensions"
  [[ -d $ex ]] || return 0
  mkdir -p "$PI_DIR/extensions/subagent" "$PI_DIR/agents" "$PI_DIR/prompts"
  ln -sfn "$ex/git-checkpoint.ts"  "$PI_DIR/extensions/git-checkpoint.ts"
  ln -sfn "$ex/plan-mode"          "$PI_DIR/extensions/plan-mode"
  ln -sfn "$ex/subagent/index.ts"  "$PI_DIR/extensions/subagent/index.ts"
  ln -sfn "$ex/subagent/agents.ts" "$PI_DIR/extensions/subagent/agents.ts"
  local f dst
  for f in "$ex"/subagent/agents/*.md; do
    dst="$PI_DIR/agents/$(basename "$f")"
    [[ -e $dst ]] || grep -v '^model:' "$f" > "$dst"
  done
  for f in "$ex"/subagent/prompts/*.md; do
    dst="$PI_DIR/prompts/$(basename "$f")"
    [[ -e $dst ]] || cp "$f" "$dst"
  done
}

# Wire installed (non-embedding) models into opencode + pi and fill defaults that are
# missing. Only adds: an existing key is never changed, except a model default still
# pointing at a model that is no longer installed, or the old stand-in once the agent
# default lands. First touch of an existing opencode.json keeps a .foxml-bak copy.
sync_configs() {
  local installed=""
  ollama_up && installed=$(ollama list 2>/dev/null | awk 'NR>1 && $1 !~ /embed/ {print $1}')
  [[ -f $OPENCODE_JSON && ! -e $OPENCODE_JSON.foxml-bak ]] && cp -p "$OPENCODE_JSON" "$OPENCODE_JSON.foxml-bak"
  mkdir -p "$PI_DIR"
  sync_pi_resources
  # stdin carries the script, so the model list goes in as an argument.
  python3 -I - "$OPENCODE_JSON" "$PI_DIR" "$installed" "$AGENT_DEFAULT" "$TITLE_MODEL" <<'EOF'
import json, os, sys
oc_path, pi_dir, installed_raw, agent_default, title_model = sys.argv[1:6]
installed = [l.strip() for l in installed_raw.splitlines() if l.strip()]
STANDIN = "qwen2.5-coder:14b"   # used while the agent default downloads
LIMIT = {"context": 32768, "output": 8192}
READ_ONLY = ["ls*", "pwd", "cat *", "head *", "tail *", "wc *", "file *", "stat *", "tree*",
             "rg *", "grep *", "fd *", "which *", "type *",   # not find: -delete / -exec write
             "git status*", "git diff*", "git log*", "git show*", "git branch*", "git blame*"]
notes = []

def load(p, default):
    try:
        with open(p) as f: return json.load(f)
    except FileNotFoundError:
        return default

def save(p, d):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p + ".new", "w") as f: f.write(json.dumps(d, indent=2) + "\n")
    os.replace(p + ".new", p)

def pick_default(current):
    """Keep the current default unless it is gone or is the stand-in that the agent default replaces."""
    if current and (not installed or current in installed) and not (current == STANDIN and agent_default in installed):
        return current
    for cand in (agent_default, STANDIN):
        if cand in installed: return cand
    return current or (installed[0] if installed else None)

# ── opencode ──
oc = load(oc_path, {"$schema": "https://opencode.ai/config.json"})
prov = oc.setdefault("provider", {}).setdefault("ollama", {})
prov.setdefault("name", "Ollama (Local)")
prov.setdefault("npm", "@ai-sdk/openai-compatible")
prov.setdefault("options", {"baseURL": "http://localhost:11434/v1"})
models = prov.setdefault("models", {})
for m in installed:
    if m not in models:
        models[m] = {"name": m}; notes.append(f"opencode: + {m}")
    models[m].setdefault("limit", dict(LIMIT))
# A default on another provider (anthropic/…, openai/…) is the user's choice: never touched.
if not oc.get("model") or oc["model"].startswith("ollama/"):
    cur = (oc.get("model") or "").removeprefix("ollama/") or None
    new = pick_default(cur)
    if new and new != cur:
        oc["model"] = f"ollama/{new}"; notes.append(f"opencode default → {new}")
if "small_model" not in oc and title_model in installed:
    oc["small_model"] = f"ollama/{title_model}"
oc.setdefault("autoupdate", False)          # pacman owns opencode; the timer reports updates
oc.setdefault("share", "disabled")          # never upload sessions
oc.setdefault("permission", {"edit": "ask", "webfetch": "ask",
                             "bash": {"*": "ask", **{k: "allow" for k in READ_ONLY}}})
save(oc_path, oc)

# ── pi ──
pm_path = os.path.join(pi_dir, "models.json")
pm = load(pm_path, {})
pprov = pm.setdefault("providers", {}).setdefault("ollama", {})
pprov.setdefault("baseUrl", "http://localhost:11434/v1")
pprov.setdefault("api", "openai-completions")
pprov.setdefault("apiKey", "ollama")
pprov.setdefault("compat", {"supportsDeveloperRole": False, "supportsReasoningEffort": False})
pms = pprov.setdefault("models", [])
have = {x["id"] for x in pms}
for m in installed:
    if m not in have:
        pms.append({"id": m, "contextWindow": LIMIT["context"], "maxTokens": LIMIT["output"]})
        notes.append(f"pi: + {m}")
save(pm_path, pm)

st_path = os.path.join(pi_dir, "settings.json")
st = load(st_path, {})
st.setdefault("defaultProvider", "ollama")
if st["defaultProvider"] == "ollama":
    cur = st.get("defaultModel")
    new = pick_default(cur)
    if new and new != cur:
        st["defaultModel"] = new; notes.append(f"pi default → {new}")
st.setdefault("enableInstallTelemetry", False)
# pi's defaults assume a 200k window; these fit the 32k local context.
st.setdefault("compaction", {"enabled": True, "reserveTokens": 4096, "keepRecentTokens": 8000})
st.setdefault("branchSummary", {"reserveTokens": 4096})
if os.path.exists(os.path.join(pi_dir, "themes", "foxml.json")):
    st.setdefault("theme", "foxml")
save(st_path, st)

for n in notes: print(n)
EOF
}

do_discover() {
  mkdir -p "$STATE"
  local report="$STATE/discovered.tsv" seen="$STATE/seen.txt" have ref gb cls abl pulled=0 skipped=()
  touch "$seen"
  fast_link || return 0
  log "scanning ollama.com for new tool-capable models (takes a few minutes)"
  fox-llm-discover --pages 6 > "$report.new" || { warn "discovery failed"; return 1; }
  mv "$report.new" "$report"
  have=$(ollama list 2>/dev/null | awk 'NR>1{print $1}')
  while IFS=$'\t' read -r ref gb cls abl; do
    grep -qxF "${ref%%:*}" "$seen" && continue
    echo "${ref%%:*}" >> "$seen"
    [[ $cls == moe ]] || continue                       # dense ones stay in the report only
    grep -qxF "$ref" <<<"$have" && continue
    if (( pulled >= MAX_AUTO_PULLS )) || (( $(free_gb) - ${gb%.*} - 1 < MIN_FREE_GB )); then
      skipped+=("$ref (${gb} GB)"); continue
    fi
    log "new model: $ref (${gb} GB, MoE) — pulling"; pull_quiet "$ref"; pulled=$((pulled + 1))
    if [[ $abl != - ]] && (( $(free_gb) - ${gb%.*} - 1 >= MIN_FREE_GB )); then
      log "  + abliterated twin $abl"; pull_quiet "$abl"
    fi
  done < "$report"
  sync_configs
  local msg=""
  (( pulled )) && msg="Pulled $pulled new model(s)."
  (( ${#skipped[@]} )) && msg+=$'\n'"Also new, not pulled: ${skipped[*]}"$'\n'"fox-llm-update --list"
  if [[ -n $msg ]]; then
    log "$msg"; command -v notify-send >/dev/null && notify-send -a fox-llm "🦊 New local models" "$msg"
  else
    log "no new models since last scan"
  fi
}

# Discovery scrapes ~120 ollama.com pages; once a week is plenty.
do_auto() {
  do_check
  do_models check-link && sync_configs
  local report="$STATE/discovered.tsv"
  if [[ ! -f $report ]] || [[ -n $(find "$report" -mtime +6 2>/dev/null) ]]; then
    do_discover
  else
    log "discovery ran within the last week — skipping"
  fi
}

do_list() {
  local report="$STATE/discovered.tsv"
  [[ -f $report ]] || { warn "no report yet — run fox-llm-update --discover"; return 1; }
  printf 'model\tGB\tclass\tabliterated\n' | cat - "$report" | column -t -s $'\t'
  echo; echo "class: moe = agent speed here · small = usable · slow = fits RAM, too slow for agents"
}

do_queue() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  mkdir -p "$dir" "${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-update"
  cat > "$dir/fox-llm-pull.service.new" <<'EOF'
[Unit]
Description=fox-llm pull queue — download wanted local models (resumes after reboot, then disables itself)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fox-llm-update --queue-run
StandardOutput=append:%h/.cache/fox-llm-update/queue.log
StandardError=append:%h/.cache/fox-llm-update/queue.log
Nice=10

[Install]
WantedBy=default.target
EOF
  mv "$dir/fox-llm-pull.service.new" "$dir/fox-llm-pull.service"
  systemctl --user daemon-reload
  systemctl --user enable --now fox-llm-pull.service \
    && log "queue running — progress: tail -f ${XDG_CACHE_HOME:-$HOME/.cache}/fox-llm-update/queue.log"
}

# The service body. Downloads the first wanted model that is still missing, then re-reads
# the list — so reordering or parking models in extra-models.txt takes effect at the next
# model, not after a whole pass. Each model gets QUEUE_TRIES attempts a minute apart; one that
# runs out is set aside for the rest of the pass and retried in the next one. An Ollama too
# old for the registry (HTTP 412) stops the queue with a notice; `fox-llm-update` restarts it.
do_queue_run() {
  local m cand try out have pass=1 set_aside=" "
  while :; do
    have=$(ollama list 2>/dev/null | awk 'NR>1{print $1}')
    m=""
    while read -r cand; do
      grep -qxF "$cand" <<<"$have" && continue
      [[ $set_aside == *" $cand "* ]] && continue
      m=$cand; break
    done < <(wanted_models)
    if [[ -z $m ]]; then
      [[ $set_aside == " " ]] && break                  # everything wanted is installed
      echo "--- pass $pass left missing:$set_aside— next pass in 10 min"; sleep 600
      set_aside=" " pass=$((pass + 1)); continue
    fi
    echo "=== $(date '+%a %H:%M') $m (pass $pass)"
    for (( try = 1; try <= QUEUE_TRIES; try++ )); do
      out=$(pull_quiet "$m") && { echo "  done $(date '+%a %H:%M')"; sync_configs; continue 2; }
      if grep -q 'newer version of Ollama' <<<"$out"; then
        local server; server=$(ver_ollama_server)
        warn "ollama server ${server:-?} is too old for the registry — run: fox-llm-update"
        command -v notify-send >/dev/null && notify-send -a fox-llm "🦊 Model downloads paused" \
          "Ollama ${server:-?} is too old for the registry. Run: fox-llm-update"
        exit 1
      fi
      echo "  attempt $try failed: $(tail -1 <<<"$out")"; sleep 60
    done
    set_aside+="$m "
  done
  echo "ALL_DONE $(date)"
  systemctl --user disable fox-llm-pull.service 2>/dev/null || true
}

update_ollama() {
  local cur new
  cur=$(ver_ollama); new=$(latest_ollama || true)
  if [[ -z $new ]]; then warn "could not reach GitHub for the ollama version"; return 1; fi
  if [[ $cur == "$new" ]]; then log "ollama $cur is current"; return 1; fi
  log "ollama $cur → $new"
  mkdir -p "$WORK"
  curl -fsSL https://ollama.com/install.sh -o "$WORK/install.sh" || return 1
  # install.sh rewrites the unit file; keep ours (PATH line etc.). Drop-ins are untouched.
  sudo cp -a "$UNIT" "$WORK/ollama.service.keep"
  sh "$WORK/install.sh"
  sudo cp -a "$WORK/ollama.service.keep" "$UNIT"
  sudo rm -f "$WORK/ollama.service.keep"
}

# Same file + tiers as fox-install's ollama_hardening; an existing drop-in that already
# sets both values wins (it may be hand-tuned). Returns 0 only when it wrote something.
tune_ollama() {
  if [[ -f $DROPIN ]] && grep -q OLLAMA_CONTEXT_LENGTH "$DROPIN" && grep -q OLLAMA_KEEP_ALIVE "$DROPIN"; then
    log "ollama context drop-in already in place"; return 1
  fi
  local ctx=8192 ram; ram=$(ram_gb)
  (( ram >= 16 )) && ctx=16384
  (( ram >= 32 )) && ctx=32768
  log "writing $DROPIN (context $ctx)"
  printf '[Service]\nEnvironment="OLLAMA_CONTEXT_LENGTH=%s"\nEnvironment="OLLAMA_KEEP_ALIVE=10m"\n' "$ctx" \
    | sudo tee "$DROPIN.tmp" >/dev/null && sudo mv "$DROPIN.tmp" "$DROPIN"
}

do_full() {
  sudo -v || { warn "sudo needed for the full run"; exit 1; }
  local changed=0
  update_ollama && changed=1
  tune_ollama && changed=1
  if (( changed )); then
    log "restarting ollama"
    sudo systemctl daemon-reload && sudo systemctl restart ollama && sleep 3
  fi

  local cur new
  cur=$(ver_pi); new=$(latest_pi || true)
  if [[ -n $new && $cur != "$new" ]]; then
    log "pi ${cur:-none} → $new"; sudo npm install -g "@mariozechner/pi-coding-agent@$new"
  else
    log "pi $cur is current"
  fi
  log "opencode comes from pacman ($(pacman -Q opencode 2>/dev/null)) — updates with pacman -Syu"

  # On a slow link a 20 GB model takes hours: hand the downloads to the background queue.
  if fast_link; then
    do_models
  else
    log "slow link — downloading in the background instead (survives reboots)"
    do_queue
  fi
  sync_configs
  log "done — ollama $(ver_ollama), pi $(ver_pi)"
}

case "${1:-}" in
  "")          do_full ;;
  --auto)      do_auto ;;
  --sync)      sync_configs ;;
  --queue)     do_queue ;;
  --queue-run) do_queue_run ;;
  --wanted)    wanted_models ;;
  --models|--check|--discover|--list)
    for a in "$@"; do
      case $a in
        --check) do_check ;; --discover) do_discover ;; --list) do_list ;;
        --models) do_models; sync_configs ;;
        *) warn "unknown arg $a"; exit 2 ;;
      esac
    done ;;
  -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)         warn "unknown arg $1"; exit 2 ;;
esac
