# ╭──────────────────────────────────────────────────────────────────╮
# │                    Fox ML Zathura Theme                         │
# ╰──────────────────────────────────────────────────────────────────╯

# Colors
set default-bg                  "rgba({{BG_R}},{{BG_G}},{{BG_B}},{{ZATHURA_BG_ALPHA}})"
set default-fg                  "#{{FG}}"

set statusbar-bg                "#{{BG_DARK}}"
set statusbar-fg                "#{{FG}}"

set inputbar-bg                 "#{{BG}}"
set inputbar-fg                 "#{{PRIMARY}}"

set notification-bg             "#{{BG}}"
set notification-fg             "#{{FG}}"
set notification-error-bg       "#{{BG}}"
set notification-error-fg       "#{{RED}}"
set notification-warning-bg     "#{{BG}}"
set notification-warning-fg     "#{{YELLOW}}"

set highlight-color             "{{ZATHURA_HIGHLIGHT}}"
set highlight-active-color      "{{ZATHURA_HIGHLIGHT_ACTIVE}}"

set completion-bg               "#{{BG}}"
set completion-fg               "#{{FG}}"
set completion-highlight-bg     "{{ZATHURA_HIGHLIGHT}}"
set completion-highlight-fg     "#{{FG}}"
set completion-group-bg         "#{{BG_DARK}}"
set completion-group-fg         "#{{PRIMARY}}"

set index-bg                    "#{{BG}}"
set index-fg                    "#{{FG}}"
set index-active-bg             "#{{SELECTION}}"
set index-active-fg             "#{{FG}}"

set recolor-lightcolor          "#{{BG}}"
set recolor-darkcolor           "#{{FG}}"
set recolor                     "{{ZATHURA_RECOLOR}}"
set recolor-keephue             "false"

# Appearance
set font                        "{{FONT_FAMILY}} 11"
set selection-clipboard         "clipboard"
set window-title-basename       "true"
set statusbar-home-tilde        "true"
set guioptions                  "sv"
