{
  "$schema": "https://raw.githubusercontent.com/badlogic/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "foxml",
  "vars": {
    "bg": "#{{BG}}",
    "bgDark": "#{{BG_DARK}}",
    "bgHighlight": "#{{BG_HIGHLIGHT}}",
    "bgInput": "#{{TMUX_ACTIVE_BG}}",
    "selection": "#{{SELECTION}}",
    "fg": "#{{FG}}",
    "fgPastel": "#{{FG_PASTEL}}",
    "fgDim": "#{{FG_DIM}}",
    "comment": "#{{COMMENT}}",
    "primary": "#{{PRIMARY}}",
    "secondary": "#{{SECONDARY}}",
    "accent": "#{{ACCENT}}",
    "surface": "#{{SURFACE}}",
    "red": "#{{RED}}",
    "redBright": "#{{RED_BRIGHT}}",
    "green": "#{{GREEN}}",
    "ok": "#{{GREEN_BRIGHT}}",
    "yellow": "#{{YELLOW}}",
    "blue": "#{{BLUE}}",
    "blueBright": "#{{BLUE_BRIGHT}}",
    "cyan": "#{{CYAN}}",
    "diffAdd": "#{{DIFF_ADD}}",
    "diffDelete": "#{{DIFF_DELETE}}",
    "wheat": "#{{WHEAT}}",
    "clay": "#{{CLAY}}",
    "border": "#{{PI_BORDER}}",
    "muted": "#{{PI_MUTED}}",
    "error": "#{{PI_ERROR}}",
    "mdCode": "#{{PI_MD_CODE}}",
    "synComment": "#{{NVIM_SYN_COMMENT}}",
    "synKeyword": "#{{PI_SYN_KEYWORD}}",
    "synFunction": "#{{PI_SYN_FUNCTION}}",
    "synVariable": "#{{NVIM_SYN_VAR}}",
    "synString": "#{{PI_SYN_STRING}}",
    "synNumber": "#{{PI_SYN_NUMBER}}",
    "synType": "#{{NVIM_SYN_TYPE}}",
    "synOperator": "#{{PI_SYN_OPERATOR}}"
  },
  "colors": {
    "accent": "primary",
    "border": "border",
    "borderAccent": "primary",
    "borderMuted": "comment",
    "success": "ok",
    "error": "error",
    "warning": "yellow",
    "muted": "muted",
    "dim": "comment",
    "text": "fg",
    "thinkingText": "fgDim",

    "selectedBg": "selection",
    "userMessageBg": "bgInput",
    "userMessageText": "fg",
    "customMessageBg": "bgDark",
    "customMessageText": "fg",
    "customMessageLabel": "secondary",
    "toolPendingBg": "bgDark",
    "toolSuccessBg": "diffAdd",
    "toolErrorBg": "diffDelete",
    "toolTitle": "primary",
    "toolOutput": "fgPastel",

    "mdHeading": "primary",
    "mdLink": "blueBright",
    "mdLinkUrl": "blue",
    "mdCode": "mdCode",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "border",
    "mdQuote": "comment",
    "mdQuoteBorder": "border",
    "mdHr": "border",
    "mdListBullet": "primary",

    "toolDiffAdded": "ok",
    "toolDiffRemoved": "red",
    "toolDiffContext": "muted",

    "syntaxComment": "synComment",
    "syntaxKeyword": "synKeyword",
    "syntaxFunction": "synFunction",
    "syntaxVariable": "synVariable",
    "syntaxString": "synString",
    "syntaxNumber": "synNumber",
    "syntaxType": "synType",
    "syntaxOperator": "synOperator",
    "syntaxPunctuation": "fgPastel",

    "thinkingOff": "border",
    "thinkingMinimal": "comment",
    "thinkingLow": "muted",
    "thinkingMedium": "secondary",
    "thinkingHigh": "primary",
    "thinkingXhigh": "accent",

    "bashMode": "yellow"
  },
  "export": {
    "pageBg": "bg",
    "cardBg": "bgDark",
    "infoBg": "bgHighlight"
  }
}
