{
  "$schema": "https://raw.githubusercontent.com/badlogic/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "foxml",
  "vars": {
    "bg": "#{{BG}}",
    "bgDark": "#{{BG_DARK}}",
    "bgHighlight": "#{{BG_HIGHLIGHT}}",
    "bgInput": "#{{TMUX_ACTIVE_BG}}",
    "selection": "#{{SELECTION}}",
    "fg": "#{{FG}}",
    "fgPastel": "#{{FG_PASTEL}}",
    "fgDim": "#{{FG_DIM}}",
    "comment": "#{{COMMENT}}",
    "primary": "#{{PRIMARY}}",
    "secondary": "#{{SECONDARY}}",
    "accent": "#{{ACCENT}}",
    "surface": "#{{SURFACE}}",
    "red": "#{{RED}}",
    "redBright": "#{{RED_BRIGHT}}",
    "green": "#{{GREEN}}",
    "ok": "#{{GREEN_BRIGHT}}",
    "yellow": "#{{YELLOW}}",
    "blue": "#{{BLUE}}",
    "blueBright": "#{{BLUE_BRIGHT}}",
    "cyan": "#{{CYAN}}",
    "diffAdd": "#{{DIFF_ADD}}",
    "diffDelete": "#{{DIFF_DELETE}}",
    "wheat": "#{{WHEAT}}",
    "clay": "#{{CLAY}}"
  },
  "colors": {
    "accent": "primary",
    "border": "surface",
    "borderAccent": "primary",
    "borderMuted": "comment",
    "success": "ok",
    "error": "red",
    "warning": "yellow",
    "muted": "wheat",
    "dim": "comment",
    "text": "fg",
    "thinkingText": "fgDim",

    "selectedBg": "selection",
    "userMessageBg": "bgInput",
    "userMessageText": "fg",
    "customMessageBg": "bgDark",
    "customMessageText": "fg",
    "customMessageLabel": "secondary",
    "toolPendingBg": "bgDark",
    "toolSuccessBg": "diffAdd",
    "toolErrorBg": "diffDelete",
    "toolTitle": "primary",
    "toolOutput": "fgPastel",

    "mdHeading": "primary",
    "mdLink": "blueBright",
    "mdLinkUrl": "blue",
    "mdCode": "cyan",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "surface",
    "mdQuote": "comment",
    "mdQuoteBorder": "surface",
    "mdHr": "surface",
    "mdListBullet": "primary",

    "toolDiffAdded": "ok",
    "toolDiffRemoved": "red",
    "toolDiffContext": "wheat",

    "syntaxComment": "comment",
    "syntaxKeyword": "primary",
    "syntaxFunction": "yellow",
    "syntaxVariable": "fg",
    "syntaxString": "ok",
    "syntaxNumber": "clay",
    "syntaxType": "cyan",
    "syntaxOperator": "secondary",
    "syntaxPunctuation": "fgPastel",

    "thinkingOff": "surface",
    "thinkingMinimal": "comment",
    "thinkingLow": "wheat",
    "thinkingMedium": "secondary",
    "thinkingHigh": "primary",
    "thinkingXhigh": "accent",

    "bashMode": "yellow"
  },
  "export": {
    "pageBg": "bg",
    "cardBg": "bgDark",
    "infoBg": "bgHighlight"
  }
}
