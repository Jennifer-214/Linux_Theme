{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        {{FASTFETCH_LOGO}},
        "color": {
            "1": "38;5;{{ANSI_ACCENT1}}",
            "2": "38;5;{{ANSI_ACCENT2}}"
        }
    },
    "display": {
        "separator": "  ",
        "key": { "width": {{FASTFETCH_KEY_WIDTH}} },
        "color": {
            "keys": "38;5;{{FASTFETCH_KEY_INK}}",
            "output": "38;5;{{FASTFETCH_OUTPUT_INK}}"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "key": " "
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "{{FASTFETCH_KEY_OS}}"
        },
        {
            "type": "kernel",
            "key": "{{FASTFETCH_KEY_KERNEL}}"
        },
        {
            "type": "wm",
            "key": "{{FASTFETCH_KEY_WM}}"
        },
        {
            "type": "terminal",
            "key": "{{FASTFETCH_KEY_TERMINAL}}"
        },
        {
            "type": "shell",
            "key": "{{FASTFETCH_KEY_SHELL}}"
        },
        {
            "type": "uptime",
            "key": "{{FASTFETCH_KEY_UPTIME}}"
        },
        {
            "type": "battery",
            "key": "{{FASTFETCH_KEY_BATTERY}}"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "cpu",
            "key": "{{FASTFETCH_KEY_CPU}}"
        },
        {
            "type": "gpu",
            "key": "{{FASTFETCH_KEY_GPU}}"
        },
        {
            "type": "memory",
            "key": "{{FASTFETCH_KEY_MEMORY}}"
        },
        {
            "type": "disk",
            "key": "{{FASTFETCH_KEY_DISK}}",
            "folders": "/"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "colors",
            "paddingLeft": 2
        }
    ]
}
