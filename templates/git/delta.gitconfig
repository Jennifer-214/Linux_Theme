; FoxML — delta pager + diff colors
; Included from ~/.gitconfig via [include] path = …/delta-foxml.gitconfig
; Re-rendered on every theme swap, so colors track the active palette.

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictStyle = zdiff3

[delta]
	navigate = {{SHOW_WELCOME}}
	line-numbers = {{SHOW_WELCOME}}
	side-by-side = false
	syntax-theme = Fox ML
	features = {{DELTA_LABEL_STYLE}}

	minus-style                   = syntax "#{{DIFF_DELETE}}"
	minus-emph-style              = syntax "#{{SELECTION}}"
	plus-style                    = syntax "#{{DIFF_ADD}}"
	plus-emph-style               = syntax "#{{NVIM_SEL}}"

	hunk-header-decoration-style  = "#{{SURFACE}}" box

	line-numbers-minus-style      = "#{{RED}}"
	line-numbers-plus-style       = "#{{GREEN}}"
	line-numbers-zero-style       = "#{{COMMENT}}"
	line-numbers-left-style       = "#{{SURFACE}}"
	line-numbers-right-style      = "#{{SURFACE}}"

	blame-palette = "#{{BG}}" "#{{BG_HIGHLIGHT}}" "#{{BG_ALT}}" "#{{SURFACE}}"

[delta "foxml-standard"]
	file-style = "#{{PRIMARY}}" bold
	file-decoration-style = "#{{SURFACE}}" ul
	hunk-header-style = "#{{ACCENT}}" bold

[delta "foxml-notebook"]
	file-style = "#{{FG}}" "#{{SELECTION}}" bold
	file-decoration-style = "#{{ROFI_BORDER}}" ul
	hunk-header-style = "#{{FG}}" line-number
	hunk-header-line-number-style = "#{{COMMENT}}"

; Paper history is an opt-in format; existing Git layouts remain available.
[log]
    graphColors = "#{{EZA_ICON_FG}},#{{FG_DIM}}"
[pretty]
    paper = "%C(#{{FG_DIM}})%h%C(reset)  %C(#{{FG}})%s%C(reset) %C(#{{FG}} #{{SELECTION}})%(decorate:prefix=%x20,suffix=%x20,tag=,separator= · )%C(reset) %C(#{{FG_DIM}})%cr%C(reset)"

[color "decorate"]
    HEAD = "#{{FG}} #{{SELECTION}}"
    branch = "#{{FG}} #{{SELECTION}}"
    remoteBranch = "#{{FG}} #{{SELECTION}}"
    tag = "#{{FG}} #{{SELECTION}}"
