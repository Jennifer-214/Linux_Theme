font={{FONT_FAMILY}} 10
background-color=#{{BG}}{{POPUP_BG_OPACITY_HEX}}
text-color=#{{PRIMARY}}
border-color=#{{BLUSH}}
# OSD progress bar (volume / brightness) — mako defaults to blue,
# which breaks theme cohesion. `over <color>` overlays the bar onto
# the bubble background using the blush accent at 50% opacity.
progress-color=over #{{BLUSH}}80
border-size={{BORDER_SIZE}}
border-radius={{ROUNDING}}
padding=14
margin=14
width=360
# 6 lanes (was 3) so multi-pane agent bursts don't queue behind a long
# critical popup. With max-visible=3 + critical timeout=15s, a single
# "Claude needs input" notification holds a slot for 15s while subsequent
# turn-completes and subagent-done events queue invisibly — they then
# drip onto the screen seconds-to-minutes after the actual event.
max-visible=6
default-timeout=4000
ignore-timeout=1
icon-path=/usr/share/icons/{{MAKO_ICON_THEME}}

[urgency=low]
background-color=#{{BG}}{{POPUP_BG_OPACITY_HEX}}
text-color=#{{PRIMARY}}
border-color=#{{BLUSH}}80
default-timeout=2000

[urgency=critical]
background-color=#{{BG}}{{POPUP_BG_OPACITY_HEX}}
text-color=#{{PRIMARY}}
border-color=#{{RED}}
default-timeout=15000

# Workspace OSD (focus-pulse). ignore-timeout=1 above discards the sender's
# own -t 800, so the short lifetime has to be set here. Paired with the
# synchronous hint in focus-pulse.sh, this shows exactly one transient chip
# per switch instead of a growing stack.
[app-name=focus-pulse]
background-color=#{{BG}}{{POPUP_BG_OPACITY_HEX}}
text-color=#{{ACCENT}}
border-color=#{{SECONDARY}}80
default-timeout=900

[app-name=Spotify]
border-color=#{{ACCENT}}
default-timeout=4000

[app-name="com.spotify.Client"]
border-color=#{{ACCENT}}
default-timeout=4000

# AI agents — both Claude and Gemini share the primary peach accent
# so notification chrome reads as "an agent is talking to you", not
# "which agent is talking." Critical urgency (Notification hook,
# i.e. permission/input prompts) still gets the red border from the
# urgency=critical block above.
[app-name=Claude]
border-color=#{{PRIMARY}}
default-timeout=6000

[app-name=Gemini]
border-color=#{{PRIMARY}}
default-timeout=6000
