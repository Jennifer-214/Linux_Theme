font={{FONT_FAMILY}} 10
# Title + body layout (Paper writes the title in the handwriting italic, like a note)
format={{MAKO_FORMAT}}
background-color=#{{BG}}{{POPUP_BG_OPACITY_HEX}}
text-color=#{{PRIMARY}}
border-color=#{{MAKO_BORDER}}
# OSD progress bar (volume / brightness) — mako defaults to blue,
# which breaks theme cohesion. `over <color>` overlays the bar onto
# the bubble background using the blush accent at 50% opacity.
progress-color=over #{{BLUSH}}80
border-size={{BORDER_SIZE}}
border-radius={{ROUNDING}}
padding={{MAKO_PADDING}}
margin={{MAKO_MARGIN}}
outer-margin={{MAKO_OUTER_MARGIN}}
text-alignment={{MAKO_TEXT_ALIGN}}
icon-location={{MAKO_ICON_LOCATION}}
# Stock Mako ignores this optional outline directive.
# foxml-paper-shape={{MAKO_PAPER_SHAPE}}
width=360
# Six lanes keep bursts of agent notices from queuing out of sight.
max-visible=6
# Every notice uses the same four-second lifetime, including critical notices,
# agent results and OSDs. Ignore sender timeouts so none can stay indefinitely.
default-timeout=4000
ignore-timeout=1
icon-path=/usr/share/icons/{{MAKO_ICON_THEME}}

# Only Paper matches this rule; OSDs keep their own compact formats below.
[summary~={{MAKO_STAMP_SUMMARIES}}]
# foxml-paper-stamp=1
height=124
format=<span font_family="{{FONT_FAMILY}}" size="x-small" weight="semibold" letter_spacing="1024" foreground="#{{FG}}" background="#{{SELECTION}}"> RECEIVED </span>\n{{MAKO_FORMAT}}

[summary~={{MAKO_STAMP_SUMMARIES}} category=foxml.saved]
format=<span font_family="{{FONT_FAMILY}}" size="x-small" weight="semibold" letter_spacing="1024" foreground="#{{FG}}" background="#{{SELECTION}}"> SAVED </span>\n{{MAKO_FORMAT}}

[summary~={{MAKO_STAMP_SUMMARIES}} category=foxml.copied]
format=<span font_family="{{FONT_FAMILY}}" size="x-small" weight="semibold" letter_spacing="1024" foreground="#{{FG}}" background="#{{SELECTION}}"> COPIED </span>\n{{MAKO_FORMAT}}

[summary~={{MAKO_STAMP_SUMMARIES}} category=foxml.ready]
format=<span font_family="{{FONT_FAMILY}}" size="x-small" weight="semibold" letter_spacing="1024" foreground="#{{FG}}" background="#{{SELECTION}}"> READY </span>\n{{MAKO_FORMAT}}

[urgency=low]
background-color=#{{BG}}{{POPUP_BG_OPACITY_HEX}}
text-color=#{{PRIMARY}}
border-color=#{{MAKO_BORDER}}80

[urgency=critical]
background-color=#{{BG}}{{POPUP_BG_OPACITY_HEX}}
text-color=#{{PRIMARY}}
border-color=#{{MAKO_CRIT_BORDER}}

# Workspace OSD (focus-pulse). The synchronous hint in fox-pulse's
# pulse.d/focus.sh replaces the previous chip instead of growing a stack.
[app-name=focus-pulse]
# foxml-paper-stamp=0
format={{MAKO_FORMAT}}
background-color=#{{BG}}{{POPUP_BG_OPACITY_HEX}}
text-color=#{{ACCENT}}
border-color=#{{SECONDARY}}80

[app-name=Spotify]
border-color=#{{MAKO_MEDIA_BORDER}}

[app-name="com.spotify.Client"]
border-color=#{{MAKO_MEDIA_BORDER}}

# AI agents use the primary peach accent
# so notification chrome reads as "an agent is talking to you", not
# "which agent is talking." Critical urgency (Notification hook,
# i.e. permission/input prompts) still gets the red border from the
# urgency=critical block above.
[app-name=Claude]
border-color=#{{MAKO_AGENT_BORDER}}

# Work notices keep their actions during the same four-second lifetime.
[category=foxml.work]
on-button-left=invoke-default-action
on-button-middle=exec makoctl menu -n "$id" ~/.local/bin/fox-picker --title "Notice actions"
on-button-right=dismiss

# Volume / brightness as a pencil stroke: osd.sh sends app-name fox-osd, and a theme
# opts in by setting MAKO_OSD_APP=fox-osd (others name an app that never exists, so
# their OSD keeps the regular popup). No text (a zero-width space), no icon, 1pt font:
# what's left is a 4px line that progress-color fills like a level.
[app-name={{MAKO_OSD_APP}}]
# foxml-paper-shape=none
# foxml-paper-stamp=0
format=​
font={{FONT_FAMILY}} 1
icons=0
width=260
padding=0
margin=0
outer-margin=0,0,36,0
border-size=0
border-radius=2
background-color=#{{PRIMARY}}14
progress-color=source #{{PRIMARY}}d9
anchor=bottom-center

# Last so app-specific styles cannot make a notification visible during DND.
[mode=do-not-disturb]
invisible=1
