# Fox ML Theme for btop
# Matches waybar, hyprland, kitty, tmux, etc.

# Main backgrounds
theme[main_bg]="#{{BG}}"
theme[main_fg]="#{{FG}}"
theme[title]="#{{PRIMARY}}"
theme[hi_fg]="#{{BTOP_HI_FG}}"
theme[selected_bg]="#{{BTOP_SELECTED_BG}}"
theme[selected_fg]="#{{BTOP_SELECTED_FG}}"
theme[inactive_fg]="#{{FG_DIM}}"

# Process box
theme[proc_misc]="#{{BTOP_PROC_MISC}}"
theme[proc_pause_bg]="#{{BTOP_SELECTED_BG}}"
theme[proc_follow_bg]="#{{BTOP_SELECTED_BG}}"
theme[proc_banner_bg]="#{{BTOP_SELECTED_BG}}"
theme[proc_banner_fg]="#{{BTOP_SELECTED_FG}}"
theme[followed_bg]="#{{BTOP_SELECTED_BG}}"
theme[followed_fg]="#{{BTOP_SELECTED_FG}}"

# Box outlines
theme[cpu_box]="#{{PRIMARY}}"
theme[mem_box]="#{{SECONDARY}}"
theme[net_box]="#{{ACCENT}}"
theme[proc_box]="#{{BTOP_LINE}}"

# Divider line
theme[div_line]="#{{BTOP_LINE}}"

# Temperature graph
theme[temp_start]="#{{BTOP_COOL}}"
theme[temp_mid]="#{{BTOP_WARM}}"
theme[temp_end]="#{{BTOP_HOT}}"

# CPU graph
theme[cpu_start]="#{{PRIMARY}}"
theme[cpu_mid]="#{{SECONDARY}}"
theme[cpu_end]="#{{ACCENT}}"

# Memory/Disk graph
theme[free_start]="#{{BTOP_LINE}}"
theme[free_mid]="#{{BTOP_LINE}}"
theme[free_end]="#{{BTOP_LINE}}"
theme[cached_start]="#{{ACCENT}}"
theme[cached_mid]="#{{ACCENT}}"
theme[cached_end]="#{{ACCENT}}"
theme[available_start]="#{{BTOP_COOL}}"
theme[available_mid]="#{{BTOP_COOL}}"
theme[available_end]="#{{BTOP_COOL}}"
theme[used_start]="#{{PRIMARY}}"
theme[used_mid]="#{{SECONDARY}}"
theme[used_end]="#{{BTOP_HOT}}"

# Network graph
theme[download_start]="#{{PRIMARY}}"
theme[download_mid]="#{{PRIMARY}}"
theme[download_end]="#{{SECONDARY}}"
theme[upload_start]="#{{ACCENT}}"
theme[upload_mid]="#{{ACCENT}}"
theme[upload_end]="#{{BTOP_UPLOAD_END}}"

# Process colors
theme[process_start]="#{{PRIMARY}}"
theme[process_mid]="#{{SECONDARY}}"
theme[process_end]="#{{ACCENT}}"
