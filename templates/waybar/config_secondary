{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "height": __HEIGHT__,
  "margin": "__MARGIN_BAR__",

  "modules-left": [
    "group/launcher",
    "custom/ai_status",
    "custom/claude",
    "custom/api_credits"
  ],

  "modules-center": [],

  "modules-right": [
    "custom/clock"
  ],

  "group/launcher": {
    "orientation": "horizontal",
    "modules": [
        "custom/logo",
        "hyprland/workspaces"
    ]
  },

  "custom/claude": {
    "exec": "~/.local/bin/fox-drawer claude-bar",
    "return-type": "json",
    "interval": 3,
    "tooltip": true,
    "on-click": "~/.local/bin/fox-desktop-menu agents",
    "on-click-asking": "~/.local/bin/fox-drawer claude-next"
  },

  "custom/ai_status": {
    "exec": "~/.local/bin/fox-ai-status",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "~/.local/bin/fox-ai-quick"
  },

  "custom/api_credits": {
    "exec": "~/.local/bin/fox-credits bar",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "~/.local/bin/fox-desktop-menu api-credits"
  },

  "custom/logo": {
    "format": "{{WAYBAR_LOGO}}",
    "tooltip": "The quiet corner",
    "on-click": "~/.local/bin/fox-desktop-menu root"
  },

  "hyprland/workspaces": {
    "format": "{{WAYBAR_WS_FORMAT}}",
    "format-window-separator": " ",
    "window-rewrite-default": "󰘔",
    "window-rewrite": {
        "class<firefox>": "󰈹",
        "class<kitty>": "",
        "class<discord>": "󰙯",
        "class<steam>": "󰓓",
        "class<yazi>": "",
        "class<thunar>": "󰝰",
        "class<rofi>": "󰀻",
        "class<cursor>": "󰨞",
        "class<btopterm>": "󰑮"
    },
    "disable-scroll": false,
    "all-outputs": false,
    "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    }
  },

  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "fox-desktop-menu calendar"
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 300,
    "signal": 1,
    "tooltip": true,
    "on-click": "~/.config/hypr/scripts/updates_menu.sh"
  }
}
