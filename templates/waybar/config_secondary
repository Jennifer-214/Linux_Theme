{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "height": __HEIGHT__,
  "margin": "__MARGIN_BAR__",

  "modules-left": [
    "group/launcher",
    "custom/ai_status",
    "custom/claude"
  ],

  "modules-center": [],

  "modules-right": [
    "custom/clock"
  ],

  "group/launcher": {
    "orientation": "horizontal",
    "modules": [
        "custom/logo",
        "hyprland/workspaces"
    ]
  },

  "custom/claude": {
    "exec": "~/.local/bin/desk-drawer claude-bar",
    "return-type": "json",
    "interval": 3,
    "tooltip": true,
    "on-click": "~/.local/bin/desktop-menu agents",
    "on-click-asking": "~/.local/bin/desk-drawer claude-next"
  },

  "custom/ai_status": {
    "exec": "~/.local/bin/ai-status",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "~/.local/bin/ai-swap"
  },


  "custom/logo": {
    "format": "{{WAYBAR_LOGO}}",
    "tooltip": "The quiet corner",
    "on-click": "~/.local/bin/desktop-menu root"
  },

  "hyprland/workspaces": {
    "format": "{{WAYBAR_WS_FORMAT}}",
    "format-window-separator": " ",
    "window-rewrite-default": "{{WAYBAR_WIN_DEFAULT}}",
    "window-rewrite": {
        "class<firefox>": "{{WAYBAR_WIN_BROWSER}}",
        "class<kitty>": "{{WAYBAR_WIN_TERMINAL}}",
        "class<discord>": "{{WAYBAR_WIN_CHAT}}",
        "class<steam>": "{{WAYBAR_WIN_GAMES}}",
        "class<yazi>": "{{WAYBAR_WIN_FILES}}",
        "class<thunar>": "{{WAYBAR_WIN_FILES}}",
        "class<cursor>": "{{WAYBAR_WIN_EDITOR}}",
        "class<btopterm>": "{{WAYBAR_WIN_MONITOR}}"
    },
    "disable-scroll": false,
    "all-outputs": false,
    "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    }
  },

  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "desktop-menu calendar"
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 300,
    "signal": 1,
    "tooltip": true,
    "on-click": "~/.local/bin/desktop-menu updates"
  }
}
