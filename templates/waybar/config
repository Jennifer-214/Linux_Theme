{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "height": __HEIGHT__,
  "margin": "__MARGIN_BAR__",

  "modules-left": [
    "group/launcher",
    "custom/ai_status",
    "custom/claude",
    "custom/api_credits"
  ],

  "modules-center": [],

  "modules-right": [
    "group/system",
    "group/hardware",
    "custom/updates",
    "custom/clock",
    "tray"
  ],

  "group/system": {
    "orientation": "horizontal",
    "modules": [
        "custom/foxml_sentry",
        "custom/system_health",
        "power-profiles-daemon",
        "custom/battery",
        "idle_inhibitor"
    ]
  },

  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
        "custom/net_speed",
        "custom/cpu",
        "custom/gpu",
        "memory",
        "custom/disk"
    ]
  },

  "group/launcher": {
    "orientation": "horizontal",
    "modules": [
        "custom/logo",
        "hyprland/workspaces"
    ]
  },

  "custom/system_health": {
    "exec": "~/.config/waybar/scripts/system_health.sh",
    "return-type": "json",
    "interval": 10,
    "tooltip": true
  },

  "custom/foxml_sentry": {
    "exec": "~/.config/waybar/scripts/foxml_sentry.sh",
    "return-type": "json",
    "interval": 15,
    "tooltip": true,
    "on-click": "kitty -e desk sec dashboard --live"
  },
  "custom/overwatch": {
    "exec": "~/.config/waybar/scripts/hw_overwatch.sh",
    "return-type": "json",
    "interval": 15,
    "tooltip": true
  },

  "hyprland/workspaces": {
    "format": "{{WAYBAR_WS_FORMAT}}",
    "format-window-separator": " ",
    "window-rewrite-default": "{{WAYBAR_WIN_DEFAULT}}",
    "window-rewrite": {
        "class<firefox>": "{{WAYBAR_WIN_BROWSER}}",
        "class<kitty>": "{{WAYBAR_WIN_TERMINAL}}",
        "class<discord>": "{{WAYBAR_WIN_CHAT}}",
        "class<steam>": "{{WAYBAR_WIN_GAMES}}",
        "class<yazi>": "{{WAYBAR_WIN_FILES}}",
        "class<thunar>": "{{WAYBAR_WIN_FILES}}",
        "class<cursor>": "{{WAYBAR_WIN_EDITOR}}",
        "class<btopterm>": "{{WAYBAR_WIN_MONITOR}}"
    },
    "disable-scroll": false,
    "all-outputs": true,
    "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    }
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh '{{WAYBAR_ICON_CPU}}'",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu-stats.sh '{{WAYBAR_ICON_GPU}}'",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },

  "memory": {
    "format": "{{WAYBAR_ICON_MEM}} {used:0.1f}/{total:0.0f}g",
    "interval": 5,
    "states": {
      "warning": 75,
      "critical": 90
    },
    "tooltip-format": "RAM: {used:0.1f}g / {total:0.1f}g ({percentage}%)\nSwap: {swapUsed:0.1f}g / {swapTotal:0.1f}g"
  },

  "custom/disk": {
    "exec": "~/.config/waybar/scripts/disk.sh '{{WAYBAR_ICON_DISK}}'",
    "return-type": "json",
    "interval": 60
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "default": "◈",
      "performance": "↟",
      "balanced": "◈",
      "power-saver": "❀"
    },
    "tooltip-format": "Power profile: {profile}\nClick to cycle: balanced → performance → power-saver",
    "on-click": "~/.config/waybar/scripts/ppd_cycle.sh"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "☼",
      "deactivated": "○"
    },
    "tooltip-format-activated": "Keeping the screen awake · click to let it rest",
    "tooltip-format-deactivated": "The screen rests when idle · click to keep it awake"
  },

  "tray": {
    "icon-size": __TRAY_ICON__,
    "spacing": 8
  },

  "custom/logo": {
    "format": "{{WAYBAR_LOGO}}",
    "tooltip": "The quiet corner",
    "on-click": "~/.local/bin/desktop-menu root"
  },

  "custom/claude": {
    "exec": "~/.local/bin/desk-drawer claude-bar",
    "return-type": "json",
    "interval": 3,
    "tooltip": true,
    "on-click": "~/.local/bin/desktop-menu agents",
    "on-click-asking": "~/.local/bin/desk-drawer claude-next"
  },

  "custom/api_credits": {
    "exec": "~/.local/bin/desk-credits bar",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "~/.local/bin/desktop-menu api-credits"
  },

  "custom/ai_status": {
    "exec": "~/.local/bin/ai-status",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "~/.local/bin/ai-swap"
  },

  "custom/security": {
    "exec": "~/.config/waybar/scripts/security_overwatch.sh",
    "return-type": "json",
    "interval": 30,
    "tooltip": true
  },

  "custom/net_speed": {
    "exec": "~/.config/waybar/scripts/net_speed.sh '{{WAYBAR_ICON_NET_DOWN}}' '{{WAYBAR_ICON_NET_UP}}'",
    "return-type": "json",
    "interval": 2,
    "tooltip": true
  },

  "custom/media": {
    "exec": "~/.config/waybar/scripts/media.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true
  },

  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "~/.local/bin/desktop-menu power"
  },

  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "desktop-menu calendar"
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 300,
    "signal": 1,
    "tooltip": true,
    "on-click": "~/.local/bin/desktop-menu updates"
  }
}
