// X-macro registry for desk-sec subcommands.
//
// Add a subcommand by including a line:
//   DESK_SUBCMD( name, binary, "description" )

// — Auditing & monitoring —
DESK_SUBCMD( audit,         desk-audit,            "lynis wrapper for hardening posture" )
DESK_SUBCMD( audit-timer,   audit-timer,      "Install/manage a weekly desk doctor drift audit" )
DESK_SUBCMD( snitch,        desk-snitch,           "OpenSnitch (application-layer egress firewall)" )
DESK_SUBCMD( sentry-audit,  desk-sentry-audit,     "Kernel-level honeypot tailer" )
DESK_SUBCMD( overwatch,     desk-overwatch,        "Explain what the waybar overwatch widget is alerting on" )
DESK_SUBCMD( tripwire,      desk-tripwire,         "Honeypot file watcher" )
DESK_SUBCMD( dispatch,      desk-dispatch,         "Send a notification to your phone / Discord / Telegram" )

// — Network —
DESK_SUBCMD( firewall,      desk-firewall,         "Egress filtering (default-deny outgoing) + allowlist" )
DESK_SUBCMD( vpn,           desk-vpn,              "WireGuard wizard with UFW kill-switch" )
DESK_SUBCMD( dns-shield,    desk-dns-shield,       "Local DNS sinkhole using systemd-resolved" )
DESK_SUBCMD( dnssec,        desk-dnssec,           "Pick DNSSEC strictness for systemd-resolved" )
DESK_SUBCMD( ports,         desk-ports,            "Interactive UFW port manager" )
DESK_SUBCMD( knock,         desk-knock,            "Port-knocking configurator + trigger" )
DESK_SUBCMD( spa,           desk-spa,              "Single Packet Authorization via fwknop" )
DESK_SUBCMD( offline,       desk-offline,          "Run a command in a network-namespaced void" )

// — Identity —
DESK_SUBCMD( fingerprint,   desk-fingerprint,      "fprintd wrapper" )
DESK_SUBCMD( mac,           desk-mac,              "NetworkManager MAC randomization, per-SSID" )

// — Isolation —
DESK_SUBCMD( jail,          desk-jail,             "firejail management" )
DESK_SUBCMD( sandbox,       desk-sandbox,          "Launch a disposable, sandboxed program" )
DESK_SUBCMD( allowlist,     desk-allowlist,        "fapolicyd wrapper (executable allowlist)" )

// — Devices —
DESK_SUBCMD( usb,           desk-usb,              "Friendly wrapper around usbguard" )
DESK_SUBCMD( bouncer,       desk-bouncer,          "Alert when USBGuard blocks a device while the screen is locked" )
DESK_SUBCMD( deadman,       desk-deadman,          "USB-tethered panic trigger" )
DESK_SUBCMD( proximity,     desk-proximity,        "Bluetooth proximity auto-lock" )

// — State & posture —
DESK_SUBCMD( arm,           desk-arm,              "Single-command 'turn everything on' for the opt-in security stack" )
DESK_SUBCMD( harden,        desk-harden,           "Post-install control for the kernel/userspace hardening profile" )
DESK_SUBCMD( cafe,          desk-cafe,             "Cafe Mode: auto-tighten security posture on untrusted networks" )
DESK_SUBCMD( backup,        desk-backup,           "Encrypted backup of all opt-in security config" )
DESK_SUBCMD( health,        sec-health,       "Run the foxml health-check library (boot path + PAM stack)" )

// — Honeypots —
DESK_SUBCMD( honey,         desk-honey,            "Plant a per-repo honeytoken matched by desk sec sentry-audit" )
DESK_SUBCMD( honeypot,      desk-honeypot,         "Cowrie SSH honeypot wrapper" )

// — Dashboard (was the standalone desk-sec binary, now a subcommand) —
DESK_SUBCMD( dashboard,     sec-dashboard,    "Unified security dashboard (formerly the standalone desk-sec command)" )
