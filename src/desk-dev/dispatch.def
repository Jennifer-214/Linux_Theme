// X-macro registry for desk-dev subcommands.

// — Project scaffolding —
DESK_SUBCMD( new-project,     new-project,     "Bootstrap a new high-discipline coding workspace" )
DESK_SUBCMD( init,            desk-init,            "One-touch project onboarding" )

// — Build / verify —
DESK_SUBCMD( build-verify,    build-verify,    "Reproducible-build helper for foxml C++ projects" )
DESK_SUBCMD( test,            desk-test,            "Health gate for a Linux_Theme checkout" )
DESK_SUBCMD( work,            desk-work,            "Jobs, test failures, reviews and project next steps" )

// — Code / repo introspection —
DESK_SUBCMD( word-count,      word-count,      "Word count utility for the current workspace" )
DESK_SUBCMD( tail,            desk-tail,            "Context Injector: gather local repo + system state for AI agents" )

// — Distribution / packaging —
DESK_SUBCMD( distro-build,    distro-build,    "Build a custom Linux_Theme Arch ISO" )
DESK_SUBCMD( distro-flash,    distro-flash,    "Safe flashing utility for the Linux_Theme ISO" )
DESK_SUBCMD( distro-guide,    distro-guide,    "Walkthrough for the Linux_Theme distro build/flash flow" )

// — Refactor / template tooling —
DESK_SUBCMD( generate-module, generate-module, "Scaffold a new desk-install module from a template" )
DESK_SUBCMD( template-lint,   template-lint,   "Lint templates/* for palette-token and rendering issues" )
DESK_SUBCMD( gen-keybinds,    gen-keybinds,    "Regenerate KEYBINDS.md from the tmux/Hyprland configs" )

// — Editor integrations —
DESK_SUBCMD( aider,           desk-aider,           "aider wrapper that stays in sync with the global model choice" )
