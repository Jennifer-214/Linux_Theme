// X-macro registry for fox dispatcher namespaces.
//
// Add a namespace by including a line:
//   FOX_NAMESPACE( name, binary, "description" )
//
// Where:
//   name        — user-facing name typed after `fox` (e.g., ai, sec, theme)
//   binary      — leaf binary that fox execvp's to (e.g., fox-ai, fox-sec)
//   description — one-line description shown in `fox help`
//
// Wired in by phase:
//   Phase 2 → ai
//   Phase 3 → sec
//   Phase 4 → theme, dev, sys
//   Phase 5 → font (under sys)

FOX_NAMESPACE( ai,  fox-ai,  "AI-augmented tools (doctor, snitch, review, ...)" )
FOX_NAMESPACE( sec, fox-sec, "Security tools (firewall, vpn, audit, snitch, ...)" )
