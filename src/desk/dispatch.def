// X-macro registry for fox dispatcher namespaces.
//
// Add a namespace by including a line:
//   FOX_NAMESPACE( name, binary, "description" )
//
// Where:
//   name        — user-facing name typed after `fox` (e.g., ai, sec, theme)
//   binary      — leaf binary that fox execvp's to (e.g., desk-ai, desk-sec)
//   description — one-line description shown in `desk help`
//
// Wired in by phase:
//   Phase 2 → ai
//   Phase 3 → sec
//   Phase 4 → theme, dev, sys
//   Phase 5 → font (under sys)

FOX_NAMESPACE( ai,    desk-ai,    "AI-augmented tools (doctor, snitch, review, ...)" )
FOX_NAMESPACE( sec,   desk-sec,   "Security tools (firewall, vpn, audit, snitch, ...)" )
FOX_NAMESPACE( theme, desk-theme, "Theme management (tweak, wallpaper, develop)" )
FOX_NAMESPACE( dev,   desk-dev,   "Developer tools (new-project, build-verify, aider, ...)" )
FOX_NAMESPACE( sys,   desk-sys,   "System tools (install, uninstall, doctor, lock, ...)" )
FOX_NAMESPACE( monitor, desk-monitor, "Monitor layout: status / reconcile / rotate (hotplug-safe)" )
