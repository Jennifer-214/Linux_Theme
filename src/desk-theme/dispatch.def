// X-macro registry for desk-theme subcommands.

DESK_SUBCMD( tweak,     theme-tweak, "Live-update aesthetic variables in the active theme" )
DESK_SUBCMD( wallpaper, desk-wallpaper,   "Manage rotation and static wallpapers" )
DESK_SUBCMD( develop,   desk-develop,     "Toggle dev mode for live iteration on the theme repo" )
DESK_SUBCMD( check,     theme-check, "Check the desktop the theme set up is deployed and working (read-only)" )
