#!/usr/bin/env bash
# setup-minimal — painless theme-only install. Equivalent to:
#   ./install.sh --only deps,zsh_plugins,papirus_icons,monitors,keybind_docs --render-only --yes
#
# System packages plus the theme on every surface. Leaves firewall,
# security, boot and login-screen settings alone, and adds no AI stack or
# GitHub clone. Uses your saved theme, or the default on a first install;
# pass a theme name to choose one.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/install.sh" --only deps,zsh_plugins,papirus_icons,monitors,keybind_docs --render-only --yes "$@"
