.git
.git/
.active-theme

# OpenCode Skills (Private)
claude-skills/

# OpenCode project-local config — install.sh regenerates from a static
# template, but earlier versions wrote $HOME-absolute paths and private-
# workspace names into this file. Keep it out of the repo regardless.
.opencode/

# Agent permission grants — Claude Code / OpenCode write this file
# with absolute paths to whatever the user has allowed. Per-machine
# state, contains $HOME paths and private-workspace names. Not for
# the repo.
.agent/settings.local.json

# Claude Code session state (claude.ai's local IDE config)
.claude/

# Plans — now fully private (operating context, symlinked from the workspace).
# The /plans rule below ignores the symlink; nothing under plans/ is public.

# Editor backups — local safety nets, not for the repo
*.bak
*.bak[0-9]*
*~

# Render output — regenerated on every install
rendered/

# AI Session Context — generated by desk-tail, not for the repo
.foxml_context.md

# Compiled desk-intel binaries — install.sh rebuilds them
src/desk-intel/fask
src/agent-parse/agent-parse
src/desk-intel/findex
src/desk-intel/libfox-intel.a

# fox-* native binaries + their .o / .a build artefacts.
# The repo ships sources; install.sh runs `make` to produce these.
src/*/*.o
src/*/core/*.o
src/*/modules/*.o
src/*/*.d
src/*/core/*.d
src/*/modules/*.d
src/*/tests/test_*
!src/*/tests/test_*.cpp
!src/*/tests/test_*.hpp
!src/*/tests/test_*.h
src/desk/desk
src/desk-ai/desk-ai
src/desk-sec/desk-sec
src/desk-theme/desk-theme
src/theme-check/theme-check
src/desk-dev/desk-dev
src/desk-work/desk-work
!src/desk-work/tests/test_work.py
src/desk-sys/desk-sys
src/desk-common/libfox-common.a
src/desk-health/libfox-health.a
src/desk-monitor/desk-monitor
src/desk-monitor/libfox-monitor.a
src/desk-install/desk-install
src/sec-health/sec-health
src/desk-render/desk-render-fast
src/desk-eza/desk-eza
src/desk-mako/desk-mako
src/desk-mako/vendor/
src/desk-mako/build/
src/desk-pulse/desk-pulse
src/desk-vault/desk-vault
src/gen-keybinds/gen-keybinds
src/ai-*/ai-*
!src/fox-ai-*/fox-ai-*.cpp
!src/fox-ai-*/fox-ai-*.hpp
!src/fox-ai-*/fox-ai-*.h
src/desk-ask/desk-ask
!src/desk-ask/desk-ask.cpp

# Vendored nlohmann json header — bootstrap.sh / install.sh wrapper
# fetches it on first build. Don't commit a 25k-line vendored copy.
src/desk-intel/json.hpp
.aider*
/CLAUDE.md
/CLAUDE.local.md
/NOTE.local.md

# python build artifacts (desk-color + its test)
__pycache__/
*.pyc

# private operating/internal docs (symlinked from the workspace)
/plans
/AGENT.md
/TECHDEBT.md
/CONTRIBUTING.md
/INVARIANTS.md

# desk-intel embeddings index — regenerated on build; 2.7MB, not for the repo
.foxml_index.json

# executable scratch for tests (beside them: /tmp may be noexec)
tests/.fox-theme-check-tests-*/
tests/.fox-lock-panel-tests-*/
